# Isolated by the broker. Copy to .env.secret on the host only; never commit the copy.
# The containers never see these values, only placeholders or nothing at all.

# Tailscale auth key (reusable, tagged) for the hub, paseo, amp and vi nodes. Only the
# Tailscale sidecars read it.
TS_AUTHKEY=

# Amp API key for the Amp CLI in amp, from https://ampcode.com/settings. The broker swaps it in on the
# wire towards ampcode.com. Leave it empty to run `amp login` in the terminal instead.
AMP_API_KEY=

# GitHub token for git and gh in the cage. The broker swaps it in on the wire.
GITHUB_TOKEN=
