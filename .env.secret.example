# Isolated by the broker. Copy to .env.secret on the host only; never commit the copy.
# The containers never see these values, only placeholders or nothing at all.

# Tailscale auth key (reusable, tagged) for the paseo, paseo-bot and paseo-main nodes. Only the
# Tailscale sidecars read it.
TS_AUTHKEY=

# GitHub token of the bot account, for git and gh in the cage (as GITHUB_TOKEN and GH_TOKEN). The broker swaps
# it in on the wire.
GITHUB_TOKEN_BOT=

# GitHub token of your main account, for the paseo-main daemon only. It replaces GITHUB_TOKEN_BOT there, so
# that daemon reaches the private repos the bot cannot.
GITHUB_TOKEN_MAIN=
