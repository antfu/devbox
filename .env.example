# Passed into the containers. Copy to .env on the host only; never commit the copy.
# Everything here is visible inside the cage, so keep tokens that the broker can
# swap in on the wire in .env.secret instead.

# Host path of the video library vi serves, mounted read-write.
VI_LIBRARY=./library

# Your tailnet's MagicDNS name, e.g. <your-tailnet>.ts.net. Paseo only accepts
# websocket connections from https://paseo.<this>.
TAILNET_DOMAIN=

# Git identity for commits made by the agents in paseo.
GIT_NAME=
GIT_EMAIL=

# Bearer token for the dev-container dashboard (monitor.<tailnet>), which lists the services, tails their
# logs and restarts them. Generate one with `openssl rand -hex 32`. Only the host reads it, because the
# services get just the variables their config lists. Empty means a random token kept in
# .dev-container/dashboard-token.
DEV_CONTAINER_DASHBOARD_TOKEN=

# Password for the Paseo daemon, which checks it itself.
PASEO_PASSWORD=

# Optional: Lody CLI token (Settings > Account > CLI Token in the Lody app). Lets the lody service sign in
# on its own; empty means it prints a sign-in link in its logs. The CLI sends it itself, so it is visible
# in the cage.
LODY_AUTH=

# Optional: Vercel AI Gateway API key. When set, Claude Code, pi and opencode in paseo use it for
# models. The agent CLIs hold a model key themselves, so it is visible in the cage; leave it
# empty to log in to each agent yourself.
AI_GATEWAY_API_KEY=
