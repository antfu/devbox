# Passed into the containers. Copy to .env on the host only; never commit the copy.
# Everything here is visible inside the cage, so keep tokens that the broker can
# swap in on the wire in .env.secret instead.

# Your tailnet's MagicDNS name, e.g. <your-tailnet>.ts.net. Paseo only accepts
# websocket connections from https://*.<this>, so the web UI of any laptop on the tailnet can use its servers.
TAILNET_DOMAIN=

# Optional: pull the paseo image that CI built (.github/workflows/images.yml) instead of building it, e.g.
# ghcr.io/<owner>/devbox. Skips the long toolchain, paseo and dev-base builds on this machine. IMAGE_TAG
# picks the tag; the upgrade pulls it again, so `latest` follows CI.
IMAGE_REGISTRY=
IMAGE_TAG=latest

# Prefix for every tailnet hostname, so several laptops can run this stack on one tailnet: `mbp-` gives
# mbp-paseo, mbp-paseo-bot, mbp-paseo-main and mbp-monitor. Lowercase letters, digits and dashes. Empty
# means no prefix, so only one machine can use the plain names.
TAILNET_PREFIX=

# Git identity for commits made by the agents: the bot account on paseo-bot, your main account on
# paseo-main. Each signing key (`pnpm keys:setup`) is made for its identity, and GitHub only verifies it
# when the email belongs to that account.
GIT_NAME_BOT=
GIT_EMAIL_BOT=
GIT_NAME_MAIN=
GIT_EMAIL_MAIN=

# The password for everything you open in a browser: the Paseo daemons check it themselves (the client and
# both servers), and it is the bearer token for the dev-container dashboard (monitor.<tailnet>), which lists
# the services, tails their logs and restarts them. Generate one with `openssl rand -hex 32`. Empty means
# no Paseo password and a random dashboard token kept in .dev-container/dashboard-token.
CLIENT_ACCESS_PASSWORD=

# Optional: Vercel AI Gateway API key. When set, Claude Code, pi and opencode in paseo use it for
# models. The agent CLIs hold a model key themselves, so it is visible in the cage; leave it
# empty to log in to each agent yourself.
AI_GATEWAY_API_KEY=
