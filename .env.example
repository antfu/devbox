# Passed into the containers. Copy to .env on the host only; never commit the copy.
# Everything here is visible inside the cage, so keep tokens that the broker can
# swap in on the wire in .env.secret instead.

# Host path of the video library vi serves, mounted read-write.
VI_LIBRARY=./library

# Your tailnet's MagicDNS name, e.g. <your-tailnet>.ts.net. Paseo only accepts
# websocket connections from https://paseo.<this>.
TAILNET_DOMAIN=

# Git identity for commits made by the agents in paseo.
GIT_NAME=
GIT_EMAIL=

# Password for the Paseo daemon, which checks it itself.
PASEO_PASSWORD=

# Optional: base64 of an armored GPG signing key without a passphrase. Leave it empty and
# the agents' commits stay unsigned. Use a dedicated key: it lives inside the paseo cage.
# Create the value with:
#   gpg --export-secret-keys --armor <key id> | base64 | tr -d '\n'
GPG_PRIVATE_KEY=
# Optional: base64 of the matching armored public key, so signatures can be verified in the cage.
#   gpg --export --armor <key id> | base64 | tr -d '\n'
GPG_PUBLIC_KEY=
