@@ -0,0 +1,100 @@
+import { useCallback } from "react";
+import { useTranslation } from "react-i18next";
+import { Text, View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import { AdaptiveTextInput } from "@/components/adaptive-text-input";
+import type { HostColor } from "@/hosts/appearance";
+import { setHostIcon } from "@/hosts/host-icon-store";
+import type { HostIconName } from "@/hosts/host-icons";
+import { getHostRuntimeStore } from "@/runtime/host-runtime";
+import { ColorRow } from "@/screens/settings/host-appearance-section";
+import { HostIconRow } from "@/screens/settings/host-icon-row";
+
+/** Name, color and icon picked while adding a host; empty values keep what the host has. */
+export interface HostIdentityDraft {
+  label: string;
+  color: HostColor;
+  icon?: HostIconName;
+}
+
+export function emptyHostIdentityDraft(): HostIdentityDraft {
+  return { label: "", color: "none" };
+}
+
+/** Saves the picked name, color and icon on the host that was just added. */
+export async function applyHostIdentityDraft(
+  serverId: string,
+  draft: HostIdentityDraft,
+): Promise<void> {
+  const store = getHostRuntimeStore();
+  const label = draft.label.trim();
+  if (label) await store.renameHost(serverId, label);
+  if (draft.color !== "none") await store.setHostColor(serverId, draft.color);
+  if (draft.icon) await setHostIcon(serverId, draft.icon);
+}
+
+export function AddHostIdentityFields({
+  draft,
+  onChange,
+  editable,
+}: {
+  draft: HostIdentityDraft;
+  onChange: (draft: HostIdentityDraft) => void;
+  editable: boolean;
+}) {
+  const { t } = useTranslation();
+  const handleLabel = useCallback(
+    (label: string) => onChange({ ...draft, label }),
+    [draft, onChange],
+  );
+  const handleColor = useCallback(
+    (color: HostColor) => onChange({ ...draft, color }),
+    [draft, onChange],
+  );
+  const handleIcon = useCallback(
+    (icon: HostIconName) => onChange({ ...draft, icon }),
+    [draft, onChange],
+  );
+
+  return (
+    <View>
+      <View style={styles.field}>
+        <Text style={styles.label}>{t("settings.host.appearance.name.label")}</Text>
+        <AdaptiveTextInput
+          testID="add-host-name-input"
+          nativeID="add-host-name-input"
+          accessibilityLabel={t("settings.host.appearance.name.label")}
+          initialValue={draft.label}
+          onChangeText={handleLabel}
+          placeholder={t("pairing.direct.identity.namePlaceholder")}
+          style={styles.input}
+          autoCorrect={false}
+          editable={editable}
+        />
+      </View>
+      <ColorRow color={draft.color} onChange={handleColor} />
+      <HostIconRow icon={draft.icon} color={draft.color} onChange={handleIcon} />
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  field: {
+    gap: theme.spacing[2],
+    paddingBottom: theme.spacing[3],
+  },
+  label: {
+    color: theme.colors.foregroundMuted,
+    fontSize: theme.fontSize.base,
+    fontWeight: theme.fontWeight.medium,
+  },
+  input: {
+    backgroundColor: theme.colors.surface2,
+    borderRadius: theme.borderRadius.lg,
+    paddingHorizontal: theme.spacing[4],
+    paddingVertical: theme.spacing[3],
+    color: theme.colors.foreground,
+    borderWidth: 1,
+    borderColor: theme.colors.border,
+  },
+}));
