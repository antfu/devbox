+++ b/packages/server/src/server/agent-pull-requests/links.test.ts
@@ -0,0 +1,103 @@
+import { describe, expect, test } from "vitest";
+import type { AgentTimelineItem } from "../agent/agent-sdk-types.js";
+import {
+  extractCreatedPullRequestUrls,
+  isSamePullRequestUrl,
+  parsePullRequestUrl,
+} from "./links.js";
+
+function shell(command: string, output: string, status = "completed"): AgentTimelineItem {
+  return {
+    type: "tool_call",
+    callId: "call",
+    name: "Bash",
+    status,
+    error: null,
+    detail: { type: "shell", command, output },
+  } as AgentTimelineItem;
+}
+
+describe("parsePullRequestUrl", () => {
+  test("reads GitHub, Gitea and nested GitLab links", () => {
+    expect(parsePullRequestUrl("https://github.com/acme/app/pull/12")).toEqual({
+      url: "https://github.com/acme/app/pull/12",
+      host: "github.com",
+      projectPath: "acme/app",
+      number: 12,
+    });
+    expect(parsePullRequestUrl("https://git.example.com/acme/app/pulls/3")?.number).toBe(3);
+    expect(
+      parsePullRequestUrl("https://gitlab.com/group/sub/app/-/merge_requests/7")?.projectPath,
+    ).toBe("group/sub/app");
+  });
+
+  test("rejects links that are not a change request", () => {
+    expect(parsePullRequestUrl("https://github.com/acme/app/issues/12")).toBeNull();
+    expect(parsePullRequestUrl("not a url")).toBeNull();
+  });
+});
+
+describe("isSamePullRequestUrl", () => {
+  test("ignores the tab, query and case", () => {
+    expect(
+      isSamePullRequestUrl(
+        "https://github.com/Acme/App/pull/12/files?w=1",
+        "https://github.com/acme/app/pull/12",
+      ),
+    ).toBe(true);
+    expect(
+      isSamePullRequestUrl(
+        "https://github.com/acme/app/pull/12",
+        "https://github.com/acme/other/pull/12",
+      ),
+    ).toBe(false);
+  });
+});
+
+describe("extractCreatedPullRequestUrls", () => {
+  test("finds the link a create command printed", () => {
+    const item = shell(
+      'cd pkg && gh pr create --title "x" --body "y"',
+      "Creating pull request for feat into main\nhttps://github.com/acme/app/pull/12\n",
+    );
+    expect(extractCreatedPullRequestUrls(item)).toEqual(["https://github.com/acme/app/pull/12"]);
+  });
+
+  test("finds a GitLab merge request", () => {
+    const item = shell("glab mr create --fill", "https://gitlab.com/g/s/app/-/merge_requests/7");
+    expect(extractCreatedPullRequestUrls(item)).toEqual([
+      "https://gitlab.com/g/s/app/-/merge_requests/7",
+    ]);
+  });
+
+  test("ignores links from commands that only read", () => {
+    const output = "https://github.com/acme/app/pull/12";
+    expect(extractCreatedPullRequestUrls(shell("gh pr list", output))).toEqual([]);
+    expect(extractCreatedPullRequestUrls(shell("gh pr view 12", output))).toEqual([]);
+  });
+
+  test("ignores a create command that has not finished or failed", () => {
+    const output = "https://github.com/acme/app/pull/12";
+    expect(extractCreatedPullRequestUrls(shell("gh pr create", output, "running"))).toEqual([]);
+    expect(extractCreatedPullRequestUrls(shell("gh pr create", output, "failed"))).toEqual([]);
+  });
+
+  test("reads the web link from an MCP create tool, not its API links", () => {
+    const item = {
+      type: "tool_call",
+      callId: "call",
+      name: "mcp__github__create_pull_request",
+      status: "completed",
+      error: null,
+      detail: {
+        type: "unknown",
+        input: {},
+        output: {
+          url: "https://api.github.com/repos/acme/app/pulls/12",
+          html_url: "https://github.com/acme/app/pull/12",
+        },
+      },
+    } as AgentTimelineItem;
+    expect(extractCreatedPullRequestUrls(item)).toEqual(["https://github.com/acme/app/pull/12"]);
+  });
+});
diff --git a/packages/server/src/server/agent-pull-requests/links.ts b/packages/server/src/server/agent-pull-requests/links.ts
new file mode 100644
index 0000000000000000000000000000000000000000..668631c888c7491eef955179b4fb50be3153bdbb
--- /dev/null
+++ b/packages/server/src/server/agent-pull-requests/links.ts
@@ -0,0 +1,84 @@
+import type { AgentTimelineItem } from "../agent/agent-sdk-types.js";
+
+/** A change request named by its web URL. */
+interface PullRequestLink {
+  url: string;
+  host: string;
+  /** `owner/repo`, or a nested GitLab namespace such as `group/subgroup/repo`. */
+  projectPath: string;
+  number: number;
+}
+
+// GitHub uses /pull/N, Gitea and Forgejo /pulls/N, GitLab /-/merge_requests/N.
+const PULL_REQUEST_URL = /https?:\/\/[^\s"'<>()[\]]+?\/(?:pull|pulls|merge_requests)\/\d+/g;
+const PULL_REQUEST_PATH = /^\/(.+?)\/(?:-\/)?(?:pull|pulls|merge_requests)\/(\d+)$/;
+
+// `gh pr create`, `glab mr create`, `tea pulls create` and the like.
+const CREATE_COMMAND = /\b(?:gh|glab|tea|fj|berg)\s+(?:pr|mr|pulls?)\s+(?:create|new)\b/;
+// MCP tools such as GitHub's `create_pull_request`.
+const CREATE_TOOL_NAME = /create[_-]?(?:pull|merge)[_-]?request/i;
+
+export function parsePullRequestUrl(url: string): PullRequestLink | null {
+  let parsed: URL;
+  try {
+    parsed = new URL(url);
+  } catch {
+    return null;
+  }
+  const match = parsed.pathname.match(PULL_REQUEST_PATH);
+  if (!match) return null;
+  const number = Number.parseInt(match[2], 10);
+  if (!Number.isFinite(number)) return null;
+  return {
+    url: `${parsed.origin}${parsed.pathname}`,
+    host: parsed.host,
+    projectPath: match[1],
+    number,
+  };
+}
+
+/** True when both URLs name the same change request, whatever their query or trailing path. */
+export function isSamePullRequestUrl(left: string, right: string): boolean {
+  const a = parsePullRequestUrl(stripPullRequestUrlTail(left));
+  const b = parsePullRequestUrl(stripPullRequestUrlTail(right));
+  return a !== null && b !== null && a.url.toLowerCase() === b.url.toLowerCase();
+}
+
+function stripPullRequestUrlTail(url: string): string {
+  return url.match(PULL_REQUEST_URL)?.[0] ?? url;
+}
+
+function outputText(output: unknown): string {
+  if (typeof output === "string") return output;
+  if (output === null || output === undefined) return "";
+  try {
+    return JSON.stringify(output) ?? "";
+  } catch {
+    return "";
+  }
+}
+
+/**
+ * The change requests a finished tool call created. Only a create command counts: a URL the agent
+ * merely read (`gh pr list`, a web page) is someone else's change request, not one it works on.
+ */
+export function extractCreatedPullRequestUrls(item: AgentTimelineItem): string[] {
+  if (item.type !== "tool_call" || item.status !== "completed") return [];
+  let text: string;
+  if (item.detail.type === "shell") {
+    if (!CREATE_COMMAND.test(item.detail.command)) return [];
+    text = item.detail.output ?? "";
+  } else if (item.detail.type === "unknown") {
+    if (!CREATE_TOOL_NAME.test(item.name)) return [];
+    text = outputText(item.detail.output);
+  } else {
+    return [];
+  }
+  const urls = new Set<string>();
+  for (const candidate of text.match(PULL_REQUEST_URL) ?? []) {
+    const link = parsePullRequestUrl(candidate);
+    // An MCP result also carries REST URLs (api.github.com/repos/...), which are not web links.
+    if (link && !link.host.startsWith("api.")) urls.add(link.url);
+  }
+  return [...urls];
+}
diff --git a/packages/server/src/server/agent-pull-requests/store.ts b/packages/server/src/server/agent-pull-requests/store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f9be6fce3618894271b73368d43538da519c16c4
--- /dev/null
+++ b/packages/server/src/server/agent-pull-requests/store.ts
@@ -0,0 +1,75 @@
+import { promises as fs } from "node:fs";
+import path from "node:path";
+import { z } from "zod";
+import { writeJsonFileAtomic } from "../atomic-file.js";
+import { isSamePullRequestUrl } from "./links.js";
+
+const STORE_FILE = "agent-pull-requests.json";
+
+const StoredLinkSchema = z.object({
+  url: z.string(),
+  /** Where the tool call ran, which is the first place to ask the forge about the link. */
+  cwd: z.string(),
+});
+
+const StoredStateSchema = z.object({
+  links: z.record(z.string(), z.array(StoredLinkSchema)).default({}),
+});
+
+type StoredPullRequestLink = z.infer<typeof StoredLinkSchema>;
+
+/**
+ * What the daemon has to remember about agents' change requests across restarts: the links found
+ * in their tool calls, since a finished subagent's timeline is not loaded again.
+ */
+export class AgentPullRequestStore {
+  private state: z.infer<typeof StoredStateSchema> = { links: {} };
+  private writes: Promise<unknown> = Promise.resolve();
+  private readonly filePath: string;
+
+  constructor(paseoHome: string) {
+    this.filePath = path.join(paseoHome, STORE_FILE);
+  }
+
+  async load(): Promise<void> {
+    let raw: string;
+    try {
+      raw = await fs.readFile(this.filePath, "utf8");
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === "ENOENT") return;
+      throw error;
+    }
+    this.state = StoredStateSchema.parse(JSON.parse(raw));
+  }
+
+  linksOf(agentId: string): readonly StoredPullRequestLink[] {
+    return this.state.links[agentId] ?? [];
+  }
+
+  addLink(agentId: string, link: StoredPullRequestLink): void {
+    const links = this.state.links[agentId] ?? [];
+    if (links.some((existing) => isSamePullRequestUrl(existing.url, link.url))) return;
+    this.state.links[agentId] = [...links, link];
+    this.save();
+  }
+
+  removeAgent(agentId: string): void {
+    if (!(agentId in this.state.links)) return;
+    delete this.state.links[agentId];
+    this.save();
+  }
+
+  /** Resolves once every change so far is on disk. */
+  flush(): Promise<void> {
+    return this.writes.then(() => undefined);
+  }
+
+  private save(): void {
+    const snapshot = structuredClone(this.state);
+    this.writes = this.writes
+      .catch(() => undefined)
+      .then(() => writeJsonFileAtomic(this.filePath, snapshot));
+    // A lost write only costs a link until the next change; never crash the daemon.
+    this.writes.catch(() => undefined);
+  }
+}
