+++ b/packages/app/src/composer/agent-pull-requests.test.ts
@@ -0,0 +1,124 @@
+import { describe, expect, it } from "vitest";
+import type { AgentPullRequestPayload } from "@getpaseo/protocol/messages";
+import {
+  mergeAgentPullRequests,
+  selectQuickActionTargets,
+  type ComposerPullRequest,
+} from "./agent-pull-requests";
+
+function listed(number: number, overrides: Partial<AgentPullRequestPayload> = {}) {
+  return {
+    url: `https://github.com/acme/app/pull/${number}`,
+    number,
+    title: `PR ${number}`,
+    state: "open",
+    isMerged: false,
+    baseRefName: "main",
+    headRefName: `feat-${number}`,
+    agentId: "agent-1",
+    ...overrides,
+  } satisfies AgentPullRequestPayload;
+}
+
+const workspace: ComposerPullRequest = {
+  prHint: {
+    url: "https://github.com/acme/app/pull/7",
+    number: 7,
+    state: "open",
+    forge: "github",
+  },
+  mergeable: "MERGEABLE",
+  baseRefName: "main",
+};
+
+describe("mergeAgentPullRequests", () => {
+  it("puts the workspace's pull request first and adds the others", () => {
+    const merged = mergeAgentPullRequests(workspace, [listed(9), listed(8)]);
+    expect(merged.map((entry) => entry.prHint.number)).toEqual([7, 9, 8]);
+  });
+
+  it("keeps the workspace's copy of a pull request the host also lists", () => {
+    const merged = mergeAgentPullRequests(workspace, [
+      listed(7, { url: "https://github.com/Acme/App/pull/7/", mergeable: "CONFLICTING" }),
+    ]);
+    expect(merged).toEqual([workspace]);
+  });
+
+  it("lists the host's pull requests when the workspace has none", () => {
+    const merged = mergeAgentPullRequests(null, [
+      listed(8, { mergeable: "CONFLICTING", checksStatus: "failure" }),
+      listed(9, { state: "merged", isMerged: true }),
+    ]);
+    expect(merged).toEqual([
+      {
+        prHint: expect.objectContaining({ number: 8, state: "open", hasConflicts: true }),
+        mergeable: "CONFLICTING",
+        baseRefName: "main",
+      },
+      {
+        prHint: expect.objectContaining({ number: 9, state: "merged" }),
+        mergeable: null,
+        baseRefName: "main",
+      },
+    ]);
+  });
+
+  it("shows a link the host could not read as an open pull request", () => {
+    const merged = mergeAgentPullRequests(null, [
+      listed(8, { state: "unknown", title: "", baseRefName: "", headRefName: "" }),
+    ]);
+    expect(merged).toEqual([
+      {
+        prHint: expect.objectContaining({ number: 8, state: "open" }),
+        mergeable: null,
+        baseRefName: null,
+      },
+    ]);
+  });
+});
+
+describe("selectQuickActionTargets", () => {
+  const failing: ComposerPullRequest = {
+    prHint: { ...workspace.prHint, number: 8, checksStatus: "failure" },
+    mergeable: "CONFLICTING",
+    baseRefName: "main",
+  };
+
+  it("offers each pull request its own follow-ups", () => {
+    const targets = selectQuickActionTargets({
+      pullRequests: [workspace, failing],
+      workspaceHasPullRequest: true,
+      hasLocalChanges: true,
+      isAgentIdle: true,
+    });
+    expect(targets).toEqual([
+      { action: "resolveConflicts", pullRequest: failing },
+      { action: "fixCi", pullRequest: failing },
+    ]);
+  });
+
+  it("offers Create PR when only subagents have pull requests", () => {
+    const targets = selectQuickActionTargets({
+      pullRequests: [failing],
+      workspaceHasPullRequest: false,
+      hasLocalChanges: true,
+      isAgentIdle: true,
+    });
+    expect(targets.map((target) => target.action)).toEqual([
+      "resolveConflicts",
+      "fixCi",
+      "createPr",
+    ]);
+    expect(targets.at(-1)?.pullRequest).toBeNull();
+  });
+
+  it("offers nothing while the agent is busy", () => {
+    const targets = selectQuickActionTargets({
+      pullRequests: [failing],
+      workspaceHasPullRequest: false,
+      hasLocalChanges: true,
+      isAgentIdle: false,
+    });
+    expect(targets).toEqual([]);
+  });
+});
