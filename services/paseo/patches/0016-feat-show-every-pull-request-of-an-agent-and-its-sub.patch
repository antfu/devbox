+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import pino from "pino";
+import { afterEach, beforeEach, describe, expect, test } from "vitest";
+import type { CurrentPullRequestStatus } from "../../services/forge-service.js";
+import type { AgentManagerEvent, ManagedAgent } from "../agent/agent-manager.js";
+import type { AgentTimelineItem } from "../agent/agent-sdk-types.js";
+import type { StoredAgentRecord } from "../agent/agent-storage.js";
+import { AgentPullRequests, type AgentPullRequestsOptions } from "./index.js";
+
+const REPO = "https://github.com/acme/app";
+
+function record(id: string, overrides: Partial<StoredAgentRecord> = {}): StoredAgentRecord {
+  return {
+    id,
+    provider: "claude",
+    cwd: `/work/${id}`,
+    createdAt: "2026-01-01T00:00:00.000Z",
+    updatedAt: "2026-01-01T00:00:00.000Z",
+    labels: {},
+    metadata: {},
+    lastStatus: "closed",
+    ...overrides,
+  } as StoredAgentRecord;
+}
+
+function status(
+  number: number,
+  overrides: Partial<CurrentPullRequestStatus> = {},
+): CurrentPullRequestStatus {
+  return {
+    number,
+    repoOwner: "acme",
+    repoName: "app",
+    url: `${REPO}/pull/${number}`,
+    title: `PR ${number}`,
+    state: "open",
+    baseRefName: "main",
+    headRefName: `feat-${number}`,
+    headSha: `sha-${number}`,
+    isMerged: false,
+    mergeable: "MERGEABLE",
+    checks: [],
+    checksStatus: "success",
+    reviewDecision: null,
+    ...overrides,
+  };
+}
+
+function createCommand(url: string): AgentTimelineItem {
+  return {
+    type: "tool_call",
+    callId: "call",
+    name: "Bash",
+    status: "completed",
+    error: null,
+    detail: { type: "shell", command: "gh pr create --fill", output: `${url}\n` },
+  } as AgentTimelineItem;
+}
+
+interface World {
+  records: StoredAgentRecord[];
+  /** The change request of the branch checked out in each directory. */
+  checkouts: Map<string, CurrentPullRequestStatus>;
+  /** Every change request the forge knows, by number. */
+  forge: Map<number, CurrentPullRequestStatus>;
+  live: Map<string, Partial<ManagedAgent>>;
+  emit: (event: AgentManagerEvent) => void;
+}
+
+function createWorld(paseoHome: string): { world: World; service: AgentPullRequests } {
+  const world: World = {
+    records: [],
+    checkouts: new Map(),
+    forge: new Map(),
+    live: new Map(),
+    emit: () => undefined,
+  };
+  const forgeService = {
+    getPullRequest: async ({ number }: { number: number }) => {
+      const found = world.forge.get(number);
+      if (!found) throw new Error("not found");
+      return found;
+    },
+    getCurrentPullRequestStatus: async ({ headRef }: { headRef: string }) =>
+      [...world.forge.values()].find((entry) => entry.headRefName === headRef) ?? null,
+  };
+  const options = {
+    paseoHome,
+    agentManager: {
+      subscribe: (callback: (event: AgentManagerEvent) => void) => {
+        world.emit = callback;
+        return () => undefined;
+      },
+      getAgent: (id: string) => (world.live.get(id) as ManagedAgent | undefined) ?? null,
+      getTimeline: () => {
+        throw new Error("not loaded");
+      },
+    },
+    agentStorage: { listAll: async () => world.records },
+    workspaceGitService: {
+      getSnapshot: async (cwd: string) => ({
+        cwd,
+        forge: { forge: "github", pullRequest: world.checkouts.get(cwd) ?? null },
+      }),
+      resolveForge: async () => ({ forge: "github", host: "github.com", service: forgeService }),
+    },
+    logger: pino({ level: "silent" }),
+  } as unknown as AgentPullRequestsOptions;
+  return { world, service: new AgentPullRequests(options) };
+}
+
+function liveAgent(id: string, cwd: string): Partial<ManagedAgent> {
+  return { id, cwd, lifecycle: "idle" };
+}
+
+describe("AgentPullRequests", () => {
+  let paseoHome: string;
+  let world: World;
+  let service: AgentPullRequests;
+
+  beforeEach(async () => {
+    paseoHome = await mkdtemp(path.join(tmpdir(), "agent-pull-requests-"));
+    ({ world, service } = createWorld(paseoHome));
+    await service.start();
+  });
+
+  afterEach(async () => {
+    await service.stop();
+    await rm(paseoHome, { recursive: true, force: true });
+  });
+
+  function createLink(agentId: string, number: number): void {
+    world.forge.set(number, world.forge.get(number) ?? status(number));
+    world.emit({
+      type: "agent_stream",
+      agentId,
+      event: {
+        type: "timeline",
+        provider: "claude",
+        item: createCommand(`${REPO}/pull/${number}`),
+      },
+    });
+  }
+
+  test("lists the agent's checkout, the links it created and its subagents' pull requests", async () => {
+    world.records = [
+      record("parent"),
+      record("child", { labels: { "paseo.parent-agent-id": "parent" } }),
+      record("stranger"),
+    ];
+    world.checkouts.set("/work/parent", status(1));
+    world.checkouts.set("/work/child", status(2));
+    world.checkouts.set("/work/stranger", status(9));
+    world.live.set("parent", liveAgent("parent", "/work/parent"));
+    createLink("parent", 3);
+
+    const listed = await service.list("parent");
+    expect(listed.map((entry) => [entry.number, entry.agentId])).toEqual([
+      [1, "parent"],
+      [2, "child"],
+      [3, "parent"],
+    ]);
+    expect((await service.list("child")).map((entry) => entry.number)).toEqual([2]);
+  });
+
+  test("keeps an archived subagent's links and lists a pull request once", async () => {
+    world.records = [
+      record("parent"),
+      record("child", {
+        labels: { "paseo.parent-agent-id": "parent" },
+        archivedAt: "2026-01-02T00:00:00.000Z",
+      }),
+    ];
+    world.checkouts.set("/work/parent", status(1));
+    world.checkouts.set("/work/child", status(8));
+    world.live.set("child", liveAgent("child", "/work/child"));
+    createLink("child", 1);
+    createLink("child", 4);
+
+    const listed = await service.list("parent");
+    expect(listed.map((entry) => [entry.number, entry.agentId])).toEqual([
+      [1, "parent"],
+      [4, "child"],
+    ]);
+  });
+
+  test("shows a link no checkout's forge knows as unknown", async () => {
+    world.records = [record("agent")];
+    world.live.set("agent", liveAgent("agent", "/work/agent"));
+    world.emit({
+      type: "agent_stream",
+      agentId: "agent",
+      event: {
+        type: "timeline",
+        provider: "claude",
+        item: createCommand("https://github.com/other/repo/pull/5"),
+      },
+    });
+    const listed = await service.list("agent");
+    expect(listed).toEqual([
+      expect.objectContaining({
+        url: "https://github.com/other/repo/pull/5",
+        number: 5,
+        state: "unknown",
+      }),
+    ]);
+  });
+});
diff --git a/packages/server/src/server/agent-pull-requests/index.ts b/packages/server/src/server/agent-pull-requests/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..76268d37cd9c1040632909269df785604d54638a
--- /dev/null
+++ b/packages/server/src/server/agent-pull-requests/index.ts
@@ -0,0 +1,401 @@
+import { resolve } from "node:path";
+import type { Logger } from "pino";
+import { getParentAgentIdFromLabels } from "@getpaseo/protocol/agent-labels";
+import type { AgentPullRequestPayload } from "@getpaseo/protocol/messages";
+import type { CurrentPullRequestStatus } from "../../services/forge-service.js";
+import type { AgentManager, AgentManagerEvent } from "../agent/agent-manager.js";
+import type { AgentTimelineItem } from "../agent/agent-sdk-types.js";
+import type { AgentStorage, StoredAgentRecord } from "../agent/agent-storage.js";
+import type { SessionInboundMessage, SessionOutboundMessage } from "../messages.js";
+import type { WorkspaceGitService } from "../workspace-git-service.js";
+import { extractCreatedPullRequestUrls, parsePullRequestUrl } from "./links.js";
+import { AgentPullRequestStore } from "./store.js";
+
+export interface AgentPullRequestsOptions {
+  paseoHome: string;
+  agentManager: Pick<AgentManager, "subscribe" | "getAgent" | "getTimeline">;
+  agentStorage: Pick<AgentStorage, "listAll">;
+  workspaceGitService: Pick<WorkspaceGitService, "getSnapshot" | "resolveForge">;
+  logger: Logger;
+  now?: () => number;
+}
+
+/** A change request and the agent that holds it: through its checkout, or through a link. */
+interface HeldPullRequest {
+  agentId: string;
+  cwd: string;
+  status: PullRequestStatus;
+  forge: string | undefined;
+  viaLink: boolean;
+}
+
+type PullRequestStatus = Omit<CurrentPullRequestStatus, "mergeable"> & {
+  mergeable?: CurrentPullRequestStatus["mergeable"];
+};
+
+interface CachedLinkStatus {
+  status: PullRequestStatus;
+  forge: string | undefined;
+  /** The checkout whose forge knew the link, tried first next time. */
+  cwd: string | null;
+  fetchedAt: number;
+}
+
+// How long a list request reuses a link's status before asking the forge again.
+const LINK_STATUS_TTL_MS = 30_000;
+// A merged or closed change request rarely changes again.
+const SETTLED_LINK_STATUS_TTL_MS = 30 * 60_000;
+const UNREADABLE_LINK_RETRY_MS = 10 * 60_000;
+
+function urlKey(url: string): string {
+  return (parsePullRequestUrl(url)?.url ?? url).toLowerCase();
+}
+
+function isSettled(status: PullRequestStatus): boolean {
+  const state = status.state.toLowerCase();
+  return status.isMerged || state === "merged" || state === "closed";
+}
+
+function unknownStatus(url: string): PullRequestStatus {
+  return {
+    url,
+    number: parsePullRequestUrl(url)?.number,
+    title: "",
+    state: "unknown",
+    baseRefName: "",
+    headRefName: "",
+    isMerged: false,
+    checks: [],
+    checksStatus: "none",
+    reviewDecision: null,
+  };
+}
+
+function toPayload(held: HeldPullRequest): AgentPullRequestPayload {
+  const { status } = held;
+  return {
+    url: status.url,
+    ...(status.number === undefined ? {} : { number: status.number }),
+    title: status.title,
+    state: status.state,
+    isMerged: status.isMerged,
+    ...(status.isDraft === undefined ? {} : { isDraft: status.isDraft }),
+    baseRefName: status.baseRefName,
+    headRefName: status.headRefName,
+    ...(status.mergeable ? { mergeable: status.mergeable } : {}),
+    checks: status.checks.map((check) => ({
+      name: check.name,
+      status: check.status,
+      url: check.url,
+      ...(check.workflow ? { workflow: check.workflow } : {}),
+      ...(check.duration ? { duration: check.duration } : {}),
+      ...(check.traits ? { traits: check.traits } : {}),
+    })),
+    checksStatus: status.checksStatus,
+    reviewDecision: status.reviewDecision,
+    ...(held.forge ? { forge: held.forge } : {}),
+    agentId: held.agentId,
+  };
+}
+
+/**
+ * Knows every change request an agent works on.
+ *
+ * An agent holds the change request of the branch checked out where it runs, and every change
+ * request one of its tool calls created. A parent also shows what its subagents hold.
+ */
+export class AgentPullRequests {
+  private readonly store: AgentPullRequestStore;
+  private readonly now: () => number;
+  private readonly linkStatuses = new Map<string, CachedLinkStatus>();
+  private readonly scannedAgents = new Set<string>();
+  private unsubscribe: (() => void) | null = null;
+
+  constructor(private readonly options: AgentPullRequestsOptions) {
+    this.store = new AgentPullRequestStore(options.paseoHome);
+    this.now = options.now ?? Date.now;
+  }
+
+  async start(): Promise<void> {
+    try {
+      await this.store.load();
+    } catch (error) {
+      this.options.logger.warn({ err: error }, "Could not read the saved pull request links");
+    }
+    this.unsubscribe = this.options.agentManager.subscribe((event) => this.onAgentEvent(event), {
+      replayState: false,
+    });
+  }
+
+  /** Stops watching; resolves once the links found so far are on disk. */
+  async stop(): Promise<void> {
+    this.unsubscribe?.();
+    this.unsubscribe = null;
+    await this.store.flush();
+  }
+
+  /** The change requests the agent and its subagents work on, the agent's own first. */
+  async list(agentId: string): Promise<AgentPullRequestPayload[]> {
+    const records = await this.options.agentStorage.listAll();
+    const family = collectFamily(records, agentId);
+    const held = await this.collectHeld(family);
+    const byUrl = new Map<string, HeldPullRequest>();
+    for (const entry of held) {
+      const key = urlKey(entry.status.url);
+      const existing = byUrl.get(key);
+      // The agent's own entry wins over a subagent's, and a read status over an unread link.
+      if (
+        !existing ||
+        (existing.agentId !== agentId && entry.agentId === agentId) ||
+        (existing.status.state === "unknown" && entry.status.state !== "unknown")
+      ) {
+        byUrl.set(key, entry);
+      }
+    }
+    return [...byUrl.values()]
+      .sort((left, right) => {
+        const leftOwn = left.agentId === agentId && !left.viaLink;
+        const rightOwn = right.agentId === agentId && !right.viaLink;
+        if (leftOwn !== rightOwn) return leftOwn ? -1 : 1;
+        return (left.status.number ?? 0) - (right.status.number ?? 0);
+      })
+      .map(toPayload);
+  }
+
+  private onAgentEvent(event: AgentManagerEvent): void {
+    switch (event.type) {
+      case "agent_stream":
+        if (event.event.type === "timeline") {
+          this.recordLinks(event.agentId, event.event.item);
+        }
+        return;
+      case "provider_subagent":
+        // A provider's own subagents run inside their parent's session, so the parent holds them.
+        if (event.event.type === "timeline") {
+          this.recordLinks(event.event.parentAgentId, event.event.row.item);
+        }
+        return;
+      case "agent_removed":
+        this.store.removeAgent(event.agentId);
+        this.scannedAgents.delete(event.agentId);
+        return;
+      default:
+    }
+  }
+
+  private recordLinks(agentId: string, item: AgentTimelineItem): void {
+    const urls = extractCreatedPullRequestUrls(item);
+    if (urls.length === 0) return;
+    const agent = this.options.agentManager.getAgent(agentId);
+    if (!agent || agent.internal) return;
+    const cwd =
+      item.type === "tool_call" && item.detail.type === "shell" && item.detail.cwd
+        ? item.detail.cwd
+        : agent.cwd;
+    for (const url of urls) this.store.addLink(agentId, { url, cwd });
+  }
+
+  /** Reads a loaded agent's history once, for links created before the daemon started watching. */
+  private scanTimeline(agentId: string): void {
+    if (this.scannedAgents.has(agentId)) return;
+    let items: AgentTimelineItem[];
+    try {
+      items = this.options.agentManager.getTimeline(agentId);
+    } catch {
+      // Not loaded: its links, if any, were saved when it ran.
+      return;
+    }
+    this.scannedAgents.add(agentId);
+    for (const item of items) this.recordLinks(agentId, item);
+  }
+
+  private async collectHeld(agents: readonly StoredAgentRecord[]): Promise<HeldPullRequest[]> {
+    const held: HeldPullRequest[] = [];
+    const cwds = [
+      ...new Set(agents.filter((agent) => !agent.archivedAt).map((a) => resolve(a.cwd))),
+    ];
+
+    const checkouts = new Map<string, HeldPullRequest | null>();
+    for (const cwd of cwds) checkouts.set(cwd, await this.readCheckout(cwd));
+    const checkoutByUrl = new Map<string, HeldPullRequest>();
+    for (const entry of checkouts.values()) {
+      if (entry) checkoutByUrl.set(urlKey(entry.status.url), entry);
+    }
+
+    for (const agent of agents) {
+      if (!agent.archivedAt) {
+        const entry = checkouts.get(resolve(agent.cwd));
+        if (entry) held.push({ ...entry, agentId: agent.id });
+        this.scanTimeline(agent.id);
+      }
+      for (const link of this.store.linksOf(agent.id)) {
+        // A link to a checked-out branch's change request needs no second read.
+        const read =
+          checkoutByUrl.get(urlKey(link.url)) ??
+          (await this.readLink(link.url, [link.cwd, ...cwds]));
+        held.push({
+          agentId: agent.id,
+          cwd: read.cwd ?? link.cwd,
+          status: read.status,
+          forge: read.forge,
+          viaLink: true,
+        });
+      }
+    }
+    return held;
+  }
+
+  private async readCheckout(cwd: string): Promise<HeldPullRequest | null> {
+    try {
+      const snapshot = await this.options.workspaceGitService.getSnapshot(cwd);
+      const status = snapshot.forge.pullRequest;
+      if (!status) return null;
+      return {
+        agentId: "",
+        cwd,
+        status: {
+          ...status,
+          checks: status.checks ?? [],
+          checksStatus: status.checksStatus ?? "none",
+          reviewDecision: status.reviewDecision ?? null,
+        },
+        forge: snapshot.forge.forge,
+        viaLink: false,
+      };
+    } catch (error) {
+      this.options.logger.debug({ err: error, cwd }, "Could not read a checkout's pull request");
+      return null;
+    }
+  }
+
+  /**
+   * A link's status, read through the forge of a checkout on the same repository. A link into a
+   * repository none of the agents has checked out stays `unknown`: the forge adapters only answer
+   * for the repository of a working directory.
+   */
+  private async readLink(url: string, cwds: readonly string[]): Promise<CachedLinkStatus> {
+    const key = urlKey(url);
+    const cached = this.linkStatuses.get(key);
+    if (cached && this.isLinkStatusFresh(cached)) return cached;
+    const link = parsePullRequestUrl(url);
+    const candidates = link ? [...new Set([...(cached?.cwd ? [cached.cwd] : []), ...cwds])] : [];
+    let next: CachedLinkStatus = {
+      status: cached?.status ?? unknownStatus(url),
+      forge: cached?.forge,
+      cwd: null,
+      fetchedAt: this.now(),
+    };
+    for (const cwd of candidates) {
+      const read = await this.readLinkIn(url, cwd);
+      if (read) {
+        next = { ...read, fetchedAt: this.now() };
+        break;
+      }
+    }
+    this.linkStatuses.set(key, next);
+    return next;
+  }
+
+  private isLinkStatusFresh(cached: CachedLinkStatus): boolean {
+    const age = this.now() - cached.fetchedAt;
+    if (isSettled(cached.status)) return age < SETTLED_LINK_STATUS_TTL_MS;
+    // No checkout's forge knew it. Asking every checkout again each time would only burn calls.
+    if (cached.cwd === null) return age < UNREADABLE_LINK_RETRY_MS;
+    return age < LINK_STATUS_TTL_MS;
+  }
+
+  private async readLinkIn(
+    url: string,
+    cwd: string,
+  ): Promise<Omit<CachedLinkStatus, "fetchedAt"> | null> {
+    const link = parsePullRequestUrl(url);
+    if (!link) return null;
+    try {
+      const resolution = await this.options.workspaceGitService.resolveForge(cwd);
+      if (!resolution) return null;
+      const summary = await resolution.service.getPullRequest({ cwd, number: link.number });
+      // The same number in another repository is another change request.
+      if (urlKey(summary.url) !== link.url.toLowerCase()) return null;
+      const status = await resolution.service.getCurrentPullRequestStatus({
+        cwd,
+        headRef: summary.headRefName,
+      });
+      if (status && urlKey(status.url) === link.url.toLowerCase()) {
+        return { status, forge: resolution.forge, cwd };
+      }
+      // Its branch now belongs to a newer change request; the summary still tells its state.
+      const state = summary.state.toLowerCase();
+      return {
+        status: {
+          ...unknownStatus(link.url),
+          title: summary.title,
+          state,
+          isMerged: state === "merged",
+          baseRefName: summary.baseRefName,
+          headRefName: summary.headRefName,
+        },
+        forge: resolution.forge,
+        cwd,
+      };
+    } catch (error) {
+      this.options.logger.debug({ err: error, url: link.url, cwd }, "Could not read a link");
+      return null;
+    }
+  }
+}
+
+/** The agent and all of its subagents, archived ones included: their links still count. */
+function collectFamily(
+  records: readonly StoredAgentRecord[],
+  agentId: string,
+): StoredAgentRecord[] {
+  const childrenOf = new Map<string, StoredAgentRecord[]>();
+  for (const record of records) {
+    const parentId = getParentAgentIdFromLabels(record.labels);
+    if (parentId) childrenOf.set(parentId, [...(childrenOf.get(parentId) ?? []), record]);
+  }
+  const root = records.find((record) => record.id === agentId);
+  if (!root) return [];
+  const family: StoredAgentRecord[] = [];
+  const seen = new Set<string>();
+  const queue = [root];
+  for (let current = queue.shift(); current; current = queue.shift()) {
+    if (seen.has(current.id)) continue;
+    seen.add(current.id);
+    family.push(current);
+    queue.push(...(childrenOf.get(current.id) ?? []));
+  }
+  return family;
+}
+
+// A session reaches the daemon's instance through its home, like the other per-home stores.
+const instances = new Map<string, AgentPullRequests>();
+
+export async function setupAgentPullRequests(
+  options: AgentPullRequestsOptions,
+): Promise<AgentPullRequests> {
+  const instance = new AgentPullRequests(options);
+  instances.set(resolve(options.paseoHome), instance);
+  await instance.start();
+  return instance;
+}
+
+type AgentPullRequestsRequest = Extract<
+  SessionInboundMessage,
+  { type: "agent.pull_requests.list.request" }
+>;
+
+export async function handleAgentPullRequestsRequest(
+  paseoHome: string,
+  msg: AgentPullRequestsRequest,
+): Promise<SessionOutboundMessage> {
+  const instance = instances.get(resolve(paseoHome));
+  return {
+    type: "agent.pull_requests.list.response",
+    payload: {
+      requestId: msg.requestId,
+      agentId: msg.agentId,
+      pullRequests: instance ? await instance.list(msg.agentId) : [],
+    },
+  };
+}
