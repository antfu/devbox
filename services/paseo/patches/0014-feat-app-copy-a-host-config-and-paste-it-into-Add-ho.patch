diff --git a/packages/app/src/screens/settings/host-config-copy-section.tsx b/packages/app/src/screens/settings/host-config-copy-section.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..5b765f4fc562efd5698d7c7524c3c8807bcc2ae0
--- /dev/null
+++ b/packages/app/src/screens/settings/host-config-copy-section.tsx
@@ -0,0 +1,84 @@
+import { useCallback } from "react";
+import { useTranslation } from "react-i18next";
+import { Text, View } from "react-native";
+import * as Clipboard from "expo-clipboard";
+import { Button } from "@/components/ui/button";
+import { SettingsSection } from "@/components/settings/headings/settings-section";
+import { useToast } from "@/contexts/toast-context";
+import { serializeHostConfig } from "@/hosts/host-config-transfer";
+import { getHostIcons } from "@/hosts/host-icon-store";
+import { getHostRuntimeStore } from "@/runtime/host-runtime";
+import { settingsStyles } from "@/styles/settings";
+import type { HostProfile } from "@/types/host-connection";
+
+function useCopyHostConfig(): (hosts: readonly HostProfile[]) => Promise<void> {
+  const { t } = useTranslation();
+  const toast = useToast();
+  return useCallback(
+    async (hosts: readonly HostProfile[]) => {
+      const icons = getHostIcons();
+      const text = serializeHostConfig(
+        hosts.map((profile) => {
+          const icon = icons[profile.serverId];
+          return icon ? { profile, icon } : { profile };
+        }),
+      );
+      try {
+        await Clipboard.setStringAsync(text);
+        toast.copied(t("settings.host.configTransfer.copiedLabel"));
+      } catch {
+        toast.error(t("settings.host.configTransfer.copyFailed"));
+      }
+    },
+    [t, toast],
+  );
+}
+
+/** Copies this host, or every saved host, as text that Add host → Paste link takes back. */
+export function HostConfigCopySection({ host }: { host: HostProfile }) {
+  const { t } = useTranslation();
+  const copy = useCopyHostConfig();
+  const handleCopyHost = useCallback(() => void copy([host]), [copy, host]);
+  const handleCopyAll = useCallback(() => void copy(getHostRuntimeStore().getHosts()), [copy]);
+
+  return (
+    <SettingsSection title={t("settings.host.configTransfer.title")}>
+      <View style={settingsStyles.card}>
+        <View style={settingsStyles.row}>
+          <View style={settingsStyles.rowContent}>
+            <Text style={settingsStyles.rowTitle}>
+              {t("settings.host.configTransfer.host.title")}
+            </Text>
+            <Text style={settingsStyles.rowHint}>
+              {t("settings.host.configTransfer.host.hint")}
+            </Text>
+          </View>
+          <Button
+            variant="outline"
+            size="sm"
+            onPress={handleCopyHost}
+            testID="host-page-copy-host-config"
+          >
+            {t("settings.host.configTransfer.copy")}
+          </Button>
+        </View>
+        <View style={[settingsStyles.row, settingsStyles.rowBorder]}>
+          <View style={settingsStyles.rowContent}>
+            <Text style={settingsStyles.rowTitle}>
+              {t("settings.host.configTransfer.all.title")}
+            </Text>
+            <Text style={settingsStyles.rowHint}>{t("settings.host.configTransfer.all.hint")}</Text>
+          </View>
+          <Button
+            variant="outline"
+            size="sm"
+            onPress={handleCopyAll}
+            testID="host-page-copy-all-hosts-config"
+          >
+            {t("settings.host.configTransfer.copy")}
+          </Button>
+        </View>
+      </View>
+    </SettingsSection>
+  );
+}
