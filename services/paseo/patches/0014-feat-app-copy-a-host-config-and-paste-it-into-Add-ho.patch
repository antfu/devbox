+}
+
+/** Replaces every saved icon at once, as a pasted or synced host list does. */
+export async function replaceHostIcons(icons: Record<string, HostIconName>): Promise<void> {
+  useHostIconStore.setState({ icons });
+  await saveHostIcons();
+}
diff --git a/packages/app/src/hosts/import-host-config.ts b/packages/app/src/hosts/import-host-config.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e412b4235c0261a804ebd4a2fdda0824c37b40fc
--- /dev/null
+++ b/packages/app/src/hosts/import-host-config.ts
@@ -0,0 +1,21 @@
+import { type HostConfigEntry, mergeImportedHosts } from "@/hosts/host-config-transfer";
+import { getHostIcons, replaceHostIcons } from "@/hosts/host-icon-store";
+import { getHostRuntimeStore } from "@/runtime/host-runtime";
+
+/** Adds the pasted hosts, or updates the saved ones they name, with their icons. */
+export async function importHostConfig(entries: readonly HostConfigEntry[]): Promise<void> {
+  const store = getHostRuntimeStore();
+  const now = new Date().toISOString();
+  await store.replaceHosts(
+    mergeImportedHosts(
+      store.getHosts(),
+      entries.map((entry) => entry.profile),
+      now,
+    ),
+  );
+  const icons = { ...getHostIcons() };
+  for (const { profile, icon } of entries) {
+    if (icon) icons[profile.serverId] = icon;
+  }
+  await replaceHostIcons(icons);
+}
