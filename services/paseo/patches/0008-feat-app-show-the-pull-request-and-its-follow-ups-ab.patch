--- /dev/null
+++ b/packages/app/src/composer/pull-request-actions.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it } from "vitest";
+import type { PrHint } from "@/git/pr-hint";
+import { selectPullRequestQuickActions } from "./pull-request-actions";
+
+function pr(overrides: Partial<PrHint> = {}): PrHint {
+  return {
+    url: "https://github.com/acme/app/pull/7",
+    number: 7,
+    state: "open",
+    forge: "github",
+    ...overrides,
+  };
+}
+
+describe("selectPullRequestQuickActions", () => {
+  it("offers to create a pull request for local changes without one", () => {
+    expect(
+      selectPullRequestQuickActions({
+        prHint: null,
+        mergeable: null,
+        hasLocalChanges: true,
+        isAgentIdle: true,
+      }),
+    ).toEqual(["createPr"]);
+    expect(
+      selectPullRequestQuickActions({
+        prHint: null,
+        mergeable: null,
+        hasLocalChanges: false,
+        isAgentIdle: true,
+      }),
+    ).toEqual([]);
+  });
+
+  it("offers to resolve conflicts and fix CI on an open pull request", () => {
+    expect(
+      selectPullRequestQuickActions({
+        prHint: pr({ checksStatus: "failure" }),
+        mergeable: "CONFLICTING",
+        hasLocalChanges: true,
+        isAgentIdle: true,
+      }),
+    ).toEqual(["resolveConflicts", "fixCi"]);
+    expect(
+      selectPullRequestQuickActions({
+        prHint: pr({ checks: [{ name: "test", status: "failure", url: null }] }),
+        mergeable: "MERGEABLE",
+        hasLocalChanges: false,
+        isAgentIdle: true,
+      }),
+    ).toEqual(["fixCi"]);
+  });
+
+  it("offers nothing for a healthy, merged or closed pull request", () => {
+    for (const hint of [pr({ checksStatus: "success" }), pr({ state: "merged" })]) {
+      expect(
+        selectPullRequestQuickActions({
+          prHint: hint,
+          mergeable: hint.state === "open" ? "MERGEABLE" : "CONFLICTING",
+          hasLocalChanges: true,
+          isAgentIdle: true,
+        }),
+      ).toEqual([]);
+    }
+  });
+
+  it("offers nothing while the agent is working", () => {
+    expect(
+      selectPullRequestQuickActions({
+        prHint: pr({ checksStatus: "failure" }),
+        mergeable: "CONFLICTING",
+        hasLocalChanges: true,
+        isAgentIdle: false,
+      }),
+    ).toEqual([]);
+  });
+});
diff --git a/packages/app/src/composer/pull-request-actions.ts b/packages/app/src/composer/pull-request-actions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6b0413069fcd7072cc97c13586e01bc823d4367d
--- /dev/null
+++ b/packages/app/src/composer/pull-request-actions.ts
@@ -0,0 +1,33 @@
+import type { PrHint } from "@/git/pr-hint";
+
+export type PullRequestQuickAction = "resolveConflicts" | "fixCi" | "createPr";
+
+export interface PullRequestActionsInput {
+  prHint: PrHint | null;
+  mergeable: "MERGEABLE" | "CONFLICTING" | "UNKNOWN" | null;
+  hasLocalChanges: boolean;
+  isAgentIdle: boolean;
+}
+
+/**
+ * The follow-ups the composer offers for the workspace's change request. Each one sends a prompt to
+ * this agent, so they only show while the agent is idle: a busy agent would have its turn
+ * interrupted. An open change request offers to resolve its merge conflicts and to fix failed CI; a
+ * workspace with local changes and no change request offers to create one.
+ */
+export function selectPullRequestQuickActions(
+  input: PullRequestActionsInput,
+): PullRequestQuickAction[] {
+  if (!input.isAgentIdle) return [];
+  if (!input.prHint) return input.hasLocalChanges ? ["createPr"] : [];
+  if (input.prHint.state !== "open") return [];
+  const actions: PullRequestQuickAction[] = [];
+  if (input.mergeable === "CONFLICTING") actions.push("resolveConflicts");
+  if (hasFailedChecks(input.prHint)) actions.push("fixCi");
+  return actions;
+}
+
+function hasFailedChecks(hint: PrHint): boolean {
+  if (hint.checks?.some((check) => check.status === "failure")) return true;
+  return hint.checksStatus === "failure";
+}
diff --git a/packages/app/src/composer/pull-request-pills.tsx b/packages/app/src/composer/pull-request-pills.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..41620b467922157036f4cd2b5cd4de45db25004e
--- /dev/null
+++ b/packages/app/src/composer/pull-request-pills.tsx
@@ -0,0 +1,220 @@
+import { memo, useCallback, useMemo, useState, type ReactElement } from "react";
+import { useTranslation } from "react-i18next";
+import { Text } from "react-native";
+import { Zap } from "lucide-react-native";
+import { withUnistyles } from "react-native-unistyles";
+import { CheckIndicator } from "@/components/sidebar/workspace-meta-row/check-indicator";
+import { selectCheckSummary } from "@/components/sidebar/workspace-meta-row/check-summary";
+import { PressHighlight } from "@/components/ui/press-highlight";
+import { dispatchComposerAgentMessage } from "@/composer/actions";
+import { composerPillStyles } from "@/composer/pill-styles";
+import {
+  selectPullRequestQuickActions,
+  type PullRequestQuickAction,
+} from "@/composer/pull-request-actions";
+import { fillQuickActionPrompt, useQuickActionPromptsStore } from "@/composer/quick-action-prompts";
+import { createMessageSubmissionWriter } from "@/composer/submission/writer";
+import { useToast } from "@/contexts/toast-context";
+import { getForgePresentation, normalizeForge } from "@/git/forge";
+import { selectPrHintFromStatus, type PrHint } from "@/git/pr-hint";
+import { PullRequestStateIcon } from "@/git/pull-request-state-icon";
+import { useHostRuntimeClient } from "@/runtime/host-runtime";
+import { selectAgentTurnPresentation, useSessionStore } from "@/stores/session-store";
+import { useWorkspaceFields } from "@/stores/session-store-hooks";
+import type { Theme } from "@/styles/theme";
+import { openExternalUrl } from "@/utils/open-external-url";
+
+const ICON_SIZE = 14;
+
+const ThemedZap = withUnistyles(Zap);
+const mutedMapping = (theme: Theme) => ({ color: theme.colors.foregroundMuted });
+const foregroundMapping = (theme: Theme) => ({ color: theme.colors.foreground });
+
+interface WorkspacePullRequestState {
+  prHint: PrHint | null;
+  mergeable: "MERGEABLE" | "CONFLICTING" | "UNKNOWN" | null;
+  baseRefName: string | null;
+  hasLocalChanges: boolean;
+}
+
+function useWorkspacePullRequestState(
+  serverId: string,
+  workspaceId: string,
+): WorkspacePullRequestState | null {
+  return useWorkspaceFields(serverId, workspaceId, (workspace) => {
+    const pullRequest = workspace.githubRuntime?.pullRequest ?? null;
+    return {
+      prHint: selectPrHintFromStatus(pullRequest, workspace.forge),
+      mergeable: pullRequest?.mergeable ?? null,
+      baseRefName: pullRequest?.baseRefName ?? null,
+      hasLocalChanges: Boolean(
+        workspace.diffStat &&
+        (workspace.diffStat.additions > 0 || workspace.diffStat.deletions > 0),
+      ),
+    };
+  });
+}
+
+/** Whether `WorkspacePullRequestPills` draws anything, so the track bar knows to show itself. */
+export function useHasWorkspacePullRequestPills(
+  serverId: string,
+  workspaceId: string,
+  agentId: string,
+): boolean {
+  const state = useWorkspacePullRequestState(serverId, workspaceId);
+  const isAgentIdle = useIsAgentIdle(serverId, agentId);
+  if (!state) return false;
+  return (
+    state.prHint !== null || selectPullRequestQuickActions({ ...state, isAgentIdle }).length > 0
+  );
+}
+
+function useIsAgentIdle(serverId: string, agentId: string): boolean {
+  return useSessionStore(
+    (state) => !selectAgentTurnPresentation(state.sessions[serverId], agentId).isActive,
+  );
+}
+
+/**
+ * The workspace's change request beside the diff stat above the composer, and the follow-ups it
+ * calls for: resolve conflicts and fix CI on an open change request, create one for local changes
+ * that have none. A follow-up sends its prompt to this agent.
+ */
+export const WorkspacePullRequestPills = memo(function WorkspacePullRequestPills({
+  serverId,
+  workspaceId,
+  agentId,
+}: {
+  serverId: string;
+  workspaceId: string;
+  agentId: string;
+}): ReactElement | null {
+  const { t } = useTranslation();
+  const toast = useToast();
+  const client = useHostRuntimeClient(serverId);
+  const state = useWorkspacePullRequestState(serverId, workspaceId);
+  const isAgentIdle = useIsAgentIdle(serverId, agentId);
+  const actions = useMemo(
+    () => (state ? selectPullRequestQuickActions({ ...state, isAgentIdle }) : []),
+    [isAgentIdle, state],
+  );
+
+  const runAction = useCallback(
+    async (action: PullRequestQuickAction) => {
+      if (!client) {
+        toast.error(t("workspace.terminal.hostDisconnected"));
+        return;
+      }
+      const values = { url: state?.prHint?.url ?? "", base: state?.baseRefName ?? "" };
+      // A prompt set in Settings → Quick actions wins over the default.
+      const customPrompt = useQuickActionPromptsStore.getState().prompts[action];
+      const text = customPrompt
+        ? fillQuickActionPrompt(customPrompt, values)
+        : t(`workspace.git.pr.quickActions.${action}.prompt`, values);
+      try {
+        await dispatchComposerAgentMessage({
+          client,
+          agentId,
+          text,
+          attachments: [],
+          encodeImages: async () => undefined,
+          submission: createMessageSubmissionWriter(serverId),
+        });
+      } catch (error) {
+        toast.error(error instanceof Error ? error.message : String(error));
+      }
+    },
+    [agentId, client, serverId, state, t, toast],
+  );
+
+  if (!state) return null;
+  return (
+    <>
+      {state.prHint ? <PullRequestPill hint={state.prHint} /> : null}
+      {actions.map((action) => (
+        <QuickActionPill key={action} action={action} onRun={runAction} />
+      ))}
+    </>
+  );
+});
+
+function PullRequestPill({ hint }: { hint: PrHint }) {
+  const { t } = useTranslation();
+  const [isHovered, setIsHovered] = useState(false);
+  const presentation = getForgePresentation(normalizeForge(hint.forge));
+  const checkSummary = useMemo(() => selectCheckSummary(hint), [hint]);
+  const handlePress = useCallback(() => void openExternalUrl(hint.url), [hint.url]);
+  const handleHoverIn = useCallback(() => setIsHovered(true), []);
+  const handleHoverOut = useCallback(() => setIsHovered(false), []);
+  const bodyStyle = useMemo(
+    () => [composerPillStyles.body, isHovered && composerPillStyles.bodyActive],
+    [isHovered],
+  );
+
+  return (
+    <PressHighlight
+      testID="composer-pull-request-pill"
+      accessibilityRole="link"
+      accessibilityLabel={t("workspace.git.pr.accessibility.pullRequest", {
+        number: hint.number,
+        context: presentation.changeRequestContext,
+      })}
+      onPress={handlePress}
+      onHoverIn={handleHoverIn}
+      onHoverOut={handleHoverOut}
+      style={bodyStyle}
+    >
+      <PullRequestStateIcon state={hint.state} size={ICON_SIZE} hasConflicts={hint.hasConflicts} />
+      <Text
+        style={[composerPillStyles.label, isHovered && composerPillStyles.labelActive]}
+        numberOfLines={1}
+      >
+        {presentation.numberPrefix}
+        {hint.number}
+      </Text>
+      {checkSummary ? <CheckIndicator summary={checkSummary} size={ICON_SIZE} /> : null}
+    </PressHighlight>
+  );
+}
+
+function QuickActionPill({
+  action,
+  onRun,
+}: {
+  action: PullRequestQuickAction;
+  onRun: (action: PullRequestQuickAction) => Promise<void>;
+}) {
+  const { t } = useTranslation();
+  const [isHovered, setIsHovered] = useState(false);
+  const [isSending, setIsSending] = useState(false);
+  const handlePress = useCallback(() => {
+    setIsSending(true);
+    void onRun(action).finally(() => setIsSending(false));
+  }, [action, onRun]);
+  const handleHoverIn = useCallback(() => setIsHovered(true), []);
+  const handleHoverOut = useCallback(() => setIsHovered(false), []);
+  const bodyStyle = useMemo(
+    () => [composerPillStyles.body, isHovered && composerPillStyles.bodyActive],
+    [isHovered],
+  );
+
+  return (
+    <PressHighlight
+      testID={`composer-pull-request-action-${action}`}
+      accessibilityRole="button"
+      onPress={handlePress}
+      onHoverIn={handleHoverIn}
+      onHoverOut={handleHoverOut}
+      disabled={isSending}
+      style={bodyStyle}
+    >
+      <ThemedZap size={ICON_SIZE} uniProps={isHovered ? foregroundMapping : mutedMapping} />
+      <Text
+        style={[composerPillStyles.label, isHovered && composerPillStyles.labelActive]}
+        numberOfLines={1}
+      >
+        {t(`workspace.git.pr.quickActions.${action}.label`)}
+      </Text>
+    </PressHighlight>
+  );
+}
