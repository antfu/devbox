diff --git a/packages/app/src/composer/quick-action-prompt-sync.tsx b/packages/app/src/composer/quick-action-prompt-sync.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a6ef8c9ec2e5833c45f9b2fc92185103bfa02d90
--- /dev/null
+++ b/packages/app/src/composer/quick-action-prompt-sync.tsx
@@ -0,0 +1,68 @@
+import { useEffect } from "react";
+import { useShallow } from "zustand/shallow";
+import { useQuickActionPromptsStore } from "@/composer/quick-action-prompts";
+import { useHostFeature } from "@/runtime/host-features";
+import { useHostRuntimeClient, useHostRuntimeIsConnected } from "@/runtime/host-runtime";
+import { useSessionStore } from "@/stores/session-store";
+
+/** The quick actions a host sends on its own when it listens to a pull request. */
+const HOST_ACTIONS = ["resolveConflicts", "fixCi", "addressReview"] as const;
+
+type HostPrompts = Partial<Record<(typeof HOST_ACTIONS)[number], string>>;
+
+// The custom prompts each host was last sent, so a prompt goes out once per change.
+const sentByServerId = new Map<string, HostPrompts>();
+
+/**
+ * What to send a host: each custom prompt it does not have yet, and an empty one for each prompt
+ * that went back to its default. Prompts this device never changed are left out, so they do not
+ * replace what another device saved on the host.
+ */
+export function selectQuickActionPromptPatch(prompts: HostPrompts, sent: HostPrompts): HostPrompts {
+  const patch: HostPrompts = {};
+  for (const action of HOST_ACTIONS) {
+    if (prompts[action] !== sent[action]) patch[action] = prompts[action] ?? "";
+  }
+  return patch;
+}
+
+/**
+ * Gives the host this device's quick action prompts, so the follow-ups it sends on its own read
+ * the same as the ones sent from here.
+ */
+export function useSyncQuickActionPrompts(serverId: string): void {
+  const client = useHostRuntimeClient(serverId);
+  const isConnected = useHostRuntimeIsConnected(serverId);
+  const isSupported = useHostFeature(serverId, "pullRequestAutoListen");
+  const prompts = useQuickActionPromptsStore((state) => state.prompts);
+
+  useEffect(() => {
+    if (!client || !isConnected || !isSupported) return;
+    const sent = sentByServerId.get(serverId) ?? {};
+    const patch = selectQuickActionPromptPatch(prompts, sent);
+    if (Object.keys(patch).length === 0) return;
+    const next: HostPrompts = {};
+    for (const action of HOST_ACTIONS) {
+      if (prompts[action] !== undefined) next[action] = prompts[action];
+    }
+    sentByServerId.set(serverId, next);
+    client.setPullRequestPrompts(patch).catch((error: unknown) => {
+      console.warn("[QuickActionPrompts] Failed to send the prompts to the host", { error });
+      // Send it again on the next change or the next mount.
+      sentByServerId.set(serverId, sent);
+    });
+  }, [client, isConnected, isSupported, prompts, serverId]);
+}
+
+function HostQuickActionPromptSync({ serverId }: { serverId: string }) {
+  useSyncQuickActionPrompts(serverId);
+  return null;
+}
+
+/** Sends a changed prompt to every connected host, for the screen where prompts are edited. */
+export function QuickActionPromptSync() {
+  const serverIds = useSessionStore(useShallow((state) => Object.keys(state.sessions)));
+  return serverIds.map((serverId) => (
+    <HostQuickActionPromptSync key={serverId} serverId={serverId} />
+  ));
+}
