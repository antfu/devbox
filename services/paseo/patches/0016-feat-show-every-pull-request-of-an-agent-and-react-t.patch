+import { AgentPullRequestStore, fillPullRequestPrompt } from "./store.js";
+
+export interface AgentPullRequestsOptions {
+  paseoHome: string;
+  agentManager: Pick<AgentManager, "subscribe" | "getAgent" | "getTimeline">;
+  agentStorage: Pick<AgentStorage, "listAll">;
+  workspaceGitService: Pick<WorkspaceGitService, "getSnapshot" | "resolveForge">;
+  /** Sends a follow-up to an agent, as a prompt typed in the composer would be. */
+  sendPrompt: (agentId: string, prompt: string) => Promise<unknown>;
+  logger: Logger;
+  now?: () => number;
+}
+
+/** A change request and the agent that holds it: through its checkout, or through a link. */
+interface HeldPullRequest {
+  agentId: string;
+  cwd: string;
+  status: PullRequestStatus;
+  forge: string | undefined;
+  viaLink: boolean;
+}
+
+type PullRequestStatus = Omit<CurrentPullRequestStatus, "mergeable"> & {
+  mergeable?: CurrentPullRequestStatus["mergeable"];
+};
+
+interface CachedLinkStatus {
+  status: PullRequestStatus;
+  forge: string | undefined;
+  /** The checkout whose forge knew the link, tried first next time. */
+  cwd: string | null;
+  fetchedAt: number;
+  /** The collecting round that read it, so one round asks the forge once per link. */
+  round: number;
+}
+
+const POLL_INTERVAL_MS = 90_000;
+// The first poll only notes what is already there, so it can run soon after the daemon starts.
+const FIRST_POLL_DELAY_MS = 20_000;
+// How long a list request reuses a link's status before asking the forge again.
+const LINK_STATUS_TTL_MS = 30_000;
+// A merged or closed change request rarely changes again.
+const SETTLED_LINK_STATUS_TTL_MS = 30 * 60_000;
+const UNREADABLE_LINK_RETRY_MS = 10 * 60_000;
+// About a quarter of an hour of rounds before a change request nobody holds is forgotten.
+const MAX_MISSED_ROUNDS = 10;
+const MAX_TURN_SPANS = 20;
+const REFRESH_REASON = "agent-pull-requests";
+
+function urlKey(url: string): string {
+  return (parsePullRequestUrl(url)?.url ?? url).toLowerCase();
+}
+
+function isOpen(status: PullRequestStatus): boolean {
+  return !status.isMerged && status.state.toLowerCase() === "open";
+}
+
+function isSettled(status: PullRequestStatus): boolean {
+  const state = status.state.toLowerCase();
+  return status.isMerged || state === "merged" || state === "closed";
+}
+
+function unknownStatus(url: string): PullRequestStatus {
+  return {
+    url,
+    number: parsePullRequestUrl(url)?.number,
+    title: "",
+    state: "unknown",
+    baseRefName: "",
+    headRefName: "",
+    isMerged: false,
+    checks: [],
+    checksStatus: "none",
+    reviewDecision: null,
+  };
+}
+
+function toPayload(held: HeldPullRequest): AgentPullRequestPayload {
+  const { status } = held;
+  return {
+    url: status.url,
+    ...(status.number === undefined ? {} : { number: status.number }),
+    title: status.title,
+    state: status.state,
+    isMerged: status.isMerged,
+    ...(status.isDraft === undefined ? {} : { isDraft: status.isDraft }),
+    baseRefName: status.baseRefName,
+    headRefName: status.headRefName,
+    ...(status.mergeable ? { mergeable: status.mergeable } : {}),
+    checks: status.checks.map((check) => ({
+      name: check.name,
+      status: check.status,
+      url: check.url,
+      ...(check.workflow ? { workflow: check.workflow } : {}),
+      ...(check.duration ? { duration: check.duration } : {}),
+      ...(check.traits ? { traits: check.traits } : {}),
+    })),
+    checksStatus: status.checksStatus,
+    reviewDecision: status.reviewDecision,
+    ...(held.forge ? { forge: held.forge } : {}),
+    agentId: held.agentId,
+  };
+}
+
+/**
+ * Knows every change request an agent works on, and answers their reviews, failed checks and
+ * conflicts for it.
+ *
+ * An agent holds the change request of the branch checked out where it runs, and every change
+ * request one of its tool calls created. A parent also shows what its subagents hold. Reactions go
+ * to one agent per change request, so two sessions on one checkout are not both sent to fix it.
+ */
+export class AgentPullRequests {
+  private readonly store: AgentPullRequestStore;
+  private readonly now: () => number;
+  private readonly linkStatuses = new Map<string, CachedLinkStatus>();
+  private readonly memories = new Map<string, ReactionMemory>();
+  private readonly owners = new Map<string, string>();
+  /** Links found live, after the first poll: unlike the rest, their failures are news. */
+  private readonly freshLinks = new Set<string>();
+  private readonly turns = new Map<string, AgentTurnSpan[]>();
+  private readonly scannedAgents = new Set<string>();
+  private hasPolled = false;
+  private stopped = false;
+  /** Rounds in a row that did not see a remembered change request. */
+  private readonly misses = new Map<string, number>();
+  private round = 0;
+  private polling: Promise<void> | null = null;
+  private firstPoll: NodeJS.Timeout | null = null;
+  private timer: NodeJS.Timeout | null = null;
+  private unsubscribe: (() => void) | null = null;
+
+  constructor(private readonly options: AgentPullRequestsOptions) {
+    this.store = new AgentPullRequestStore(options.paseoHome);
+    this.now = options.now ?? Date.now;
+  }
+
+  async start(): Promise<void> {
+    try {
+      await this.store.load();
+    } catch (error) {
+      this.options.logger.warn({ err: error }, "Could not read the saved pull request links");
+    }
+    this.unsubscribe = this.options.agentManager.subscribe((event) => this.onAgentEvent(event), {
+      replayState: false,
+    });
+    this.firstPoll = setTimeout(() => void this.poll(), FIRST_POLL_DELAY_MS);
+    this.firstPoll.unref();
+    this.timer = setInterval(() => void this.poll(), POLL_INTERVAL_MS);
+    this.timer.unref();
+  }
+
+  /** Stops watching; resolves once the links found so far are on disk. */
+  async stop(): Promise<void> {
+    this.stopped = true;
+    this.unsubscribe?.();
+    this.unsubscribe = null;
+    if (this.firstPoll) clearTimeout(this.firstPoll);
+    if (this.timer) clearInterval(this.timer);
+    this.firstPoll = null;
+    this.timer = null;
+    // A round in flight must not send a follow-up to agents that are closing.
+    await this.polling;
+    await this.store.flush();
+  }
+
+  setPrompts(prompts: Parameters<AgentPullRequestStore["setPrompts"]>[0]): void {
+    this.store.setPrompts(prompts);
+  }
+
+  /** The change requests the agent and its subagents work on, the agent's own first. */
+  async list(agentId: string): Promise<AgentPullRequestPayload[]> {
+    const records = await this.options.agentStorage.listAll();
+    const family = collectFamily(records, agentId);
+    const held = await this.collectHeld(family, { force: false });
+    const byUrl = new Map<string, HeldPullRequest>();
+    for (const entry of held) {
+      const key = urlKey(entry.status.url);
+      const existing = byUrl.get(key);
+      // The agent's own entry wins over a subagent's, and a read status over an unread link.
+      if (
+        !existing ||
+        (existing.agentId !== agentId && entry.agentId === agentId) ||
+        (existing.status.state === "unknown" && entry.status.state !== "unknown")
+      ) {
+        byUrl.set(key, entry);
+      }
+    }
+    return [...byUrl.values()]
+      .sort((left, right) => {
+        const leftOwn = left.agentId === agentId && !left.viaLink;
+        const rightOwn = right.agentId === agentId && !right.viaLink;
+        if (leftOwn !== rightOwn) return leftOwn ? -1 : 1;
+        return (left.status.number ?? 0) - (right.status.number ?? 0);
+      })
+      .map(toPayload);
+  }
+
+  /** One round of looking at every listened change request. Rounds never overlap. */
+  poll(): Promise<void> {
+    this.polling ??= this.pollOnce()
+      .catch((error) => {
+        this.options.logger.warn({ err: error }, "Pull request poll failed");
+      })
+      .finally(() => {
+        this.polling = null;
+      });
+    return this.polling;
+  }
+
+  private async pollOnce(): Promise<void> {
+    const records = (await this.options.agentStorage.listAll()).filter(
+      (record) => !record.internal,
+    );
+    const byId = new Map(records.map((record) => [record.id, record]));
+    // Only agents someone listens for cost forge calls. An archived agent no longer runs in a
+    // checkout, but the links it created live on with its nearest unarchived parent.
+    const holders = records.filter((record) => {
+      if (record.archivedAt && this.store.linksOf(record.id).length === 0) return false;
+      const answering = nearestUnarchived(record, byId);
+      return answering !== null && isListening(answering, byId);
+    });
+    const held = await this.collectHeld(holders, { force: true });
+
+    const byUrl = new Map<string, HeldPullRequest[]>();
+    for (const entry of held) {
+      if (entry.status.state === "unknown") continue;
+      const key = urlKey(entry.status.url);
+      byUrl.set(key, [...(byUrl.get(key) ?? []), entry]);
+    }
+
+    const baseline = !this.hasPolled;
+    const prompted = new Set<string>();
+    for (const [key, entries] of byUrl) {
+      const owner = this.pickOwner(key, entries, byId);
+      if (!owner) continue;
+      const entry = entries.find((candidate) => candidate.agentId === owner.id) ?? entries[0];
+      await this.react({
+        key,
+        entry,
+        owner,
+        baseline: baseline || !this.freshLinks.has(key),
+        prompted,
+      });
+    }
+    this.hasPolled = true;
+    // One failed forge read looks the same as a change request that is gone. Forgetting on it
+    // would take the next look as the first one and drop what was waiting to be sent.
+    for (const key of this.memories.keys()) {
+      if (byUrl.has(key)) {
+        this.misses.delete(key);
+        continue;
+      }
+      const missed = (this.misses.get(key) ?? 0) + 1;
+      this.misses.set(key, missed);
+      if (missed >= MAX_MISSED_ROUNDS) this.forget(key);
+    }
+  }
+
+  private forget(key: string): void {
+    this.misses.delete(key);
+    this.memories.delete(key);
+    this.owners.delete(key);
+    this.freshLinks.delete(key);
+  }
+
+  /**
+   * The one agent that answers a change request: an agent that still listens and either holds it
+   * or is the nearest unarchived parent of an archived holder. The agent that created it wins,
+   * then the one the user wrote to last. The choice sticks while it stays valid.
+   */
+  private pickOwner(
+    key: string,
+    entries: readonly HeldPullRequest[],
+    byId: ReadonlyMap<string, StoredAgentRecord>,
+  ): StoredAgentRecord | null {
+    const candidates = new Map<string, { record: StoredAgentRecord; viaLink: boolean }>();
+    for (const entry of entries) {
+      const holder = byId.get(entry.agentId);
+      const record = holder ? nearestUnarchived(holder, byId) : null;
+      if (!record || !isListening(record, byId)) continue;
+      const viaLink = entry.viaLink && record.id === entry.agentId;
+      const existing = candidates.get(record.id);
+      candidates.set(record.id, { record, viaLink: viaLink || existing?.viaLink === true });
+    }
+    const previous = candidates.get(this.owners.get(key) ?? "");
+    if (previous) return previous.record;
+    const [best] = [...candidates.values()].sort((left, right) => {
+      if (left.viaLink !== right.viaLink) return left.viaLink ? -1 : 1;
+      return lastUsedAt(right.record) - lastUsedAt(left.record);
+    });
+    if (!best) {
+      this.owners.delete(key);
+      return null;
+    }
+    this.owners.set(key, best.record.id);
+    return best.record;
+  }
+
+  private async react(input: {
+    key: string;
+    entry: HeldPullRequest;
+    owner: StoredAgentRecord;
+    baseline: boolean;
+    prompted: Set<string>;
+  }): Promise<void> {
+    const { key, entry, owner } = input;
+    const status = { ...entry.status, mergeable: entry.status.mergeable ?? "UNKNOWN" };
+    const reviewItems = isOpen(entry.status) ? await this.readReviewItems(entry) : null;
+    const activity = this.agentActivity(owner.id);
+    const result = observePullRequest({
+      memory: this.memories.get(key),
+      baseline: input.baseline,
+      status,
+      reviewItems,
+      // One follow-up per agent per round; the next round sees whether it is idle again.
+      agentBusy: activity.busy || input.prompted.has(owner.id),
+      agentTurns: activity.turns,
+    });
+    const previous = this.memories.get(key);
+    this.memories.set(key, result.memory);
+    if (!result.reaction || this.stopped) return;
+
+    input.prompted.add(owner.id);
+    const prompt = fillPullRequestPrompt(this.store.promptFor(result.reaction), {
+      url: entry.status.url,
+      base: entry.status.baseRefName,
+    });
+    this.options.logger.info(
+      { agentId: owner.id, url: entry.status.url, reaction: result.reaction },
+      "Sending a pull request follow-up",
+    );
+    try {
+      await this.options.sendPrompt(owner.id, prompt);
+    } catch (error) {
+      this.options.logger.warn(
+        { err: error, agentId: owner.id, url: entry.status.url },
+        "Could not send a pull request follow-up",
+      );
+      // Not delivered: look at it again next round, as if this one had not happened.
+      if (previous) this.memories.set(key, previous);
+    }
+  }
+
+  private async readReviewItems(entry: HeldPullRequest): Promise<PullRequestTimelineItem[] | null> {
+    const { number, repoOwner, repoName } = entry.status;
+    if (number === undefined || !repoOwner || !repoName) return null;
+    try {
+      const resolution = await this.options.workspaceGitService.resolveForge(entry.cwd);
+      if (!resolution) return null;
+      const timeline = await resolution.service.getPullRequestTimeline({
+        cwd: entry.cwd,
+        prNumber: number,
+        repoOwner,
+        repoName,
+        force: true,
+        reason: REFRESH_REASON,
+      });
+      return timeline.error ? null : timeline.items;
+    } catch (error) {
+      this.options.logger.debug({ err: error, url: entry.status.url }, "Could not read reviews");
+      return null;
+    }
+  }
+
+  private agentActivity(agentId: string): { busy: boolean; turns: AgentTurnSpan[] } {
+    const live = this.options.agentManager.getAgent(agentId);
+    // An unloaded agent is idle. One in error or waiting on a permission is not ready for more.
+    const busy =
+      live !== null &&
+      ((live.lifecycle !== "idle" && live.lifecycle !== "closed") ||
+        live.pendingPermissions.size > 0);
+    if (live?.lifecycle === "running") this.noteTurn(agentId, true, live.activeTurnStartedAt);
+    return { busy, turns: this.turns.get(agentId) ?? [] };
+  }
+
+  private noteTurn(agentId: string, running: boolean, startedAt?: Date | null): void {
+    const spans = this.turns.get(agentId) ?? [];
+    const last = spans.at(-1);
+    const open = last && last.end === null ? last : null;
+    if (running && !open) {
+      spans.push({ start: startedAt?.getTime() ?? this.now(), end: null });
+    } else if (!running && open) {
+      open.end = this.now();
+    } else {
+      return;
+    }
+    this.turns.set(agentId, spans.slice(-MAX_TURN_SPANS));
+  }
+
+  private onAgentEvent(event: AgentManagerEvent): void {
+    switch (event.type) {
+      case "agent_state":
+        this.noteTurn(
+          event.agent.id,
+          event.agent.lifecycle === "running",
+          event.agent.activeTurnStartedAt,
+        );
+        return;
+      case "agent_stream":
+        if (event.event.type === "timeline") {
+          this.recordLinks(event.agentId, event.event.item, true);
+        }
+        return;
+      case "provider_subagent":
+        // A provider's own subagents run inside their parent's session, so the parent holds them.
+        if (event.event.type === "timeline") {
+          this.recordLinks(event.event.parentAgentId, event.event.row.item, true);
+        }
+        return;
+      case "agent_removed":
+        this.store.removeAgent(event.agentId);
+        this.turns.delete(event.agentId);
+        this.scannedAgents.delete(event.agentId);
+        return;
+      default:
+    }
+  }
+
+  private recordLinks(agentId: string, item: AgentTimelineItem, live: boolean): void {
+    const urls = extractCreatedPullRequestUrls(item);
+    if (urls.length === 0) return;
+    const agent = this.options.agentManager.getAgent(agentId);
+    if (!agent || agent.internal) return;
+    const cwd =
+      item.type === "tool_call" && item.detail.type === "shell" && item.detail.cwd
+        ? item.detail.cwd
+        : agent.cwd;
+    for (const url of urls) {
+      const added = this.store.addLink(agentId, { url, cwd });
+      if (added && live && this.hasPolled) this.freshLinks.add(urlKey(url));
+    }
+  }
+
+  /** Reads a loaded agent's history once, for links created before the daemon started watching. */
+  private scanTimeline(agentId: string): void {
+    if (this.scannedAgents.has(agentId)) return;
+    let items: AgentTimelineItem[];
+    try {
+      items = this.options.agentManager.getTimeline(agentId);
+    } catch {
+      // Not loaded: its links, if any, were saved when it ran.
+      return;
+    }
+    this.scannedAgents.add(agentId);
+    for (const item of items) this.recordLinks(agentId, item, false);
+  }
+
+  private async collectHeld(
+    agents: readonly StoredAgentRecord[],
+    options: { force: boolean },
+  ): Promise<HeldPullRequest[]> {
+    const held: HeldPullRequest[] = [];
+    const cwds = [
+      ...new Set(agents.filter((agent) => !agent.archivedAt).map((a) => resolve(a.cwd))),
+    ];
+    this.round += 1;
+    const { round } = this;
+
+    const checkouts = new Map<string, HeldPullRequest | null>();
+    for (const cwd of cwds) checkouts.set(cwd, await this.readCheckout(cwd, options.force));
+    const checkoutByUrl = new Map<string, HeldPullRequest>();
+    for (const entry of checkouts.values()) {
+      if (entry) checkoutByUrl.set(urlKey(entry.status.url), entry);
+    }
+
+    for (const agent of agents) {
+      if (!agent.archivedAt) {
+        const entry = checkouts.get(resolve(agent.cwd));
+        if (entry) held.push({ ...entry, agentId: agent.id });
+        this.scanTimeline(agent.id);
+      }
+      for (const link of this.store.linksOf(agent.id)) {
+        // A link to a checked-out branch's change request needs no second read.
+        const read =
+          checkoutByUrl.get(urlKey(link.url)) ??
+          (await this.readLink(link.url, [link.cwd, ...cwds], { force: options.force, round }));
+        held.push({
+          agentId: agent.id,
+          cwd: read.cwd ?? link.cwd,
+          status: read.status,
+          forge: read.forge,
+          viaLink: true,
+        });
+      }
+    }
+    return held;
+  }
+
+  private async readCheckout(cwd: string, force: boolean): Promise<HeldPullRequest | null> {
+    try {
+      const git = this.options.workspaceGitService;
+      let snapshot = await git.getSnapshot(cwd);
+      // Upstream refreshes a checkout for the clients that watch it; with none connected, ask.
+      const known = snapshot.forge.pullRequest;
+      if (force && known && !known.isMerged && known.state.toLowerCase() === "open") {
+        snapshot = await git.getSnapshot(cwd, { force: true, reason: REFRESH_REASON });
+      }
+      const status = snapshot.forge.pullRequest;
+      if (!status) return null;
+      return {
+        agentId: "",
+        cwd,
+        status: {
+          ...status,
+          checks: status.checks ?? [],
+          checksStatus: status.checksStatus ?? "none",
+          reviewDecision: status.reviewDecision ?? null,
+        },
+        forge: snapshot.forge.forge,
+        viaLink: false,
+      };
+    } catch (error) {
+      this.options.logger.debug({ err: error, cwd }, "Could not read a checkout's pull request");
+      return null;
+    }
+  }
+
+  /**
+   * A link's status, read through the forge of a checkout on the same repository. A link into a
+   * repository none of the agents has checked out stays `unknown`: the forge adapters only answer
+   * for the repository of a working directory.
+   */
+  private async readLink(
+    url: string,
+    cwds: readonly string[],
+    options: { force: boolean; round: number },
+  ): Promise<CachedLinkStatus> {
+    const { force } = options;
+    const key = urlKey(url);
+    const cached = this.linkStatuses.get(key);
+    if (cached && this.isLinkStatusFresh(cached, options)) return cached;
+    const link = parsePullRequestUrl(url);
+    const candidates = link ? [...new Set([...(cached?.cwd ? [cached.cwd] : []), ...cwds])] : [];
+    let next: CachedLinkStatus = {
+      status: cached?.status ?? unknownStatus(url),
+      forge: cached?.forge,
+      cwd: null,
+      fetchedAt: this.now(),
+      round: options.round,
+    };
+    for (const cwd of candidates) {
+      const read = await this.readLinkIn(url, cwd, force);
+      if (read) {
+        next = { ...read, fetchedAt: this.now(), round: options.round };
+        break;
+      }
+    }
+    this.linkStatuses.set(key, next);
+    return next;
+  }
+
+  private isLinkStatusFresh(
+    cached: CachedLinkStatus,
+    options: { force: boolean; round: number },
+  ): boolean {
+    const age = this.now() - cached.fetchedAt;
+    if (isSettled(cached.status)) return age < SETTLED_LINK_STATUS_TTL_MS;
+    // No checkout's forge knew it. Asking every checkout again each round would only burn calls.
+    if (cached.cwd === null) return age < UNREADABLE_LINK_RETRY_MS;
+    // A poll reads each open link once per round, however many agents hold it.
+    if (options.force) return cached.round === options.round;
+    return age < LINK_STATUS_TTL_MS;
+  }
+
+  private async readLinkIn(
+    url: string,
+    cwd: string,
+    force: boolean,
+  ): Promise<Omit<CachedLinkStatus, "fetchedAt" | "round"> | null> {
+    const link = parsePullRequestUrl(url);
+    if (!link) return null;
+    try {
+      const resolution = await this.options.workspaceGitService.resolveForge(cwd);
+      if (!resolution) return null;
+      const read = force ? ({ force: true, reason: REFRESH_REASON } as const) : {};
+      const summary = await resolution.service.getPullRequest({ cwd, number: link.number });
+      // The same number in another repository is another change request.
+      if (urlKey(summary.url) !== link.url.toLowerCase()) return null;
+      const status = await resolution.service.getCurrentPullRequestStatus({
+        cwd,
+        headRef: summary.headRefName,
+        ...read,
+      });
+      if (status && urlKey(status.url) === link.url.toLowerCase()) {
+        return { status, forge: resolution.forge, cwd };
+      }
+      // Its branch now belongs to a newer change request; the summary still tells its state.
+      const state = summary.state.toLowerCase();
+      return {
+        status: {
+          ...unknownStatus(link.url),
+          title: summary.title,
+          state,
+          isMerged: state === "merged",
+          baseRefName: summary.baseRefName,
+          headRefName: summary.headRefName,
+        },
+        forge: resolution.forge,
+        cwd,
+      };
+    } catch (error) {
+      this.options.logger.debug({ err: error, url: link.url, cwd }, "Could not read a link");
+      return null;
+    }
+  }
+}
+
+/** A session listens when its checkbox and those of all its parents are on. */
+function isListening(
+  record: StoredAgentRecord,
+  byId: ReadonlyMap<string, StoredAgentRecord>,
+): boolean {
+  const seen = new Set<string>();
+  let current: StoredAgentRecord | undefined = record;
+  while (current && !seen.has(current.id)) {
+    if (!isPullRequestAutoListenOn(current.labels)) return false;
+    seen.add(current.id);
+    current = byId.get(getParentAgentIdFromLabels(current.labels) ?? "");
+  }
+  return true;
+}
+
+function lastUsedAt(record: StoredAgentRecord): number {
+  const parsed = Date.parse(record.lastUserMessageAt ?? record.createdAt);
+  return Number.isFinite(parsed) ? parsed : 0;
+}
+
+function nearestUnarchived(
+  record: StoredAgentRecord,
+  byId: ReadonlyMap<string, StoredAgentRecord>,
+): StoredAgentRecord | null {
+  const seen = new Set<string>();
+  let current: StoredAgentRecord | undefined = record;
+  while (current && !seen.has(current.id)) {
+    if (!current.archivedAt) return current;
+    seen.add(current.id);
+    current = byId.get(getParentAgentIdFromLabels(current.labels) ?? "");
+  }
+  return null;
+}
+
+/** The agent and all of its subagents, archived ones included: their links still count. */
+function collectFamily(
+  records: readonly StoredAgentRecord[],
+  agentId: string,
+): StoredAgentRecord[] {
+  const childrenOf = new Map<string, StoredAgentRecord[]>();
+  for (const record of records) {
+    const parentId = getParentAgentIdFromLabels(record.labels);
+    if (parentId) childrenOf.set(parentId, [...(childrenOf.get(parentId) ?? []), record]);
+  }
+  const root = records.find((record) => record.id === agentId);
+  if (!root) return [];
+  const family: StoredAgentRecord[] = [];
+  const seen = new Set<string>();
+  const queue = [root];
+  for (let current = queue.shift(); current; current = queue.shift()) {
+    if (seen.has(current.id)) continue;
+    seen.add(current.id);
+    family.push(current);
+    queue.push(...(childrenOf.get(current.id) ?? []));
+  }
+  return family;
+}
+
+// A session reaches the daemon's instance through its home, like the other per-home stores.
+const instances = new Map<string, AgentPullRequests>();
+
+export async function setupAgentPullRequests(
+  options: AgentPullRequestsOptions,
+): Promise<AgentPullRequests> {
+  const instance = new AgentPullRequests(options);
+  instances.set(resolve(options.paseoHome), instance);
+  await instance.start();
+  return instance;
+}
+
+type AgentPullRequestsRequest = Extract<
+  SessionInboundMessage,
+  { type: "agent.pull_requests.list.request" | "agent.pull_requests.set_prompts.request" }
+>;
+
+export async function handleAgentPullRequestsRequest(
+  paseoHome: string,
+  msg: AgentPullRequestsRequest,
+): Promise<SessionOutboundMessage> {
+  const instance = instances.get(resolve(paseoHome));
+  const { requestId } = msg;
+  if (msg.type === "agent.pull_requests.list.request") {
+    return {
+      type: "agent.pull_requests.list.response",
+      payload: {
+        requestId,
+        agentId: msg.agentId,
+        pullRequests: instance ? await instance.list(msg.agentId) : [],
+      },
+    };
+  }
+  instance?.setPrompts(msg.prompts);
+  return { type: "agent.pull_requests.set_prompts.response", payload: { requestId } };
+}
