+import { describe, expect, test } from "vitest";
+import type { PullRequestTimelineItem } from "../../services/forge-service.js";
+import {
+  MAX_CI_ATTEMPTS,
+  observePullRequest,
+  type ObservePullRequestInput,
+  type ReactionMemory,
+} from "./reactions.js";
+
+type Status = ObservePullRequestInput["status"];
+
+const green: Status = {
+  state: "open",
+  isMerged: false,
+  mergeable: "MERGEABLE",
+  checks: [{ name: "test", status: "success", url: null }],
+  checksStatus: "success",
+  headSha: "sha-1",
+};
+
+function failing(headSha: string): Status {
+  return {
+    ...green,
+    headSha,
+    checks: [{ name: "test", status: "failure", url: null }],
+    checksStatus: "failure",
+  };
+}
+
+function review(id: string, createdAt: number): PullRequestTimelineItem {
+  return {
+    kind: "review",
+    reviewState: "changes_requested",
+    id,
+    author: "reviewer",
+    authorUrl: null,
+    avatarUrl: null,
+    body: "Please fix",
+    createdAt,
+    url: "https://github.com/acme/app/pull/1#review",
+  };
+}
+
+function observe(overrides: Partial<ObservePullRequestInput>) {
+  return observePullRequest({
+    memory: undefined,
+    baseline: true,
+    status: green,
+    reviewItems: [],
+    agentBusy: false,
+    agentTurns: [],
+    ...overrides,
+  });
+}
+
+function seen(status: Status = green, reviewItems: PullRequestTimelineItem[] = []): ReactionMemory {
+  return observe({ status, reviewItems }).memory;
+}
+
+describe("observePullRequest", () => {
+  test("the first look only notes what is there", () => {
+    const result = observe({
+      status: { ...failing("sha-1"), mergeable: "CONFLICTING" },
+      reviewItems: [review("r1", 1_000)],
+    });
+    expect(result.reaction).toBeNull();
+    const again = observe({
+      memory: result.memory,
+      status: { ...failing("sha-1"), mergeable: "CONFLICTING" },
+      reviewItems: [review("r1", 1_000)],
+    });
+    expect(again.reaction).toBeNull();
+  });
+
+  test("a change request found live reacts to checks that already fail", () => {
+    const first = observe({ baseline: false, status: failing("sha-1") });
+    expect(first.reaction).toBeNull();
+    expect(observe({ memory: first.memory, status: failing("sha-1") }).reaction).toBe("fixCi");
+  });
+
+  test("failed checks are answered once per head commit", () => {
+    const first = observe({ memory: seen(), status: failing("sha-2") });
+    expect(first.reaction).toBe("fixCi");
+    expect(observe({ memory: first.memory, status: failing("sha-2") }).reaction).toBeNull();
+    expect(observe({ memory: first.memory, status: failing("sha-3") }).reaction).toBe("fixCi");
+  });
+
+  test("stops sending Fix CI after repeated failures until the checks pass", () => {
+    let memory = seen();
+    for (let attempt = 1; attempt <= MAX_CI_ATTEMPTS; attempt += 1) {
+      const result = observe({ memory, status: failing(`sha-${attempt + 1}`) });
+      expect(result.reaction).toBe("fixCi");
+      memory = result.memory;
+    }
+    const exhausted = observe({ memory, status: failing("sha-9") });
+    expect(exhausted.reaction).toBeNull();
+    const passed = observe({ memory: exhausted.memory, status: { ...green, headSha: "sha-10" } });
+    expect(observe({ memory: passed.memory, status: failing("sha-11") }).reaction).toBe("fixCi");
+  });
+
+  test("failed checks wait for a busy agent", () => {
+    const busy = observe({ memory: seen(), status: failing("sha-2"), agentBusy: true });
+    expect(busy.reaction).toBeNull();
+    expect(observe({ memory: busy.memory, status: failing("sha-2") }).reaction).toBe("fixCi");
+  });
+
+  test("a new conflict is answered once, and again after it was fixed", () => {
+    const conflicting: Status = { ...green, mergeable: "CONFLICTING" };
+    const first = observe({ memory: seen(), status: conflicting });
+    expect(first.reaction).toBe("resolveConflicts");
+    expect(observe({ memory: first.memory, status: conflicting }).reaction).toBeNull();
+    const unknown = observe({ memory: first.memory, status: { ...green, mergeable: "UNKNOWN" } });
+    expect(observe({ memory: unknown.memory, status: conflicting }).reaction).toBeNull();
+    const fixed = observe({ memory: first.memory, status: green });
+    expect(observe({ memory: fixed.memory, status: conflicting }).reaction).toBe(
+      "resolveConflicts",
+    );
+  });
+
+  test("conflicts go first, then the failed checks on the next look", () => {
+    const status: Status = { ...failing("sha-2"), mergeable: "CONFLICTING" };
+    const first = observe({ memory: seen(), status });
+    expect(first.reaction).toBe("resolveConflicts");
+    expect(observe({ memory: first.memory, status }).reaction).toBe("fixCi");
+  });
+
+  test("a new review is answered once", () => {
+    const first = observe({ memory: seen(), reviewItems: [review("r1", 5_000)] });
+    expect(first.reaction).toBe("addressReview");
+    expect(
+      observe({ memory: first.memory, reviewItems: [review("r1", 5_000)] }).reaction,
+    ).toBeNull();
+  });
+
+  test("approvals, bot conversation comments and resolved threads are not reviews to address", () => {
+    const base = {
+      id: "c1",
+      author: "bot",
+      authorUrl: null,
+      avatarUrl: null,
+      body: "Deployed preview",
+      createdAt: 5_000,
+      url: "https://github.com/acme/app/pull/1#c1",
+    };
+    const items: PullRequestTimelineItem[] = [
+      { ...base, kind: "comment" },
+      { ...base, id: "c2", kind: "comment", threadId: "t1", threadIsResolved: true },
+      { ...base, id: "r2", kind: "review", reviewState: "approved", body: "LGTM" },
+    ];
+    expect(observe({ memory: seen(), reviewItems: items }).reaction).toBeNull();
+    const open: PullRequestTimelineItem = { ...base, id: "c3", kind: "comment", threadId: "t2" };
+    expect(observe({ memory: seen(), reviewItems: [open] }).reaction).toBe("addressReview");
+  });
+
+  test("comments posted during the agent's own turn are taken as its replies", () => {
+    const turns = [{ start: 100_000, end: 200_000 }];
+    const own = observe({
+      memory: seen(),
+      reviewItems: [review("r1", 150_000)],
+      agentTurns: turns,
+    });
+    expect(own.reaction).toBeNull();
+    const later = observe({
+      memory: own.memory,
+      reviewItems: [review("r1", 150_000), review("r2", 400_000)],
+      agentTurns: turns,
+    });
+    expect(later.reaction).toBe("addressReview");
+  });
+
+  test("a review from before a busy turn waits for the agent to be idle", () => {
+    const busy = observe({
+      memory: seen(),
+      reviewItems: [review("r1", 50_000)],
+      agentBusy: true,
+      agentTurns: [{ start: 100_000, end: null }],
+    });
+    expect(busy.reaction).toBeNull();
+    const idle = observe({
+      memory: busy.memory,
+      reviewItems: [review("r1", 50_000)],
+      agentTurns: [{ start: 100_000, end: 200_000 }],
+    });
+    expect(idle.reaction).toBe("addressReview");
+  });
+
+  test("an unreadable review timeline changes nothing", () => {
+    const memory = seen(green, [review("r1", 1_000)]);
+    expect(observe({ memory, reviewItems: null }).reaction).toBeNull();
+  });
+
+  test("a merged or closed change request gets no follow-up", () => {
+    const merged: Status = { ...failing("sha-2"), state: "merged", isMerged: true };
+    expect(observe({ memory: seen(), status: merged }).reaction).toBeNull();
+    const closed: Status = { ...failing("sha-2"), state: "closed" };
+    expect(observe({ memory: seen(), status: closed }).reaction).toBeNull();
+  });
+});
