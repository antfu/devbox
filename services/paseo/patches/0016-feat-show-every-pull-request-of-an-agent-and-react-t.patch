+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import pino from "pino";
+import { afterEach, beforeEach, describe, expect, test } from "vitest";
+import type {
+  CurrentPullRequestStatus,
+  PullRequestTimelineItem,
+} from "../../services/forge-service.js";
+import type { AgentManagerEvent, ManagedAgent } from "../agent/agent-manager.js";
+import type { AgentTimelineItem } from "../agent/agent-sdk-types.js";
+import type { StoredAgentRecord } from "../agent/agent-storage.js";
+import { AgentPullRequests, type AgentPullRequestsOptions } from "./index.js";
+
+const REPO = "https://github.com/acme/app";
+
+function record(id: string, overrides: Partial<StoredAgentRecord> = {}): StoredAgentRecord {
+  return {
+    id,
+    provider: "claude",
+    cwd: `/work/${id}`,
+    createdAt: "2026-01-01T00:00:00.000Z",
+    updatedAt: "2026-01-01T00:00:00.000Z",
+    labels: {},
+    metadata: {},
+    lastStatus: "closed",
+    ...overrides,
+  } as StoredAgentRecord;
+}
+
+function status(
+  number: number,
+  overrides: Partial<CurrentPullRequestStatus> = {},
+): CurrentPullRequestStatus {
+  return {
+    number,
+    repoOwner: "acme",
+    repoName: "app",
+    url: `${REPO}/pull/${number}`,
+    title: `PR ${number}`,
+    state: "open",
+    baseRefName: "main",
+    headRefName: `feat-${number}`,
+    headSha: `sha-${number}`,
+    isMerged: false,
+    mergeable: "MERGEABLE",
+    checks: [],
+    checksStatus: "success",
+    reviewDecision: null,
+    ...overrides,
+  };
+}
+
+function failing(number: number): CurrentPullRequestStatus {
+  return status(number, {
+    checks: [{ name: "test", status: "failure", url: null }],
+    checksStatus: "failure",
+  });
+}
+
+function createCommand(url: string): AgentTimelineItem {
+  return {
+    type: "tool_call",
+    callId: "call",
+    name: "Bash",
+    status: "completed",
+    error: null,
+    detail: { type: "shell", command: "gh pr create --fill", output: `${url}\n` },
+  } as AgentTimelineItem;
+}
+
+interface World {
+  records: StoredAgentRecord[];
+  /** The change request of the branch checked out in each directory. */
+  checkouts: Map<string, CurrentPullRequestStatus>;
+  /** Every change request the forge knows, by number. */
+  forge: Map<number, CurrentPullRequestStatus>;
+  reviews: Map<number, PullRequestTimelineItem[]>;
+  live: Map<string, Partial<ManagedAgent>>;
+  sent: Array<{ agentId: string; prompt: string }>;
+  failSend: boolean;
+  emit: (event: AgentManagerEvent) => void;
+}
+
+function createWorld(paseoHome: string): { world: World; service: AgentPullRequests } {
+  const world: World = {
+    records: [],
+    checkouts: new Map(),
+    forge: new Map(),
+    reviews: new Map(),
+    live: new Map(),
+    sent: [],
+    failSend: false,
+    emit: () => undefined,
+  };
+  const forgeService = {
+    getPullRequest: async ({ number }: { number: number }) => {
+      const found = world.forge.get(number);
+      if (!found) throw new Error("not found");
+      return found;
+    },
+    getCurrentPullRequestStatus: async ({ headRef }: { headRef: string }) =>
+      [...world.forge.values()].find((entry) => entry.headRefName === headRef) ?? null,
+    getPullRequestTimeline: async ({ prNumber }: { prNumber: number }) => ({
+      prNumber,
+      repoOwner: "acme",
+      repoName: "app",
+      items: world.reviews.get(prNumber) ?? [],
+      truncated: false,
+      error: null,
+    }),
+  };
+  const options = {
+    paseoHome,
+    agentManager: {
+      subscribe: (callback: (event: AgentManagerEvent) => void) => {
+        world.emit = callback;
+        return () => undefined;
+      },
+      getAgent: (id: string) => (world.live.get(id) as ManagedAgent | undefined) ?? null,
+      getTimeline: () => {
+        throw new Error("not loaded");
+      },
+    },
+    agentStorage: { listAll: async () => world.records },
+    workspaceGitService: {
+      getSnapshot: async (cwd: string) => ({
+        cwd,
+        forge: { forge: "github", pullRequest: world.checkouts.get(cwd) ?? null },
