+import { describe, expect, it } from "vitest";
+import { selectQuickActionPromptPatch } from "./quick-action-prompt-sync";
+
+describe("selectQuickActionPromptPatch", () => {
+  it("sends only the prompts this device changed", () => {
+    expect(selectQuickActionPromptPatch({}, {})).toEqual({});
+    expect(selectQuickActionPromptPatch({ fixCi: "Fix it" }, {})).toEqual({ fixCi: "Fix it" });
+  });
+
+  it("sends nothing for a prompt the host already has", () => {
+    expect(selectQuickActionPromptPatch({ fixCi: "Fix it" }, { fixCi: "Fix it" })).toEqual({});
+  });
+
+  it("sends an empty prompt for one that went back to its default", () => {
+    expect(selectQuickActionPromptPatch({ addressReview: "Reply" }, { fixCi: "Fix it" })).toEqual({
