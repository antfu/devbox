new file mode 100644
index 0000000000000000000000000000000000000000..9ec35fd42d1435e7f64bf1840b702b92f5d0f0ff
--- /dev/null
+++ b/packages/server/src/server/agent-pull-requests/store.ts
@@ -0,0 +1,132 @@
+import { promises as fs } from "node:fs";
+import path from "node:path";
+import { z } from "zod";
+import { writeJsonFileAtomic } from "../atomic-file.js";
+import { isSamePullRequestUrl } from "./links.js";
+import type { PullRequestReaction } from "./reactions.js";
+
+const STORE_FILE = "agent-pull-requests.json";
+
+// A prompt is a few sentences; anything larger is not one.
+const MAX_PROMPT_LENGTH = 20_000;
+
+const StoredLinkSchema = z.object({
+  url: z.string(),
+  /** Where the tool call ran, which is the first place to ask the forge about the link. */
+  cwd: z.string(),
+});
+
+const PromptsSchema = z.object({
+  resolveConflicts: z.string().optional(),
+  fixCi: z.string().optional(),
+  addressReview: z.string().optional(),
+});
+
+const StoredStateSchema = z.object({
+  links: z.record(z.string(), z.array(StoredLinkSchema)).default({}),
+  prompts: PromptsSchema.default({}),
+});
+
+type StoredPullRequestLink = z.infer<typeof StoredLinkSchema>;
+type PullRequestPrompts = z.infer<typeof PromptsSchema>;
+
+/** The prompts sent when no app has saved its own. Keep them equal to the app's `en.ts` defaults. */
+const DEFAULT_PULL_REQUEST_PROMPTS: Record<PullRequestReaction, string> = {
+  resolveConflicts:
+    "The pull request {{url}} has merge conflicts with {{base}}. Fetch the latest {{base}}, merge it into this branch, resolve the conflicts, run the checks, and push.",
+  fixCi:
+    "CI is failing on the pull request {{url}}. Look at the failed checks, fix the cause, run the checks locally, and push the fix.",
+  addressReview:
+    "The pull request {{url}} has new review feedback. Read the unresolved review comments, make the changes they ask for, run the checks, push, and reply to each comment you addressed.",
+};
+
+/** Fills a prompt's `{{url}}` and `{{base}}` placeholders, as the app does for its quick actions. */
+export function fillPullRequestPrompt(
+  template: string,
+  values: { url: string; base: string },
+): string {
+  return template.replace(/\{\{\s*(url|base)\s*\}\}/g, (_match, name: "url" | "base") => {
+    return values[name];
+  });
+}
+
+/**
+ * What the daemon has to remember about agents' change requests across restarts: the links found
+ * in their tool calls (a finished subagent's timeline is not loaded again) and the prompts the app
+ * saved.
+ */
+export class AgentPullRequestStore {
+  private state: z.infer<typeof StoredStateSchema> = { links: {}, prompts: {} };
+  private writes: Promise<unknown> = Promise.resolve();
+  private readonly filePath: string;
+
+  constructor(paseoHome: string) {
+    this.filePath = path.join(paseoHome, STORE_FILE);
+  }
+
+  async load(): Promise<void> {
+    let raw: string;
+    try {
+      raw = await fs.readFile(this.filePath, "utf8");
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === "ENOENT") return;
+      throw error;
+    }
+    this.state = StoredStateSchema.parse(JSON.parse(raw));
+  }
+
+  linksOf(agentId: string): readonly StoredPullRequestLink[] {
+    return this.state.links[agentId] ?? [];
+  }
+
+  /** Returns false when the agent already had the link. */
+  addLink(agentId: string, link: StoredPullRequestLink): boolean {
+    const links = this.state.links[agentId] ?? [];
+    if (links.some((existing) => isSamePullRequestUrl(existing.url, link.url))) return false;
+    this.state.links[agentId] = [...links, link];
+    this.save();
+    return true;
+  }
+
+  removeAgent(agentId: string): void {
+    if (!(agentId in this.state.links)) return;
+    delete this.state.links[agentId];
+    this.save();
+  }
+
+  promptFor(reaction: PullRequestReaction): string {
+    return this.state.prompts[reaction] ?? DEFAULT_PULL_REQUEST_PROMPTS[reaction];
+  }
+
+  /**
+   * Saves the prompts named in the patch and keeps the others, so a device only replaces what it
+   * changed itself. A blank prompt goes back to the default.
+   */
+  setPrompts(patch: PullRequestPrompts): void {
+    const next: PullRequestPrompts = {};
+    for (const reaction of Object.keys(DEFAULT_PULL_REQUEST_PROMPTS) as PullRequestReaction[]) {
+      const prompt = patch[reaction] ?? this.state.prompts[reaction] ?? "";
+      if (prompt.trim().length === 0) continue;
+      if (prompt.length > MAX_PROMPT_LENGTH) throw new Error("The prompt is too long to save.");
+      // The built-in text is not stored, so a later default reaches hosts that never changed it.
+      if (prompt !== DEFAULT_PULL_REQUEST_PROMPTS[reaction]) next[reaction] = prompt;
+    }
+    if (JSON.stringify(next) === JSON.stringify(this.state.prompts)) return;
+    this.state.prompts = next;
+    this.save();
+  }
+
+  /** Resolves once every change so far is on disk. */
+  flush(): Promise<void> {
+    return this.writes.then(() => undefined);
+  }
+
+  private save(): void {
+    const snapshot = structuredClone(this.state);
+    this.writes = this.writes
+      .catch(() => undefined)
+      .then(() => writeJsonFileAtomic(this.filePath, snapshot));
+    // A lost write only costs a link or a prompt until the next change; never crash the daemon.
+    this.writes.catch(() => undefined);
+  }
+}
