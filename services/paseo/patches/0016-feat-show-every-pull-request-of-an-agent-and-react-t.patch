@@ -0,0 +1,110 @@
+import type { AgentPullRequestPayload } from "@getpaseo/protocol/messages";
+import {
+  selectPullRequestQuickActions,
+  type PullRequestQuickAction,
+} from "@/composer/pull-request-actions";
+import { useFetchQuery } from "@/data/query";
+import { selectPrHintFromStatus, type PrHint } from "@/git/pr-hint";
+import { useHostFeature } from "@/runtime/host-features";
+import { useHostRuntimeClient, useHostRuntimeIsConnected } from "@/runtime/host-runtime";
+
+const AGENT_PULL_REQUESTS_REFRESH_MS = 30_000;
+
+/** A change request as the composer shows it. */
+export interface ComposerPullRequest {
+  prHint: PrHint;
+  mergeable: "MERGEABLE" | "CONFLICTING" | "UNKNOWN" | null;
+  baseRefName: string | null;
+}
+
+function urlKey(url: string): string {
+  return url.replace(/\/+$/, "").toLowerCase();
+}
+
+/**
+ * The workspace's own change request first, then the others the host found for the agent and its
+ * subagents. The workspace's copy wins: it arrives by push, the host's list by polling.
+ */
+export function mergeAgentPullRequests(
+  workspace: ComposerPullRequest | null,
+  listed: readonly AgentPullRequestPayload[],
+): ComposerPullRequest[] {
+  const merged = workspace ? [workspace] : [];
+  const seen = new Set(merged.map((entry) => urlKey(entry.prHint.url)));
+  for (const pullRequest of listed) {
+    // A link the host could not read is shown as open: it is a change request the agent created.
+    const state = pullRequest.state === "unknown" ? "open" : pullRequest.state;
+    const prHint = selectPrHintFromStatus({ ...pullRequest, state }, pullRequest.forge);
+    if (!prHint || seen.has(urlKey(prHint.url))) continue;
+    seen.add(urlKey(prHint.url));
+    merged.push({
+      prHint,
+      mergeable: pullRequest.mergeable ?? null,
+      baseRefName: pullRequest.baseRefName || null,
+    });
+  }
+  return merged;
+}
+
+/** A follow-up and the change request it is about; `pullRequest` is null for Create PR. */
+export interface PullRequestQuickActionTarget {
+  action: PullRequestQuickAction;
+  pullRequest: ComposerPullRequest | null;
+}
+
+/**
+ * The follow-ups for every change request the composer shows, in their order. Create PR is about
+ * the workspace alone: it shows for local changes when the workspace's own branch has none.
+ */
+export function selectQuickActionTargets(input: {
+  pullRequests: readonly ComposerPullRequest[];
+  workspaceHasPullRequest: boolean;
+  hasLocalChanges: boolean;
+  isAgentIdle: boolean;
+}): PullRequestQuickActionTarget[] {
+  const targets: PullRequestQuickActionTarget[] = [];
+  for (const pullRequest of input.pullRequests) {
+    const actions = selectPullRequestQuickActions({
+      prHint: pullRequest.prHint,
+      mergeable: pullRequest.mergeable,
+      hasLocalChanges: false,
+      isAgentIdle: input.isAgentIdle,
+    });
+    for (const action of actions) targets.push({ action, pullRequest });
+  }
+  if (!input.workspaceHasPullRequest) {
+    const actions = selectPullRequestQuickActions({
+      prHint: null,
+      mergeable: null,
+      hasLocalChanges: input.hasLocalChanges,
+      isAgentIdle: input.isAgentIdle,
+    });
+    for (const action of actions) targets.push({ action, pullRequest: null });
+  }
+  return targets;
+}
+
+const NONE: readonly AgentPullRequestPayload[] = [];
+
+/** Every change request the agent and its subagents work on; empty on a host that cannot tell. */
+export function useAgentPullRequests(
+  serverId: string,
+  agentId: string,
+): readonly AgentPullRequestPayload[] {
+  const client = useHostRuntimeClient(serverId);
+  const isConnected = useHostRuntimeIsConnected(serverId);
+  const isSupported = useHostFeature(serverId, "agentPullRequests");
+  const query = useFetchQuery({
+    queryKey: ["agentPullRequests", serverId, agentId],
+    dataShape: "value",
+    staleTimeMs: AGENT_PULL_REQUESTS_REFRESH_MS,
+    enabled: Boolean(client && isConnected && isSupported),
+    refetchInterval: AGENT_PULL_REQUESTS_REFRESH_MS,
+    retry: false,
+    queryFn: async () => {
+      if (!client) throw new Error("The host client is unavailable.");
+      return (await client.listAgentPullRequests(agentId)).pullRequests;
+    },
+  });
+  return isConnected ? (query.data ?? NONE) : NONE;
+}
