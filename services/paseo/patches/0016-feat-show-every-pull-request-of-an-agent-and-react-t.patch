index 0000000000000000000000000000000000000000..cbd5beb798d7d8d3969c12b329f9c8bc63521e65
--- /dev/null
+++ b/packages/server/src/server/agent-pull-requests/reactions.ts
@@ -0,0 +1,141 @@
+import type {
+  CurrentPullRequestStatus,
+  PullRequestTimelineItem,
+} from "../../services/forge-service.js";
+
+/** The follow-ups the daemon sends on its own; each one is a quick action of the app. */
+export type PullRequestReaction = "resolveConflicts" | "fixCi" | "addressReview";
+
+/** A span in which the agent ran a turn, in epoch milliseconds; `end` is null while it runs. */
+export interface AgentTurnSpan {
+  start: number;
+  end: number | null;
+}
+
+/** What has been reacted to on one change request, so each event is answered once. */
+export interface ReactionMemory {
+  /** The failing head the agent was last sent to fix. */
+  ciKey: string | null;
+  /** Fix CI prompts sent since the checks last passed. */
+  ciAttempts: number;
+  conflicting: boolean;
+  handledReviewIds: Set<string>;
+}
+
+export interface ObservePullRequestInput {
+  memory: ReactionMemory | undefined;
+  /**
+   * True for a change request that was already there when the daemon first looked. Its failing
+   * checks and conflicts are taken as known, so a restart never replays old events.
+   */
+  baseline: boolean;
+  status: Pick<
+    CurrentPullRequestStatus,
+    "state" | "isMerged" | "mergeable" | "checks" | "checksStatus" | "headSha"
+  >;
+  /** Null when the review timeline could not be read this time. */
+  reviewItems: readonly PullRequestTimelineItem[] | null;
+  agentBusy: boolean;
+  agentTurns: readonly AgentTurnSpan[];
+}
+
+interface ObservePullRequestResult {
+  memory: ReactionMemory;
+  /** At most one: the agent is busy after it, and the rest are looked at again once it is idle. */
+  reaction: PullRequestReaction | null;
+}
+
+/** An agent that cannot get the checks green in this many tries is left for the user. */
+export const MAX_CI_ATTEMPTS = 3;
+
+// Forge and daemon clocks differ a little; a comment this close to a turn is the agent's own.
+const TURN_GRACE_MS = 30_000;
+
+function failingCiKey(status: ObservePullRequestInput["status"]): string | null {
+  const failed = status.checks.filter((check) => check.status === "failure");
+  if (failed.length === 0 && status.checksStatus !== "failure") return null;
+  if (status.headSha) return status.headSha;
+  return failed
+    .map((check) => check.name)
+    .sort()
+    .join("\n");
+}
+
+/**
+ * A review that asks for something: requested changes, a review with a body, or a comment in an
+ * unresolved review thread. Approvals and plain conversation comments (mostly bots) do not count.
+ */
+function isActionableReviewItem(item: PullRequestTimelineItem): boolean {
+  if (item.kind === "review") {
+    if (item.reviewState === "changes_requested") return true;
+    return item.reviewState === "commented" && item.body.trim().length > 0;
+  }
+  const inThread = Boolean(item.reviewId ?? item.threadId ?? item.location);
+  if (!inThread) return false;
+  return item.threadIsResolved !== true && item.location?.isResolved !== true;
+}
+
+function isDuringAgentTurn(createdAt: number, turns: readonly AgentTurnSpan[]): boolean {
+  return turns.some(
+    (turn) =>
+      createdAt >= turn.start - TURN_GRACE_MS &&
+      (turn.end === null || createdAt <= turn.end + TURN_GRACE_MS),
+  );
+}
+
+/**
+ * Compares a change request with what was already reacted to and picks the next follow-up.
+ *
+ * Nothing is sent to a busy agent. Failing checks and conflicts stay pending until it is idle.
+ * Review comments posted while it runs are taken as its own replies: the daemon cannot tell the
+ * agent's forge account from a reviewer's, and answering its own comments would loop.
+ */
+export function observePullRequest(input: ObservePullRequestInput): ObservePullRequestResult {
+  const { status } = input;
+  const actionable = (input.reviewItems ?? []).filter(isActionableReviewItem);
+  const ciKey = failingCiKey(status);
+  const isConflicting = status.mergeable === "CONFLICTING";
+
+  if (!input.memory) {
+    return {
+      memory: {
+        ciKey: input.baseline ? ciKey : null,
+        ciAttempts: 0,
+        conflicting: input.baseline && isConflicting,
+        // Reviews that predate the first look were not written for this agent's latest work.
+        handledReviewIds: new Set(actionable.map((item) => item.id)),
+      },
+      reaction: null,
+    };
+  }
+
+  const memory: ReactionMemory = {
+    ...input.memory,
+    handledReviewIds: new Set(input.memory.handledReviewIds),
+  };
+  for (const item of actionable) {
+    if (isDuringAgentTurn(item.createdAt, input.agentTurns)) memory.handledReviewIds.add(item.id);
+  }
+  if (status.checksStatus === "success") memory.ciAttempts = 0;
+  // GitHub reports UNKNOWN while it recomputes; that is neither a new conflict nor a fix.
+  if (status.mergeable === "MERGEABLE") memory.conflicting = false;
+
+  const isOpen = !status.isMerged && status.state.toLowerCase() === "open";
+  if (!isOpen || input.agentBusy) return { memory, reaction: null };
+
+  if (isConflicting && !memory.conflicting) {
+    memory.conflicting = true;
+    return { memory, reaction: "resolveConflicts" };
+  }
+  if (ciKey !== null && ciKey !== memory.ciKey && memory.ciAttempts < MAX_CI_ATTEMPTS) {
+    memory.ciKey = ciKey;
+    memory.ciAttempts += 1;
+    return { memory, reaction: "fixCi" };
+  }
+  const unhandled = actionable.filter((item) => !memory.handledReviewIds.has(item.id));
+  if (unhandled.length > 0) {
+    for (const item of actionable) memory.handledReviewIds.add(item.id);
+    return { memory, reaction: "addressReview" };
+  }
+  return { memory, reaction: null };
+}
