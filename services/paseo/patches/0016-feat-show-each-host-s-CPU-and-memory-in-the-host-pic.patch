+import { describe, expect, it } from "vitest";
+import { formatHostStats, formatMemory } from "./host-stats-format";
+
+const GIB = 1024 ** 3;
+
+describe("formatMemory", () => {
+  it("shows used and total in gigabytes, one decimal under 10", () => {
+    expect(formatMemory(3.14 * GIB, 16 * GIB)).toBe("3.1/16G");
+    expect(formatMemory(12.6 * GIB, 64 * GIB)).toBe("13/64G");
+  });
+
+  it("switches to megabytes when the total is under a gigabyte", () => {
+    expect(formatMemory(256 * 1024 ** 2, 512 * 1024 ** 2)).toBe("256/512M");
+  });
+});
+
+describe("formatHostStats", () => {
+  it("rounds CPU to a whole percent and shows a dash when it is unknown", () => {
+    const stats = {
+      requestId: "r",
+      source: "cgroup",
+      cpuCount: 4,
+      memoryUsedBytes: GIB,
+      memoryTotalBytes: 8 * GIB,
+    };
+    expect(formatHostStats({ ...stats, cpuPercent: 12.6 })).toEqual({
+      cpu: "13%",
+      memory: "1.0/8.0G",
+    });
+    expect(formatHostStats({ ...stats, cpuPercent: null }).cpu).toBe("–");
+  });
+});
diff --git a/packages/app/src/hosts/host-stats-format.ts b/packages/app/src/hosts/host-stats-format.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bc69084bafb5cba1bebf9f4289fb9e93b245782c
--- /dev/null
+++ b/packages/app/src/hosts/host-stats-format.ts
@@ -0,0 +1,28 @@
+import type { DaemonGetHostStatsResponse } from "@getpaseo/protocol/messages";
+
+export type HostStats = DaemonGetHostStatsResponse["payload"];
+
+export interface HostStatsText {
+  cpu: string;
+  memory: string;
+}
+
+const GIB = 1024 ** 3;
+const MIB = 1024 ** 2;
+
+function formatAmount(value: number): string {
+  return value < 10 ? value.toFixed(1) : Math.round(value).toString();
+}
+
+/** "3.1/16G": used and total in one unit, so the pair reads at a glance. */
+export function formatMemory(usedBytes: number, totalBytes: number): string {
+  const [unit, suffix] = totalBytes >= GIB ? [GIB, "G"] : [MIB, "M"];
+  return `${formatAmount(usedBytes / unit)}/${formatAmount(totalBytes / unit)}${suffix}`;
+}
+
+export function formatHostStats(stats: HostStats): HostStatsText {
+  return {
+    cpu: stats.cpuPercent === null ? "–" : `${Math.round(stats.cpuPercent)}%`,
+    memory: formatMemory(stats.memoryUsedBytes, stats.memoryTotalBytes),
+  };
+}
