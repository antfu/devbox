diff --git a/packages/server/src/server/host-stats.test.ts b/packages/server/src/server/host-stats.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..522c0a21e59be9efb9f8037cc5dd659b2d2be46a
--- /dev/null
+++ b/packages/server/src/server/host-stats.test.ts
@@ -0,0 +1,101 @@
+import { describe, expect, it } from "vitest";
+import {
+  type CpuSample,
+  type HostProbe,
+  createHostStatsReader,
+  cpuPercentBetween,
+  parseCgroupCpuLimit,
+  parseCgroupMemoryLimit,
+  parseCgroupStat,
+} from "./host-stats.js";
+
+describe("cgroup parsers", () => {
+  it("reads the CPU limit from cpu.max", () => {
+    expect(parseCgroupCpuLimit("200000 100000\n")).toBe(2);
+    expect(parseCgroupCpuLimit("max 100000\n")).toBeNull();
+  });
+
+  it("reads one key of a stat file", () => {
+    const stat = "usage_usec 4799405845\nuser_usec 3363499049\n";
+    expect(parseCgroupStat(stat, "usage_usec")).toBe(4799405845);
+    expect(parseCgroupStat(stat, "missing")).toBeNull();
+  });
+
+  it("reads the memory limit from memory.max", () => {
+    expect(parseCgroupMemoryLimit("1073741824\n")).toBe(1073741824);
+    expect(parseCgroupMemoryLimit("max\n")).toBeNull();
+  });
+});
+
+describe("cpuPercentBetween", () => {
+  it("is the busy share of the capacity between two samples, clamped to 0-100", () => {
+    const from = { atMs: 0, usedMicros: 0, capacityMicros: 0 };
+    expect(cpuPercentBetween(from, { atMs: 1, usedMicros: 250, capacityMicros: 1000 })).toBe(25);
+    expect(cpuPercentBetween(from, { atMs: 1, usedMicros: 2000, capacityMicros: 1000 })).toBe(100);
+    expect(cpuPercentBetween(from, from)).toBeNull();
+  });
+});
+
+function scriptedProbe(samples: CpuSample[]): HostProbe {
+  let index = 0;
+  return {
+    source: "cgroup",
+    cpuCount: 2,
+    async readCpu() {
+      const sample = samples[Math.min(index, samples.length - 1)];
+      index += 1;
+      return sample;
+    },
+    async readMemory() {
+      return { usedBytes: 512, totalBytes: 1024 };
+    },
+  };
+}
+
+describe("createHostStatsReader", () => {
+  it("measures over a short window first, then averages since the previous read", async () => {
+    const waits: number[] = [];
+    const read = createHostStatsReader({
+      probe: async () =>
+        scriptedProbe([
+          { atMs: 0, usedMicros: 0, capacityMicros: 0 },
+          { atMs: 250, usedMicros: 100, capacityMicros: 1000 },
+          { atMs: 5000, usedMicros: 600, capacityMicros: 2000 },
+        ]),
+      wait: async (ms) => waits.push(ms),
+      sampleWindowMs: 250,
+    });
+
+    expect(await read()).toEqual({
+      source: "cgroup",
+      cpuPercent: 10,
+      cpuCount: 2,
+      memoryUsedBytes: 512,
+      memoryTotalBytes: 1024,
+    });
+    expect(waits).toEqual([250]);
+
+    expect((await read()).cpuPercent).toBe(50);
+    expect(waits).toEqual([250]);
+  });
+
+  it("measures afresh when the previous read is stale", async () => {
+    const waits: number[] = [];
+    const read = createHostStatsReader({
+      probe: async () =>
+        scriptedProbe([
+          { atMs: 0, usedMicros: 0, capacityMicros: 0 },
+          { atMs: 250, usedMicros: 100, capacityMicros: 1000 },
+          { atMs: 120_000, usedMicros: 900, capacityMicros: 2000 },
+          { atMs: 120_250, usedMicros: 1600, capacityMicros: 3000 },
+        ]),
+      wait: async (ms) => waits.push(ms),
+      sampleWindowMs: 250,
+      maxSampleAgeMs: 60_000,
+    });
+
+    await read();
+    expect((await read()).cpuPercent).toBe(70);
+    expect(waits).toEqual([250, 250]);
+  });
+});
