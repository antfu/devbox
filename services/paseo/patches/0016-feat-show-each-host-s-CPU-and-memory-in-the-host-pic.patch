+import { readFile } from "node:fs/promises";
+import { availableParallelism, cpus, freemem, totalmem } from "node:os";
+import { setTimeout as sleep } from "node:timers/promises";
+
+export interface HostStats {
+  source: "cgroup" | "os";
+  cpuPercent: number | null;
+  cpuCount: number;
+  memoryUsedBytes: number;
+  memoryTotalBytes: number;
+}
+
+/** Cumulative CPU counters: time spent busy, out of the time the available CPUs could have spent. */
+export interface CpuSample {
+  atMs: number;
+  usedMicros: number;
+  capacityMicros: number;
+}
+
+export interface HostProbe {
+  source: HostStats["source"];
+  cpuCount: number;
+  readCpu(): Promise<CpuSample>;
+  readMemory(): Promise<{ usedBytes: number; totalBytes: number }>;
+}
+
+const CGROUP_ROOT = "/sys/fs/cgroup";
+
+/** `cpu.max` holds "<quota> <period>", or "max <period>" without a limit. */
+export function parseCgroupCpuLimit(cpuMax: string): number | null {
+  const [quota, period] = cpuMax.trim().split(/\s+/);
+  const quotaMicros = Number(quota);
+  const periodMicros = Number(period);
+  if (!Number.isFinite(quotaMicros) || !Number.isFinite(periodMicros) || periodMicros <= 0) {
+    return null;
+  }
+  return quotaMicros / periodMicros;
+}
+
+/** Reads one `<key> <value>` line of a cgroup stat file such as `cpu.stat` or `memory.stat`. */
+export function parseCgroupStat(stat: string, key: string): number | null {
+  for (const line of stat.split("\n")) {
+    const [name, value] = line.trim().split(/\s+/);
+    if (name === key) {
+      const parsed = Number(value);
+      return Number.isFinite(parsed) ? parsed : null;
+    }
+  }
+  return null;
+}
+
+/** `memory.max` holds a byte count, or "max" without a limit. */
+export function parseCgroupMemoryLimit(memoryMax: string): number | null {
+  const parsed = Number(memoryMax.trim());
+  return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
+}
+
+export function cpuPercentBetween(from: CpuSample, to: CpuSample): number | null {
+  const capacity = to.capacityMicros - from.capacityMicros;
+  if (capacity <= 0) return null;
+  const percent = ((to.usedMicros - from.usedMicros) / capacity) * 100;
+  return Math.min(100, Math.max(0, percent));
+}
+
+function readCgroupFile(name: string): Promise<string> {
+  return readFile(`${CGROUP_ROOT}/${name}`, "utf8");
+}
+
+// Counts docker's way: page cache the kernel can drop (inactive_file) is not "used".
+async function readCgroupMemory(): Promise<{ usedBytes: number; totalBytes: number }> {
+  const [current, max, stat] = await Promise.all([
+    readCgroupFile("memory.current"),
+    readCgroupFile("memory.max"),
+    readCgroupFile("memory.stat"),
+  ]);
+  const inactiveFile = parseCgroupStat(stat, "inactive_file") ?? 0;
+  return {
+    usedBytes: Math.max(0, Number(current.trim()) - inactiveFile),
+    totalBytes: parseCgroupMemoryLimit(max) ?? totalmem(),
+  };
+}
+
+async function createCgroupProbe(): Promise<HostProbe> {
+  const limit = parseCgroupCpuLimit(await readCgroupFile("cpu.max"));
+  const cpuCount = Math.min(limit ?? Number.POSITIVE_INFINITY, availableParallelism());
+  return {
+    source: "cgroup",
+    cpuCount,
+    async readCpu() {
+      const usedMicros = parseCgroupStat(await readCgroupFile("cpu.stat"), "usage_usec");
+      if (usedMicros === null) throw new Error("cpu.stat has no usage_usec");
+      const atMs = performance.now();
+      return { atMs, usedMicros, capacityMicros: atMs * 1000 * cpuCount };
+    },
+    readMemory: readCgroupMemory,
+  };
+}
+
+function createOsProbe(): HostProbe {
+  return {
+    source: "os",
+    cpuCount: availableParallelism(),
+    async readCpu() {
+      let usedMs = 0;
+      let totalMs = 0;
+      for (const { times } of cpus()) {
+        const busy = times.user + times.nice + times.sys + times.irq;
+        usedMs += busy;
+        totalMs += busy + times.idle;
+      }
+      return { atMs: performance.now(), usedMicros: usedMs * 1000, capacityMicros: totalMs * 1000 };
+    },
+    async readMemory() {
+      const totalBytes = totalmem();
+      return { usedBytes: totalBytes - freemem(), totalBytes };
+    },
+  };
+}
+
+// The cgroup files describe the container only when the daemon sits at the root of its own cgroup
+// namespace ("0::/"). On a bare Linux host the path names a session scope, which is not the machine.
+async function detectHostProbe(): Promise<HostProbe> {
+  try {
+    const cgroup = await readFile("/proc/self/cgroup", "utf8");
+    if (cgroup.trim() === "0::/") {
+      const probe = await createCgroupProbe();
+      await Promise.all([probe.readCpu(), probe.readMemory()]);
+      return probe;
+    }
+  } catch {
+    // No cgroup v2 here (macOS, Windows, cgroup v1): the OS numbers apply.
+  }
+  return createOsProbe();
+}
+
+export interface HostStatsReaderOptions {
+  probe: () => Promise<HostProbe>;
+  wait?: (ms: number) => Promise<unknown>;
+  /** CPU use is the average since the previous read, or over this window when there is none. */
+  sampleWindowMs?: number;
+  /** A previous read older than this is too stale to average over. */
+  maxSampleAgeMs?: number;
+}
+
+export function createHostStatsReader(options: HostStatsReaderOptions): () => Promise<HostStats> {
+  const wait = options.wait ?? sleep;
+  const sampleWindowMs = options.sampleWindowMs ?? 250;
+  const maxSampleAgeMs = options.maxSampleAgeMs ?? 60_000;
+  let probePromise: Promise<HostProbe> | undefined;
+  let lastSample: CpuSample | undefined;
+  let lastPercent: number | null = null;
+
+  async function readCpuPercent(probe: HostProbe): Promise<number | null> {
+    let current = await probe.readCpu();
+    const age = lastSample ? current.atMs - lastSample.atMs : Number.POSITIVE_INFINITY;
+    if (age < sampleWindowMs && lastPercent !== null) return lastPercent;
+    let base = lastSample;
+    if (!base || age > maxSampleAgeMs) {
+      base = current;
+      await wait(sampleWindowMs);
+      current = await probe.readCpu();
+    }
+    lastSample = current;
+    lastPercent = cpuPercentBetween(base, current);
+    return lastPercent;
+  }
+
+  return async () => {
+    probePromise ??= options.probe();
+    const probe = await probePromise;
+    const [cpuPercent, memory] = await Promise.all([readCpuPercent(probe), probe.readMemory()]);
+    return {
+      source: probe.source,
+      cpuPercent,
+      cpuCount: probe.cpuCount,
+      memoryUsedBytes: memory.usedBytes,
+      memoryTotalBytes: memory.totalBytes,
+    };
+  };
+}
+
+export const readHostStats = createHostStatsReader({ probe: detectHostProbe });
