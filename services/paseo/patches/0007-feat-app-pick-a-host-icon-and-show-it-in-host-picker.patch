@@ -0,0 +1,74 @@
+import { describe, expect, it } from "vitest";
+import { defaultHostAppearance } from "@/hosts/appearance";
+import type { HostProfile } from "@/types/host-connection";
+import {
+  adoptHostIcons,
+  HOST_ICONS_STORAGE_KEY,
+  parseStoredHostIcons,
+  setHostIcon,
+} from "./host-icon-store";
+
+function memoryStorage(initial: Record<string, string> = {}) {
+  const items = new Map(Object.entries(initial));
+  return {
+    items,
+    getItem: async (key: string) => items.get(key) ?? null,
+    setItem: async (key: string, value: string) => {
+      items.set(key, value);
+    },
+  };
+}
+
+function profile(serverId: string, icon?: string): HostProfile {
+  return {
+    serverId,
+    appearance: { ...defaultHostAppearance(), ...(icon === undefined ? {} : { icon }) },
+  } as HostProfile;
+}
+
+describe("parseStoredHostIcons", () => {
+  it("keeps known icon names and drops the rest", () => {
+    expect(parseStoredHostIcons(JSON.stringify({ a: "laptop", b: "toaster" }))).toEqual({
+      a: "laptop",
+    });
+    expect(parseStoredHostIcons("not json")).toEqual({});
+    expect(parseStoredHostIcons(null)).toEqual({});
+  });
+});
+
+describe("adoptHostIcons", () => {
+  it("moves icons out of the registry into their own key", async () => {
+    const storage = memoryStorage();
+    const profiles = [profile("a", "cloud"), profile("b")];
+
+    expect(await adoptHostIcons(storage, profiles)).toBe(true);
+
+    expect(profiles[0].appearance).toEqual(defaultHostAppearance());
+    expect(JSON.parse(storage.items.get(HOST_ICONS_STORAGE_KEY) ?? "{}")).toEqual({ a: "cloud" });
+  });
+
+  it("keeps an icon already saved under its own key over a legacy one", async () => {
+    const storage = memoryStorage({ [HOST_ICONS_STORAGE_KEY]: JSON.stringify({ a: "laptop" }) });
+
+    await adoptHostIcons(storage, [profile("a", "cloud")]);
+
+    expect(JSON.parse(storage.items.get(HOST_ICONS_STORAGE_KEY) ?? "{}")).toEqual({ a: "laptop" });
+  });
+
+  it("changes nothing when no profile has a legacy icon", async () => {
+    const storage = memoryStorage();
+    expect(await adoptHostIcons(storage, [profile("a")])).toBe(false);
+    expect(storage.items.has(HOST_ICONS_STORAGE_KEY)).toBe(false);
+  });
+});
+
+describe("setHostIcon", () => {
+  it("saves under the icon key, also on a device with no saved hosts", async () => {
+    const storage = memoryStorage();
+    await adoptHostIcons(storage, []);
+
+    await setHostIcon("a", "laptop");
+
+    expect(JSON.parse(storage.items.get(HOST_ICONS_STORAGE_KEY) ?? "{}")).toEqual({ a: "laptop" });
+  });
+});
diff --git a/packages/app/src/hosts/host-icon-store.ts b/packages/app/src/hosts/host-icon-store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..34e60e3fe727b86f05b27ecc0f10a82a3fa7bf6e
--- /dev/null
+++ b/packages/app/src/hosts/host-icon-store.ts
@@ -0,0 +1,95 @@
+import { create } from "zustand";
+import { z } from "zod";
+import { HOST_ICON_NAMES, type HostIconName } from "@/hosts/host-icons";
+import type { HostProfile } from "@/types/host-connection";
+
+/**
+ * Host icons live under their own storage key, not in the host registry. The registry's schema is
+ * strict and a registry that fails it is deleted whole, so an icon there would cost every saved host
+ * and connection on a build that does not know the field.
+ */
+export const HOST_ICONS_STORAGE_KEY = "@paseo:host-icons";
+
+const StoredHostIconsSchema = z.record(z.string(), z.string());
+
+export interface HostIconStorage {
+  getItem: (key: string) => Promise<string | null>;
+  setItem: (key: string, value: string) => Promise<void>;
+}
+
+interface HostIconState {
+  icons: Readonly<Record<string, HostIconName>>;
+}
+
+const useHostIconStore = create<HostIconState>()(() => ({ icons: {} }));
+
+let storage: HostIconStorage | null = null;
+
+function isHostIconName(value: string): value is HostIconName {
+  return (HOST_ICON_NAMES as readonly string[]).includes(value);
+}
+
+/** Icons the user saved; an entry with a name this build does not know is dropped. */
+export function parseStoredHostIcons(raw: string | null): Record<string, HostIconName> {
+  if (raw === null) return {};
+  let decoded: unknown;
+  try {
+    decoded = JSON.parse(raw);
+  } catch {
+    return {};
+  }
+  const result = StoredHostIconsSchema.safeParse(decoded);
+  if (!result.success) return {};
+  const icons: Record<string, HostIconName> = {};
+  for (const [serverId, icon] of Object.entries(result.data)) {
+    if (isHostIconName(icon)) icons[serverId] = icon;
+  }
+  return icons;
+}
+
+async function saveHostIcons(): Promise<void> {
+  if (!storage) throw new Error("Host icons are not loaded yet.");
+  await storage.setItem(HOST_ICONS_STORAGE_KEY, JSON.stringify(useHostIconStore.getState().icons));
+}
+
+async function readHostIcons(hostStorage: HostIconStorage): Promise<Record<string, HostIconName>> {
+  try {
+    return parseStoredHostIcons(await hostStorage.getItem(HOST_ICONS_STORAGE_KEY));
+  } catch {
+    return {};
+  }
+}
+
+/**
+ * Loads the saved icons when the host registry loads, and moves any icon an older build stored in
+ * a host's appearance into them. Returns whether a profile changed, so the registry is saved
+ * again without the icon. Never throws: an icon problem must not stop the hosts from loading.
+ */
+export async function adoptHostIcons(
+  hostStorage: HostIconStorage,
+  profiles: HostProfile[],
+): Promise<boolean> {
+  storage = hostStorage;
+  const icons = await readHostIcons(hostStorage);
+  let migrated = false;
+  for (const profile of profiles) {
+    // COMPAT(hostIconRegistry): F-9 kept icons in the registry until 2026-11-12, remove after 2027-05-12.
+    const { icon, ...appearance } = profile.appearance;
+    if (icon === undefined) continue;
+    if (!(profile.serverId in icons) && isHostIconName(icon)) icons[profile.serverId] = icon;
+    profile.appearance = appearance;
+    migrated = true;
+  }
+  useHostIconStore.setState({ icons });
+  if (migrated) await saveHostIcons().catch(() => undefined);
+  return migrated;
+}
+
+export function useHostIcon(serverId: string): HostIconName | undefined {
+  return useHostIconStore((state) => state.icons[serverId]);
+}
+
+export async function setHostIcon(serverId: string, icon: HostIconName): Promise<void> {
+  useHostIconStore.setState((state) => ({ icons: { ...state.icons, [serverId]: icon } }));
+  await saveHostIcons();
+}
diff --git a/packages/app/src/hosts/host-icons.ts b/packages/app/src/hosts/host-icons.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8296a5276e2aa73ece40a43f7eb9813989cc60b9
--- /dev/null
+++ b/packages/app/src/hosts/host-icons.ts
@@ -0,0 +1,82 @@
+import {
+  Bot,
+  Box,
+  Briefcase,
+  Building2,
+  Cloud,
+  Cpu,
+  Database,
+  FlaskConical,
+  Gamepad2,
+  HardDrive,
+  House,
+  Laptop,
+  Monitor,
+  Rocket,
+  Server,
+  SquareTerminal,
+  type LucideIcon,
+} from "lucide-react-native";
+import { withUnistyles } from "react-native-unistyles";
+
+/**
+ * The glyphs a host can wear. Order is the picker's order; `server` comes first because it is
+ * what a host shows until the user picks another one.
+ */
+export const HOST_ICON_NAMES = [
+  "server",
+  "laptop",
+  "monitor",
+  "cloud",
+  "cpu",
+  "hard-drive",
+  "terminal",
+  "box",
+  "database",
+  "house",
+  "building",
+  "briefcase",
+  "bot",
+  "rocket",
+  "flask",
+  "gamepad",
+] as const;
+
+export type HostIconName = (typeof HOST_ICON_NAMES)[number];
+
+export const DEFAULT_HOST_ICON: HostIconName = "server";
+
+export const HOST_ICON_COMPONENTS: Record<HostIconName, LucideIcon> = {
+  server: Server,
+  laptop: Laptop,
+  monitor: Monitor,
+  cloud: Cloud,
+  cpu: Cpu,
+  "hard-drive": HardDrive,
+  terminal: SquareTerminal,
+  box: Box,
+  database: Database,
+  house: House,
+  building: Building2,
+  briefcase: Briefcase,
+  bot: Bot,
+  rocket: Rocket,
+  flask: FlaskConical,
+  gamepad: Gamepad2,
+};
+
+// One themed component per glyph for the life of the module, so a badge's `uniProps` mapping
+// subscribes once instead of on every render.
+function themeIcon(icon: LucideIcon) {
+  return withUnistyles(icon);
+}
+
+type ThemedHostIcon = ReturnType<typeof themeIcon>;
+
+const THEMED_HOST_ICONS = Object.fromEntries(
+  HOST_ICON_NAMES.map((name) => [name, themeIcon(HOST_ICON_COMPONENTS[name])]),
+) as Record<HostIconName, ThemedHostIcon>;
+
+export function themedHostIcon(name: HostIconName | undefined): ThemedHostIcon {
+  return THEMED_HOST_ICONS[name ?? DEFAULT_HOST_ICON];
