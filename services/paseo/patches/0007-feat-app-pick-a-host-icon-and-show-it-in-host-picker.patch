+import { useMemo, type ReactElement } from "react";
+import { View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import { HostStatusDot } from "@/components/host-status-dot";
+import { HOST_ICON_MAPPINGS } from "@/hosts/host-badge";
+import { useHostIcon } from "@/hosts/host-icon-store";
+import { themedHostIcon } from "@/hosts/host-icons";
+import { useHostRuntimeConnectionStatus, useHosts } from "@/runtime/host-runtime";
+import { ICON_SIZE } from "@/styles/theme";
+
+/**
+ * A host as host lists draw it: its icon in its color (the server glyph, muted, until the user
+ * picks them). While the host is not connected, its status dot sits on the icon's bottom-right
+ * corner; a connected host shows the icon alone.
+ */
+export function HostIdentityIcon({ serverId }: { serverId: string }): ReactElement {
+  const hosts = useHosts();
+  const status = useHostRuntimeConnectionStatus(serverId);
+  const appearance = useMemo(
+    () => hosts.find((host) => host.serverId === serverId)?.appearance ?? null,
+    [hosts, serverId],
+  );
+
+  const ThemedIcon = themedHostIcon(useHostIcon(serverId));
+  return (
+    <View style={styles.container} testID={`host-identity-icon-${serverId}`}>
+      <ThemedIcon size={ICON_SIZE.sm} uniProps={HOST_ICON_MAPPINGS[appearance?.color ?? "none"]} />
+      {status === "online" ? null : (
+        <View style={styles.status}>
+          <HostStatusDot serverId={serverId} />
+        </View>
+      )}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  container: {
+    width: ICON_SIZE.sm,
+    height: ICON_SIZE.sm,
+  },
+  status: {
+    position: "absolute",
+    right: -3,
+    bottom: -3,
+    transform: [{ scale: 0.75 }],
+  },
+});
