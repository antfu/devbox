index 0000000000000000000000000000000000000000..17914a2d71cfd7a88f2fc5621384db8843218d89
--- /dev/null
+++ b/packages/server/src/server/cors-origins.test.ts
@@ -0,0 +1,37 @@
+import { describe, expect, test } from "vitest";
+
+import { isOriginAllowed } from "./cors-origins.js";
+
+describe("isOriginAllowed", () => {
+  test("accepts exact origins and the any-origin entry", () => {
+    expect(isOriginAllowed("https://app.paseo.sh", new Set(["https://app.paseo.sh"]))).toBe(true);
+    expect(isOriginAllowed("https://evil.example", new Set(["*"]))).toBe(true);
+    expect(isOriginAllowed("https://evil.example", new Set(["https://app.paseo.sh"]))).toBe(false);
+  });
+
+  test("accepts subdomains of a wildcard entry", () => {
+    const allowed = new Set(["https://*.tailnet.ts.net"]);
+    expect(isOriginAllowed("https://paseo.tailnet.ts.net", allowed)).toBe(true);
+    expect(isOriginAllowed("https://a.b.tailnet.ts.net", allowed)).toBe(true);
+    expect(isOriginAllowed("https://PASEO.Tailnet.ts.net", allowed)).toBe(true);
+  });
+
+  test("rejects the bare domain, look-alike domains, other schemes and other ports", () => {
+    const allowed = new Set(["https://*.tailnet.ts.net"]);
+    expect(isOriginAllowed("https://tailnet.ts.net", allowed)).toBe(false);
+    expect(isOriginAllowed("https://eviltailnet.ts.net", allowed)).toBe(false);
+    expect(isOriginAllowed("https://paseo.tailnet.ts.net.evil.example", allowed)).toBe(false);
+    expect(isOriginAllowed("http://paseo.tailnet.ts.net", allowed)).toBe(false);
+    expect(isOriginAllowed("https://paseo.tailnet.ts.net:8443", allowed)).toBe(false);
+  });
+
+  test("matches the port of a wildcard entry", () => {
+    const allowed = new Set(["http://*.example.com:8080"]);
+    expect(isOriginAllowed("http://a.example.com:8080", allowed)).toBe(true);
+    expect(isOriginAllowed("http://a.example.com", allowed)).toBe(false);
+  });
+
+  test("rejects origins that are not URLs", () => {
+    expect(isOriginAllowed("null", new Set(["https://*.example.com"]))).toBe(false);
+  });
+});
diff --git a/packages/server/src/server/cors-origins.ts b/packages/server/src/server/cors-origins.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8f93da8403665acf7c56d690d30503cf9cf1574d
--- /dev/null
+++ b/packages/server/src/server/cors-origins.ts
@@ -0,0 +1,32 @@
+const WILDCARD_SEPARATOR = "://*.";
+
+function matchesWildcardOrigin(origin: URL, pattern: string): boolean {
+  const separator = pattern.indexOf(WILDCARD_SEPARATOR);
+  if (separator === -1) return false;
+  const protocol = `${pattern.slice(0, separator).toLowerCase()}:`;
+  const base = pattern.slice(separator + WILDCARD_SEPARATOR.length).toLowerCase();
+  if (!base) return false;
+  return origin.protocol === protocol && origin.host.endsWith(`.${base}`);
+}
+
+/**
+ * Checks a request's Origin against the CORS allowlist.
+ *
+ * Entries are exact origins (`https://app.paseo.sh`), `*` for any origin, or a subdomain wildcard
+ * (`https://*.example.com`), which matches any subdomain of `example.com` on that scheme and port, but not
+ * `example.com` itself.
+ */
+export function isOriginAllowed(origin: string, allowedOrigins: ReadonlySet<string>): boolean {
+  if (allowedOrigins.has("*") || allowedOrigins.has(origin)) return true;
+
+  let parsed: URL;
+  try {
+    parsed = new URL(origin);
+  } catch {
+    return false;
+  }
+  for (const pattern of allowedOrigins) {
+    if (matchesWildcardOrigin(parsed, pattern)) return true;
+  }
+  return false;
+}
