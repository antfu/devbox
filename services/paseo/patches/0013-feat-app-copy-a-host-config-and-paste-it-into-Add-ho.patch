diff --git a/packages/app/src/hosts/host-config-transfer.test.ts b/packages/app/src/hosts/host-config-transfer.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..50478fe47848c0ea85fd9e83b1263787a0eb3f7f
--- /dev/null
+++ b/packages/app/src/hosts/host-config-transfer.test.ts
@@ -0,0 +1,106 @@
+import { describe, expect, it } from "vitest";
+import type { HostProfile } from "@/types/host-connection";
+import { mergeImportedHosts, parseHostConfig, serializeHostConfig } from "./host-config-transfer";
+
+const NOW = "2026-11-16T00:00:00.000Z";
+
+function host(serverId: string, overrides: Partial<HostProfile> = {}): HostProfile {
+  return {
+    serverId,
+    label: serverId,
+    appearance: { color: "none", badgeDisplay: null },
+    lifecycle: {},
+    connections: [
+      {
+        id: `direct:${serverId}.ts.net:443`,
+        type: "directTcp",
+        endpoint: `${serverId}.ts.net:443`,
+        useTls: true,
+      },
+    ],
+    preferredConnectionId: `direct:${serverId}.ts.net:443`,
+    createdAt: "2026-01-01T00:00:00.000Z",
+    updatedAt: "2026-01-01T00:00:00.000Z",
+    ...overrides,
+  };
+}
+
+describe("host config transfer", () => {
+  it("round-trips connections, password, name, color, badge and icon", () => {
+    const profile = host("srv_a", {
+      label: "Laptop",
+      password: "secret",
+      appearance: { color: "sky", badgeDisplay: "icon" },
+    });
+    const [entry] = parseHostConfig(serializeHostConfig([{ profile, icon: "laptop" }])) ?? [];
+    expect(entry?.icon).toBe("laptop");
+    expect(entry?.profile).toMatchObject({
+      serverId: "srv_a",
+      label: "Laptop",
+      password: "secret",
+      appearance: { color: "sky", badgeDisplay: "icon" },
+      connections: profile.connections,
+      preferredConnectionId: profile.preferredConnectionId,
+    });
+  });
+
+  it("leaves out routed connections and hosts that have nothing else", () => {
+    const routed = host("srv_r", {
+      connections: [{ id: "routed:srv_a", type: "routed", originServerId: "srv_a" }],
+      preferredConnectionId: "routed:srv_a",
+    });
+    const entries = parseHostConfig(
+      serializeHostConfig([{ profile: routed }, { profile: host("srv_a") }]),
+    );
+    expect(entries?.map((entry) => entry.profile.serverId)).toEqual(["srv_a"]);
+  });
+
+  it("is not a host config for pairing links or other JSON", () => {
+    expect(parseHostConfig("https://app.paseo.sh/#offer=abc")).toBeNull();
+    expect(parseHostConfig('{"hosts":[]}')).toBeNull();
+    expect(parseHostConfig("{not json")).toBeNull();
+  });
+
+  it("skips invalid hosts and drops unknown icons", () => {
+    const text = JSON.stringify({
+      format: "paseo-host-config",
+      version: 1,
+      hosts: [
+        { serverId: "" },
+        { ...JSON.parse(serializeHostConfig([{ profile: host("srv_a") }])).hosts[0], icon: "nope" },
+      ],
+    });
+    expect(parseHostConfig(text)).toEqual([
+      { profile: expect.objectContaining({ serverId: "srv_a" }) },
+    ]);
+  });
+
+  it("adds new hosts and updates saved ones, keeping their other connections", () => {
+    const saved = host("srv_a", {
+      connections: [
+        { id: "direct:old:6767", type: "directTcp", endpoint: "old:6767", useTls: false },
+        { id: "routed:srv_b", type: "routed", originServerId: "srv_b" },
+      ],
+      preferredConnectionId: "direct:old:6767",
+    });
+    const imported = host("srv_a", {
+      label: "Renamed",
+      appearance: { color: "red", badgeDisplay: null },
+    });
+    const next = mergeImportedHosts([saved], [imported, host("srv_b")], NOW);
+    expect(next.map((profile) => profile.serverId)).toEqual(["srv_a", "srv_b"]);
+    expect(next[0]).toMatchObject({
+      label: "Renamed",
+      appearance: { color: "red" },
+      preferredConnectionId: imported.preferredConnectionId,
+      createdAt: saved.createdAt,
+      updatedAt: NOW,
+    });
+    expect(next[0]?.connections.map((connection) => connection.id)).toEqual([
+      imported.connections[0]?.id,
+      "direct:old:6767",
+      "routed:srv_b",
+    ]);
+    expect(next[1]?.createdAt).toBe(NOW);
+  });
+});
diff --git a/packages/app/src/hosts/host-config-transfer.ts b/packages/app/src/hosts/host-config-transfer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0ac927d0d936fb34360ae6050f2d0932a64c316d
--- /dev/null
+++ b/packages/app/src/hosts/host-config-transfer.ts
@@ -0,0 +1,103 @@
+import { HOST_ICON_NAMES, type HostIconName } from "@/hosts/host-icons";
+import { type HostProfile, normalizeStoredHostProfile } from "@/types/host-connection";
+
+/**
+ * A host config is the text "Copy host config" puts on the clipboard: every saved host's connections,
+ * password, name and appearance, so another device can add the same hosts by pasting it. Routed
+ * connections are left out, because the daemon that routes them re-registers them by itself.
+ */
+const HOST_CONFIG_FORMAT = "paseo-host-config";
+const HOST_CONFIG_VERSION = 1;
+
+export interface HostConfigEntry {
+  profile: HostProfile;
+  icon?: HostIconName;
+}
+
+function isHostIconName(value: unknown): value is HostIconName {
+  return typeof value === "string" && (HOST_ICON_NAMES as readonly string[]).includes(value);
+}
+
+/** The host as a host config stores it, or null when it has nothing but routed connections. */
+function toStoredHost({ profile, icon }: HostConfigEntry): Record<string, unknown> | null {
+  const connections = profile.connections.filter((connection) => connection.type !== "routed");
+  if (connections.length === 0) return null;
+  const preferredConnectionId = connections.some(
+    (connection) => connection.id === profile.preferredConnectionId,
+  )
+    ? profile.preferredConnectionId
+    : (connections[0]?.id ?? null);
+  return {
+    serverId: profile.serverId,
+    label: profile.label,
+    ...(profile.password ? { password: profile.password } : {}),
+    appearance: { color: profile.appearance.color, badgeDisplay: profile.appearance.badgeDisplay },
+    connections,
+    preferredConnectionId,
+    ...(icon ? { icon } : {}),
+  };
+}
+
+export function serializeHostConfig(entries: readonly HostConfigEntry[]): string {
+  const hosts = entries.flatMap((entry) => toStoredHost(entry) ?? []);
+  return JSON.stringify({ format: HOST_CONFIG_FORMAT, version: HOST_CONFIG_VERSION, hosts });
+}
+
+/**
+ * The hosts in a pasted host config, or null when the text is not one (a pairing link, say). A host
+ * that fails validation is skipped; an unknown icon is dropped.
+ */
+export function parseHostConfig(text: string): HostConfigEntry[] | null {
+  const trimmed = text.trim();
+  if (!trimmed.startsWith("{")) return null;
+  let decoded: unknown;
+  try {
+    decoded = JSON.parse(trimmed);
+  } catch {
+    return null;
+  }
+  if (typeof decoded !== "object" || decoded === null) return null;
+  const record = decoded as Record<string, unknown>;
+  if (record.format !== HOST_CONFIG_FORMAT || !Array.isArray(record.hosts)) return null;
+  return record.hosts.flatMap((host: unknown) => {
+    if (typeof host !== "object" || host === null) return [];
+    const { icon, ...stored } = host as Record<string, unknown>;
+    const profile = normalizeStoredHostProfile(stored);
+    if (!profile) return [];
+    return [isHostIconName(icon) ? { profile, icon } : { profile }];
+  });
+}
+
+/**
+ * Adds the imported hosts to the registry. A host already saved here takes the imported name,
+ * appearance, password and preferred connection, and keeps its other connections.
+ */
+export function mergeImportedHosts(
+  existing: readonly HostProfile[],
+  imported: readonly HostProfile[],
+  now: string,
+): HostProfile[] {
+  const next = existing.slice();
+  for (const profile of imported) {
+    const index = next.findIndex((host) => host.serverId === profile.serverId);
+    const previous = index === -1 ? undefined : next[index];
+    if (!previous) {
+      next.push({ ...profile, createdAt: now, updatedAt: now });
+      continue;
+    }
+    const importedIds = new Set(profile.connections.map((connection) => connection.id));
+    next[index] = {
+      ...previous,
+      ...(profile.password ? { password: profile.password } : {}),
+      label: profile.label,
+      appearance: profile.appearance,
+      connections: [
+        ...profile.connections,
+        ...previous.connections.filter((connection) => !importedIds.has(connection.id)),
+      ],
+      preferredConnectionId: profile.preferredConnectionId,
+      updatedAt: now,
+    };
+  }
+  return next;
+}
