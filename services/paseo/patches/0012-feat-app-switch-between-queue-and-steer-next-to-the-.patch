--- /dev/null
+++ b/packages/app/src/composer/send-behavior-switch-model.ts
@@ -0,0 +1,6 @@
+import type { SendBehavior } from "@/hooks/use-settings/storage";
+
+/** The composer switch flips between queue and steer; interrupt is only set from Settings. */
+export function nextSendBehavior(current: SendBehavior): SendBehavior {
+  return current === "queue" ? "steer" : "queue";
+}
diff --git a/packages/app/src/composer/send-behavior-switch.test.ts b/packages/app/src/composer/send-behavior-switch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..01d52854ad4bbd9e4776852cf8f3fd9893179978
--- /dev/null
+++ b/packages/app/src/composer/send-behavior-switch.test.ts
@@ -0,0 +1,13 @@
+import { describe, expect, it } from "vitest";
+import { nextSendBehavior } from "./send-behavior-switch-model";
+
+describe("nextSendBehavior", () => {
+  it("switches queue to steer", () => {
+    expect(nextSendBehavior("queue")).toBe("steer");
+  });
+
+  it("switches steer and interrupt to queue", () => {
+    expect(nextSendBehavior("steer")).toBe("queue");
+    expect(nextSendBehavior("interrupt")).toBe("queue");
+  });
+});
diff --git a/packages/app/src/composer/send-behavior-switch.tsx b/packages/app/src/composer/send-behavior-switch.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..6445e298bcfb5fdc66af611bef20baca39944fe4
--- /dev/null
+++ b/packages/app/src/composer/send-behavior-switch.tsx
@@ -0,0 +1,110 @@
+import { useCallback } from "react";
+import { Text, View, type PressableStateCallbackType } from "react-native";
+import { useTranslation } from "react-i18next";
+import { StyleSheet, withUnistyles } from "react-native-unistyles";
+import { ListEnd, Navigation, Zap } from "lucide-react-native";
+import { Tooltip, TooltipContent, TooltipTrigger } from "@/components/ui/tooltip";
+import { useAppSettings } from "@/hooks/use-settings";
+import { nextSendBehavior } from "./send-behavior-switch-model";
+import { useKeyboardShortcutsAvailable } from "@/keyboard/availability";
+import { getShortcutOs } from "@/utils/shortcut-platform";
+import type { Theme } from "@/styles/theme";
+
+const ThemedListEnd = withUnistyles(ListEnd);
+const ThemedNavigation = withUnistyles(Navigation);
+const ThemedZap = withUnistyles(Zap);
+const ICONS = { queue: ThemedListEnd, steer: ThemedNavigation, interrupt: ThemedZap } as const;
+const foreground = (theme: Theme) => ({ color: theme.colors.foreground });
+const foregroundMuted = (theme: Theme) => ({ color: theme.colors.foregroundMuted });
+
+/** Shows the default send behavior next to the send button and switches it between queue and steer. */
+export function SendBehaviorSwitch({
+  iconSize,
+  disabled,
+}: {
+  iconSize: number;
+  disabled: boolean;
+}) {
+  const { t } = useTranslation();
+  const { settings, updateSettings } = useAppSettings();
+  const shortcutsAvailable = useKeyboardShortcutsAvailable();
+  const modifier = getShortcutOs() === "mac" ? "⌘" : "Ctrl";
+  const behavior = settings.sendBehavior;
+  const toggle = useCallback(
+    () => void updateSettings({ sendBehavior: nextSendBehavior(behavior) }),
+    [behavior, updateSettings],
+  );
+  const triggerStyle = useCallback(
+    ({ hovered }: PressableStateCallbackType & { hovered?: boolean }) => [
+      styles.button,
+      hovered ? styles.buttonHovered : undefined,
+      disabled ? styles.buttonDisabled : undefined,
+    ],
+    [disabled],
+  );
+  const Icon = ICONS[behavior];
+  const renderContent = useCallback(
+    ({ hovered }: PressableStateCallbackType & { hovered?: boolean }) => (
+      <Icon size={iconSize} uniProps={hovered ? foreground : foregroundMuted} />
+    ),
+    [Icon, iconSize],
+  );
+  const label = `${t("settings.general.defaultSend.label")}: ${t(
+    `settings.general.defaultSend.options.${behavior}`,
+  )}`;
+  const description = t(
+    shortcutsAvailable && settings.sendShortcut === "mod-enter"
+      ? `settings.general.defaultSend.commandEnterDescriptions.${behavior}`
+      : `settings.general.defaultSend.descriptions.${behavior}`,
+    { modifier },
+  );
+  return (
+    <Tooltip delayDuration={0} enabledOnDesktop enabledOnMobile={false}>
+      <TooltipTrigger
+        onPress={toggle}
+        disabled={disabled}
+        accessibilityLabel={label}
+        accessibilityRole="button"
+        testID="composer-send-behavior-switch"
+        style={triggerStyle}
+      >
+        {renderContent}
+      </TooltipTrigger>
+      <TooltipContent side="top" align="center" offset={8}>
+        <View style={styles.tooltip}>
+          <Text style={styles.tooltipTitle}>{label}</Text>
+          <Text style={styles.tooltipText}>{description}</Text>
+        </View>
+      </TooltipContent>
+    </Tooltip>
+  );
+}
+
+const styles = StyleSheet.create((theme: Theme) => ({
+  button: {
+    width: 28,
+    height: 28,
+    borderRadius: theme.borderRadius.full,
+    alignItems: "center",
+    justifyContent: "center",
+  },
+  buttonHovered: {
+    backgroundColor: theme.colors.surface2,
+  },
+  buttonDisabled: {
+    opacity: 0.5,
+  },
+  tooltip: {
+    maxWidth: 260,
+    gap: theme.spacing[1],
+  },
+  tooltipTitle: {
+    fontSize: theme.fontSize.base,
+    fontWeight: theme.fontWeight.medium,
+    color: theme.colors.popoverForeground,
+  },
+  tooltipText: {
+    fontSize: theme.fontSize.sm,
+    color: theme.colors.popoverForeground,
+  },
+}));
