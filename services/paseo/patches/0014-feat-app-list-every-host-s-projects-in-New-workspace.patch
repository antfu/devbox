+/**
+ * The host to move to when `project` is picked: null while the selected host can create a
+ * workspace for it, else the first of the project's hosts that can.
+ */
+export function resolveHostForPickedProject(input: {
+  project: HostProjectListItem;
+  selectedServerId: string;
+  allowAllProjects: boolean;
+}): string | null {
+  const canCreateOn = (serverId: string) =>
+    canCreateWorkspaceForHostProject({
+      project: input.project,
+      serverId,
+      allowAllProjects: input.allowAllProjects,
+    });
+  if (canCreateOn(input.selectedServerId)) return null;
+  return input.project.hosts.find((host) => canCreateOn(host.serverId))?.serverId ?? null;
+}
