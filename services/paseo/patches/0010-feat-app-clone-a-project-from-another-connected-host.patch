+import { describe, expect, it } from "vitest";
+import type { ProjectDescriptor, WorkspaceDescriptor } from "@/stores/session-store";
+import { buildOtherHostProjectChoices } from "./other-host-projects";
+
+function project(input: Partial<ProjectDescriptor> & { projectId: string }): ProjectDescriptor {
+  return {
+    projectKey: null,
+    projectDisplayName: input.projectId,
+    projectCustomName: null,
+    projectRootPath: `/repos/${input.projectId}`,
+    projectKind: "git",
+    ...input,
+  };
+}
+
+function workspace(projectId: string, remoteUrl: string | null): WorkspaceDescriptor {
+  return {
+    createdAt: null,
+    lastUserMessageAt: null,
+    id: `${projectId}-main`,
+    projectId,
+    projectDisplayName: projectId,
+    projectRootPath: `/repos/${projectId}`,
+    workspaceDirectory: `/repos/${projectId}`,
+    projectKind: "git",
+    workspaceKind: "local_checkout",
+    name: "main",
+    status: "done",
+    statusEnteredAt: null,
+    archivingAt: null,
+    diffStat: null,
+    scripts: [],
+    gitRuntime: { remoteUrl },
+  };
+}
+
+describe("buildOtherHostProjectChoices", () => {
+  it("lists the other hosts' git projects with their workspace remote", () => {
+    const choices = buildOtherHostProjectChoices({
+      targetHostId: "here",
+      query: "",
+      hosts: [
+        { serverId: "here", label: "Here", projects: [], workspaces: [] },
+        {
+          serverId: "there",
+          label: "There",
+          projects: [project({ projectId: "app" })],
+          workspaces: [workspace("app", "git@github.com:acme/app.git")],
+        },
+      ],
+    });
+    expect(choices).toHaveLength(1);
+    expect(choices[0]).toMatchObject({
+      serverId: "there",
+      projectName: "app",
+      hostLabel: "There",
+      remoteUrl: "git@github.com:acme/app.git",
+      repository: { cloneUrl: "git@github.com:acme/app.git" },
+    });
+  });
+
+  it("falls back to the remote project key and skips projects without a remote", () => {
+    const choices = buildOtherHostProjectChoices({
+      targetHostId: "here",
+      query: "",
+      hosts: [
+        {
+          serverId: "there",
+          label: "There",
+          projects: [
+            project({ projectId: "lib", projectKey: "remote:github.com/acme/lib#subdir:pkg" }),
+            project({ projectId: "scratch" }),
+            project({ projectId: "notes", projectKind: "directory" }),
+          ],
+          workspaces: [],
+        },
+      ],
+    });
+    expect(choices.map((choice) => choice.remoteUrl)).toEqual(["https://github.com/acme/lib.git"]);
+  });
+
+  it("leaves out projects the target host already has and filters by the query", () => {
+    const shared = project({ projectId: "app", projectKey: "remote:github.com/acme/app" });
+    const hosts = [
+      { serverId: "here", label: "Here", projects: [shared], workspaces: [] },
+      {
+        serverId: "there",
+        label: "There",
+        projects: [
+          shared,
+          project({ projectId: "site", projectKey: "remote:github.com/acme/site" }),
+        ],
+        workspaces: [],
+      },
+    ];
+    expect(
+      buildOtherHostProjectChoices({ targetHostId: "here", query: "", hosts }).map(
+        (choice) => choice.projectName,
+      ),
+    ).toEqual(["site"]);
+    expect(buildOtherHostProjectChoices({ targetHostId: "here", query: "zzz", hosts })).toEqual([]);
+  });
+});
