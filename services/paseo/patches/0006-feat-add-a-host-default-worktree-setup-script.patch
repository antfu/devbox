@@ -0,0 +1,162 @@
+import { useCallback, useMemo, useState } from "react";
+import { Text, View } from "react-native";
+import { useMutation } from "@tanstack/react-query";
+import { useTranslation } from "react-i18next";
+import { StyleSheet } from "react-native-unistyles";
+import { AdaptiveModalSheet, type SheetHeader } from "@/components/adaptive-modal-sheet";
+import { SettingsTextAreaCard } from "@/components/settings-textarea";
+import { Button } from "@/components/ui/button";
+import { useDaemonConfig } from "@/hooks/use-daemon-config";
+import { useHostFeature } from "@/runtime/host-features";
+import { useHostRuntimeIsConnected } from "@/runtime/host-runtime";
+import { settingsStyles } from "@/styles/settings";
+
+function parseSetupCommands(text: string): string[] {
+  return text
+    .split("\n")
+    .map((line) => line.trim())
+    .filter((line) => line.length > 0);
+}
+
+function useHostDefaultSetup(serverId: string) {
+  const isSupported = useHostFeature(serverId, "worktreeDefaultSetup");
+  const { config, patchConfig } = useDaemonConfig(serverId);
+  const commands = config?.worktreeDefaultSetup ?? [];
+  return { isSupported, config, commands, patchConfig };
+}
+
+// Host-wide setup commands for new worktrees of projects whose paseo.json
+// leaves worktree.setup out.
+export function WorktreeDefaultSetupCard({ serverId }: { serverId: string }) {
+  const { t } = useTranslation();
+  const isConnected = useHostRuntimeIsConnected(serverId);
+  const { isSupported, config, commands, patchConfig } = useHostDefaultSetup(serverId);
+  const persistedText = commands.join("\n");
+  const [draft, setDraft] = useState(persistedText);
+  const [isEditing, setIsEditing] = useState(false);
+  const header = useMemo<SheetHeader>(
+    () => ({ title: t("settings.host.workspaces.defaultSetup.title") }),
+    [t],
+  );
+  const mutation = useMutation({
+    mutationFn: async (text: string) => {
+      const next = parseSetupCommands(text);
+      const result = await patchConfig({ worktreeDefaultSetup: next.length > 0 ? next : null });
+      if (!result) {
+        throw new Error(t("workspace.terminal.hostDisconnected"));
+      }
+      return result;
+    },
+    onSuccess: () => setIsEditing(false),
+  });
+
+  const handleOpen = useCallback(() => {
+    mutation.reset();
+    setDraft(persistedText);
+    setIsEditing(true);
+  }, [mutation, persistedText]);
+  const handleClose = useCallback(() => {
+    if (mutation.isPending) return;
+    setIsEditing(false);
+  }, [mutation.isPending]);
+  const handleSave = useCallback(() => mutation.mutate(draft), [draft, mutation]);
+
+  if (!isConnected || !isSupported || !config) return null;
+
+  return (
+    <>
+      <View style={settingsStyles.card} testID="host-page-worktree-default-setup-card">
+        <View style={settingsStyles.row}>
+          <View style={settingsStyles.rowContent}>
+            <Text style={settingsStyles.rowTitle}>
+              {t("settings.host.workspaces.defaultSetup.title")}
+            </Text>
+            <Text style={settingsStyles.rowHint}>
+              {t("settings.host.workspaces.defaultSetup.hint")}
+            </Text>
+          </View>
+          <Button
+            variant="outline"
+            size="sm"
+            onPress={handleOpen}
+            testID="host-page-worktree-default-setup-edit"
+          >
+            {t("settings.host.workspaces.defaultSetup.edit")}
+          </Button>
+        </View>
+      </View>
+
+      {isEditing ? (
+        <AdaptiveModalSheet
+          header={header}
+          visible
+          onClose={handleClose}
+          testID="host-page-worktree-default-setup-sheet"
+          desktopMaxWidth={560}
+        >
+          <SettingsTextAreaCard
+            testID="host-page-worktree-default-setup-input"
+            accessibilityLabel={t("settings.host.workspaces.defaultSetup.accessibilityLabel")}
+            value={draft}
+            onChangeText={setDraft}
+            placeholder="npm install"
+          />
+          <Text style={settingsStyles.rowHint}>
+            {t("settings.host.workspaces.defaultSetup.inputHint")}
+          </Text>
+          {mutation.error ? (
+            <Text style={settingsStyles.rowError} testID="host-page-worktree-default-setup-error">
+              {mutation.error.message}
+            </Text>
+          ) : null}
+          <View style={styles.actions}>
+            <Button
+              variant="default"
+              size="sm"
+              onPress={handleSave}
+              disabled={draft === persistedText || mutation.isPending}
+              testID="host-page-worktree-default-setup-save"
+            >
+              {mutation.isPending
+                ? t("settings.host.workspaces.defaultSetup.saving")
+                : t("settings.host.workspaces.defaultSetup.save")}
+            </Button>
+          </View>
+        </AdaptiveModalSheet>
+      ) : null}
+    </>
+  );
+}
+
+// Shown under a project's empty setup field: once saved empty, the project
+// leaves worktree.setup out and the host default runs instead.
+export function WorktreeDefaultSetupHint({
+  serverId,
+  projectSetupText,
+}: {
+  serverId: string;
+  projectSetupText: string;
+}) {
+  const { t } = useTranslation();
+  const { isSupported, commands } = useHostDefaultSetup(serverId);
+  if (!isSupported || commands.length === 0 || projectSetupText.trim().length > 0) return null;
+  return (
+    <Text style={styles.projectHint} testID="worktree-setup-host-default-hint">
+      {t("settings.host.workspaces.defaultSetup.projectHint")}
+    </Text>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  actions: {
+    flexDirection: "row",
+    justifyContent: "flex-end",
+    gap: theme.spacing[2],
+    marginTop: theme.spacing[3],
+  },
+  projectHint: {
+    color: theme.colors.foregroundMuted,
+    fontSize: theme.fontSize.sm,
+    marginTop: theme.spacing[2],
+  },
+}));
