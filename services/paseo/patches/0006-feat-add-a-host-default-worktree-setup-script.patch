diff --git a/packages/server/src/utils/worktree-default-setup.test.ts b/packages/server/src/utils/worktree-default-setup.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..48fbfa05179fe9a014749c29bbf70d67d9171cd4
--- /dev/null
+++ b/packages/server/src/utils/worktree-default-setup.test.ts
@@ -0,0 +1,95 @@
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, test } from "vitest";
+
+import { getWorktreeSetupCommands } from "./worktree.js";
+import { attachWorktreeDefaultSetup, mergeWorktreeDefaultSetup } from "./worktree-default-setup.js";
+
+const tempDirs: string[] = [];
+let detach: (() => void) | null = null;
+
+function useHostDefaultSetup(worktreeDefaultSetup: string[] | null | undefined): void {
+  detach?.();
+  detach = attachWorktreeDefaultSetup({
+    get: () => ({ worktreeDefaultSetup }),
+    onFieldChange: () => () => {},
+  });
+}
+
+function createProject(paseoConfig?: unknown): string {
+  const repoRoot = mkdtempSync(path.join(tmpdir(), "paseo-worktree-default-setup-"));
+  tempDirs.push(repoRoot);
+  if (paseoConfig !== undefined) {
+    writeFileSync(path.join(repoRoot, "paseo.json"), JSON.stringify(paseoConfig));
+  }
+  return repoRoot;
+}
+
+afterEach(() => {
+  useHostDefaultSetup(undefined);
+  for (const dir of tempDirs.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+
+describe("host default worktree setup", () => {
+  test("runs for a project without paseo.json", async () => {
+    useHostDefaultSetup(["npm ci", "  "]);
+    expect(await getWorktreeSetupCommands(createProject())).toEqual(["npm ci"]);
+  });
+
+  test("runs for a paseo.json that leaves worktree.setup out", async () => {
+    useHostDefaultSetup(["npm ci"]);
+    const repoRoot = createProject({ worktree: { teardown: "make clean" }, scripts: {} });
+    expect(await getWorktreeSetupCommands(repoRoot)).toEqual(["npm ci"]);
+  });
+
+  test("does not replace a project's empty setup", async () => {
+    useHostDefaultSetup(["npm ci"]);
+    expect(await getWorktreeSetupCommands(createProject({ worktree: { setup: [] } }))).toEqual([]);
+  });
+
+  test("does not replace a project's own setup", async () => {
+    useHostDefaultSetup(["npm ci"]);
+    const repoRoot = createProject({ worktree: { setup: "pnpm install" } });
+    expect(await getWorktreeSetupCommands(repoRoot)).toEqual(["pnpm install"]);
+  });
+
+  test("leaves projects without setup alone when the host has no default", async () => {
+    useHostDefaultSetup(null);
+    expect(await getWorktreeSetupCommands(createProject({}))).toEqual([]);
+  });
+
+  test("follows live config changes", async () => {
+    let worktreeDefaultSetup: string[] | null = ["npm ci"];
+    let notify = () => {};
+    detach = attachWorktreeDefaultSetup({
+      get: () => ({ worktreeDefaultSetup }),
+      onFieldChange: (_path, handler) => {
+        notify = handler;
+        return () => {};
+      },
+    });
+    const repoRoot = createProject();
+    expect(await getWorktreeSetupCommands(repoRoot)).toEqual(["npm ci"]);
+
+    worktreeDefaultSetup = null;
+    notify();
+    expect(await getWorktreeSetupCommands(repoRoot)).toEqual([]);
+  });
+});
+
+describe("mergeWorktreeDefaultSetup", () => {
+  test("keeps the other worktree settings", () => {
+    expect(mergeWorktreeDefaultSetup({ root: "~/wt" }, ["npm ci"])).toEqual({
+      root: "~/wt",
+      defaultSetup: ["npm ci"],
+    });
+    expect(mergeWorktreeDefaultSetup({ root: "~/wt", defaultSetup: ["npm ci"] }, null)).toEqual({
+      root: "~/wt",
+    });
+  });
+
+  test("drops the worktrees object once nothing is left", () => {
+    expect(mergeWorktreeDefaultSetup({ defaultSetup: ["npm ci"] }, null)).toBeUndefined();
+  });
+});
diff --git a/packages/server/src/utils/worktree-default-setup.ts b/packages/server/src/utils/worktree-default-setup.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cb239e39bcfcf737c3094f1b14c8a2a5be918e66
--- /dev/null
+++ b/packages/server/src/utils/worktree-default-setup.ts
@@ -0,0 +1,46 @@
+import type { MutableDaemonConfig } from "@getpaseo/protocol/messages";
+import { normalizeLifecycleCommands } from "@getpaseo/protocol/paseo-config-schema";
+import type { PersistedConfig } from "../server/persisted-config.js";
+import { readPaseoConfigForEdit } from "./paseo-config-file.js";
+
+type PersistedWorktreesConfig = PersistedConfig["worktrees"];
+
+interface WorktreeDefaultSetupSource {
+  get(): Pick<MutableDaemonConfig, "worktreeDefaultSetup">;
+  onFieldChange(path: string, handler: () => void): () => void;
+}
+
+// Host-wide like the git process policy: setup commands are resolved deep inside
+// worktree creation, far from the daemon config store.
+let hostDefaultSetup: string[] = [];
+
+export function attachWorktreeDefaultSetup(source: WorktreeDefaultSetupSource): () => void {
+  const apply = () => {
+    hostDefaultSetup = normalizeLifecycleCommands(source.get().worktreeDefaultSetup ?? []);
+  };
+  apply();
+  return source.onFieldChange("worktreeDefaultSetup", apply);
+}
+
+// The host default runs only for projects that leave `worktree.setup` out of
+// paseo.json. The normalized config turns an absent and an empty setup into the
+// same [], so the raw config decides; a project that declares any setup, even
+// an empty or unreadable one, keeps its own.
+export async function resolveWorktreeSetupCommands(
+  repoRoot: string,
+  projectSetup: string[],
+): Promise<string[]> {
+  if (projectSetup.length > 0 || hostDefaultSetup.length === 0) return projectSetup;
+  const raw = await readPaseoConfigForEdit(repoRoot);
+  const declaresSetup = !raw.ok || raw.config?.worktree?.setup !== undefined;
+  return declaresSetup ? projectSetup : [...hostDefaultSetup];
+}
+
+export function mergeWorktreeDefaultSetup(
+  worktrees: PersistedWorktreesConfig,
+  defaultSetup: string[] | null,
+): PersistedWorktreesConfig {
+  const { defaultSetup: _previous, ...rest } = worktrees ?? {};
+  const next = defaultSetup === null ? rest : { ...rest, defaultSetup };
+  return Object.keys(next).length > 0 ? next : undefined;
+}
