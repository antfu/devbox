@@ -0,0 +1,138 @@
+import { useMemo } from "react";
+import { useStoreWithEqualityFn } from "zustand/traditional";
+import {
+  useSessionStore,
+  type ProjectDescriptor,
+  type WorkspaceDescriptor,
+} from "@/stores/session-store";
+import type { AddProjectHost, GithubRepositoryChoice } from "./model";
+import { buildManualGithubRepositoryChoices } from "./options";
+
+export interface OtherHostProjectChoice {
+  id: string;
+  serverId: string;
+  projectName: string;
+  hostLabel: string;
+  remoteUrl: string;
+  repository: GithubRepositoryChoice;
+}
+
+interface HostProjects {
+  serverId: string;
+  label: string;
+  projects: readonly ProjectDescriptor[];
+  workspaces: readonly WorkspaceDescriptor[];
+}
+
+/**
+ * The git projects on the other connected hosts, as clone choices for `targetHostId`. A project's
+ * remote comes from one of its workspaces, or else from its `remote:` project key. Projects with
+ * no remote, and projects the target host already has, are left out.
+ */
+export function buildOtherHostProjectChoices(input: {
+  targetHostId: string;
+  hosts: readonly HostProjects[];
+  query: string;
+}): OtherHostProjectChoice[] {
+  const targetKeys = new Set(
+    input.hosts
+      .find((host) => host.serverId === input.targetHostId)
+      ?.projects.map((project) => project.projectKey)
+      .filter((key): key is string => Boolean(key)) ?? [],
+  );
+  const query = input.query.trim().toLowerCase();
+  const seen = new Set<string>();
+  const choices: OtherHostProjectChoice[] = [];
+  for (const host of input.hosts) {
+    if (host.serverId === input.targetHostId) continue;
+    for (const project of host.projects) {
+      if (project.projectKind !== "git") continue;
+      if (project.projectKey && targetKeys.has(project.projectKey)) continue;
+      const remoteUrl = projectRemoteUrl(project, host.workspaces);
+      if (!remoteUrl || seen.has(remoteUrl)) continue;
+      const repository = buildManualGithubRepositoryChoices(remoteUrl)[0];
+      if (!repository) continue;
+      const projectName = project.projectCustomName ?? project.projectDisplayName;
+      if (
+        query &&
+        !projectName.toLowerCase().includes(query) &&
+        !remoteUrl.toLowerCase().includes(query) &&
+        !host.label.toLowerCase().includes(query)
+      ) {
+        continue;
+      }
+      seen.add(remoteUrl);
+      choices.push({
+        id: `${host.serverId}:${project.projectId}`,
+        serverId: host.serverId,
+        projectName,
+        hostLabel: host.label,
+        remoteUrl,
+        repository: {
+          ...repository,
+          id: `other-host:${host.serverId}:${project.projectId}`,
+          description: `${remoteUrl} on ${host.label}`,
+        },
+      });
+    }
+  }
+  return choices;
+}
+
+function projectRemoteUrl(
+  project: ProjectDescriptor,
+  workspaces: readonly WorkspaceDescriptor[],
+): string | null {
+  for (const workspace of workspaces) {
+    const remoteUrl = workspace.gitRuntime?.remoteUrl;
+    if (workspace.projectId === project.projectId && remoteUrl) return remoteUrl;
+  }
+  if (!project.projectKey?.startsWith("remote:")) return null;
+  const location = project.projectKey.slice("remote:".length).split("#")[0];
+  return location ? `https://${location}.git` : null;
+}
+
+/** `buildOtherHostProjectChoices` over the hosts the flow can see, from the session store. */
+export function useOtherHostProjectChoices(input: {
+  targetHostId: string | null;
+  hosts: readonly AddProjectHost[];
+  query: string;
+}): OtherHostProjectChoice[] {
+  const sessions = useStoreWithEqualityFn(
+    useSessionStore,
+    (state) =>
+      input.hosts.map((host) => {
+        const session = state.sessions[host.serverId];
+        return { projects: session?.projects ?? null, workspaces: session?.workspaces ?? null };
+      }),
+    (left, right) =>
+      left.length === right.length &&
+      left.every(
+        (entry, index) =>
+          entry.projects === right[index]?.projects &&
+          entry.workspaces === right[index]?.workspaces,
+      ),
+  );
+  return useMemo(() => {
+    if (!input.targetHostId) return [];
+    const hosts = input.hosts.map<HostProjects>((host, index) => ({
+      serverId: host.serverId,
+      label: host.label,
+      projects: [...(sessions[index]?.projects?.values() ?? [])],
+      workspaces: [...(sessions[index]?.workspaces?.values() ?? [])],
+    }));
+    return buildOtherHostProjectChoices({
+      targetHostId: input.targetHostId,
+      hosts,
+      query: input.query,
+    });
+  }, [input.hosts, input.query, input.targetHostId, sessions]);
+}
+
+/** Whether any other connected host could offer a project to clone onto `targetHostId`. */
+export function hasOtherAddProjectHosts(
+  hosts: readonly AddProjectHost[],
+  targetHostId: string,
+): boolean {
+  return hosts.some((host) => host.serverId !== targetHostId);
+}
