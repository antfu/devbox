+import { useCallback, useMemo, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { Text, View } from "react-native";
+import { StyleSheet, withUnistyles } from "react-native-unistyles";
+import { ExternalLink } from "lucide-react-native";
+import { CheckIndicator } from "@/components/sidebar/workspace-meta-row/check-indicator";
+import { selectCheckSummary } from "@/components/sidebar/workspace-meta-row/check-summary";
+import { PressHighlight } from "@/components/ui/press-highlight";
+import { WorkspaceDiffStatPill } from "@/composer/diff-stat-pill";
+import { useIsCompactFormFactor } from "@/constants/layout";
+import { getForgePresentation, normalizeForge } from "@/git/forge";
+import { selectPrHintFromStatus, type PrHint } from "@/git/pr-hint";
+import { PullRequestStateIcon } from "@/git/pull-request-state-icon";
+import { useSettings } from "@/hooks/use-settings";
+import { useWorkspaceFields } from "@/stores/session-store-hooks";
+import type { Theme } from "@/styles/theme";
+import { buildWorkspaceTabPersistenceKey } from "@/workspace-tabs/model";
+import { openWorkspaceChanges } from "@/workspace-tabs/open-supporting-view";
+import { openExternalUrl } from "@/utils/open-external-url";
+
+const ICON_SIZE = 14;
+
+const ThemedExternalLink = withUnistyles(ExternalLink);
+const foregroundMapping = (theme: Theme) => ({ color: theme.colors.foreground });
+
+const PR_STATE_LABEL_KEYS = {
+  open: "workspace.git.pr.states.open",
+  merged: "workspace.git.pr.states.merged",
+  closed: "workspace.git.pr.states.closed",
+} as const;
+
+/**
+ * The workspace's change request and its uncommitted changes, in the header next to the title:
+ * the change request's number, state and CI link out to the forge, and the diff stat opens the
+ * Changes tab. Wide layouts only; the compact header has no room beside the title.
+ */
+export function WorkspaceHeaderGitSummary({
+  serverId,
+  workspaceId,
+}: {
+  serverId: string;
+  workspaceId: string;
+}) {
+  const isCompact = useIsCompactFormFactor();
+  const openInSidePane = useSettings((settings) => settings.openInSidePane);
+  const prHint = useWorkspaceFields(serverId, workspaceId, (workspace) =>
+    selectPrHintFromStatus(workspace.githubRuntime?.pullRequest, workspace.forge),
+  );
+  const workspaceKey = buildWorkspaceTabPersistenceKey({ serverId, workspaceId });
+  const handleOpenChanges = useCallback(() => {
+    if (!workspaceKey) return;
+    openWorkspaceChanges({ isCompact, workspaceKey, preferences: openInSidePane });
+  }, [isCompact, openInSidePane, workspaceKey]);
+
+  if (isCompact) return null;
+
+  return (
+    <View style={styles.row} testID="workspace-header-git-summary">
+      {prHint ? <HeaderPullRequest hint={prHint} /> : null}
+      <WorkspaceDiffStatPill
+        serverId={serverId}
+        workspaceId={workspaceId}
+        onPress={handleOpenChanges}
+      />
+    </View>
+  );
+}
+
+function HeaderPullRequest({ hint }: { hint: PrHint }) {
+  const { t } = useTranslation();
+  const [isHovered, setIsHovered] = useState(false);
+  const presentation = getForgePresentation(normalizeForge(hint.forge));
+  const checkSummary = useMemo(() => selectCheckSummary(hint), [hint]);
+  const handlePress = useCallback(() => void openExternalUrl(hint.url), [hint.url]);
+  const handleHoverIn = useCallback(() => setIsHovered(true), []);
+  const handleHoverOut = useCallback(() => setIsHovered(false), []);
+
+  return (
+    <PressHighlight
+      testID="workspace-header-pull-request"
+      accessibilityRole="link"
+      accessibilityLabel={t("workspace.git.pr.accessibility.pullRequest", {
+        number: hint.number,
+        context: presentation.changeRequestContext,
+      })}
+      hitSlop={4}
+      onPress={handlePress}
+      onHoverIn={handleHoverIn}
+      onHoverOut={handleHoverOut}
+      style={styles.pullRequest}
+    >
+      {isHovered ? (
+        <ThemedExternalLink size={ICON_SIZE} uniProps={foregroundMapping} />
+      ) : (
+        <PullRequestStateIcon state={hint.state} size={ICON_SIZE} />
+      )}
+      <Text style={isHovered ? styles.textHovered : styles.text} numberOfLines={1}>
+        {presentation.numberPrefix}
+        {hint.number} {t(PR_STATE_LABEL_KEYS[hint.state])}
+      </Text>
+      {checkSummary ? <CheckIndicator summary={checkSummary} size={ICON_SIZE} /> : null}
+    </PressHighlight>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  row: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[2],
+    flexShrink: 0,
+  },
+  pullRequest: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[1],
+    paddingHorizontal: theme.spacing[1.5],
+    height: 24,
+    borderRadius: theme.borderRadius.md,
+  },
+  text: {
+    color: theme.colors.foregroundMuted,
+    fontSize: theme.fontSize.sm,
+  },
+  textHovered: {
+    color: theme.colors.foreground,
+    fontSize: theme.fontSize.sm,
+  },
+}));
