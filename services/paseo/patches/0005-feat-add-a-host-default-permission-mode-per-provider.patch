@@ -0,0 +1,39 @@
+import type { AgentMode, ProviderSnapshotEntry } from "./agent-sdk-types.js";
+
+// A configured id the provider no longer offers is ignored, so a stale host
+// default falls back to the provider's own default instead of failing creates.
+export function resolveHostDefaultModeId(
+  configured: string | null | undefined,
+  modes: readonly Pick<AgentMode, "id">[] | undefined,
+): string | undefined {
+  if (!configured || !modes?.some((mode) => mode.id === configured)) return undefined;
+  return configured;
+}
+
+export function applyHostDefaultMode(
+  entry: ProviderSnapshotEntry,
+  configured: string | null | undefined,
+): ProviderSnapshotEntry {
+  const hostDefaultModeId = resolveHostDefaultModeId(configured, entry.modes);
+  if (!hostDefaultModeId) return entry;
+  return { ...entry, defaultModeId: hostDefaultModeId, hostDefaultModeId };
+}
+
+export interface ResolveHostDefaultCreateModeInput {
+  requestedMode: string | undefined;
+  configured: string | null | undefined;
+  hasParent: boolean;
+  unattended: boolean;
+  availableModes: readonly Pick<AgentMode, "id">[];
+}
+
+// Only a top-level, attended create without a mode takes the host default.
+// Parent inheritance and unattended selection keep the provider's rules.
+export function resolveHostDefaultCreateMode(
+  input: ResolveHostDefaultCreateModeInput,
+): string | undefined {
+  if (input.requestedMode !== undefined || input.hasParent || input.unattended) {
+    return input.requestedMode;
+  }
+  return resolveHostDefaultModeId(input.configured, input.availableModes);
+}
