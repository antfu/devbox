+import { useProvidersSnapshot } from "@/hooks/use-providers-snapshot";
+import { useHostFeature } from "@/runtime/host-features";
+import { useHostRuntimeIsConnected } from "@/runtime/host-runtime";
+import { settingsStyles } from "@/styles/settings";
+
+interface DefaultModeChange {
+  provider: string;
+  modeId: string | null;
+}
+
+// Host-wide default mode per provider. New agents use it unless they carry an
+// explicit mode; null hands the choice back to the provider.
+export function ProviderDefaultModeCard({ serverId }: { serverId: string }) {
+  const { t } = useTranslation();
+  const isConnected = useHostRuntimeIsConnected(serverId);
+  const isSupported = useHostFeature(serverId, "providerDefaultMode");
+  const { config, patchConfig } = useDaemonConfig(serverId);
+  const { entries } = useProvidersSnapshot(serverId);
+  const providers = useMemo(
+    () => (entries ?? []).filter((entry) => entry.enabled && (entry.modes?.length ?? 0) > 0),
+    [entries],
+  );
+  const mutation = useMutation({
+    mutationFn: async ({ provider, modeId }: DefaultModeChange) => {
+      const result = await patchConfig({ providers: { [provider]: { defaultModeId: modeId } } });
+      if (!result) {
+        throw new Error(t("workspace.terminal.hostDisconnected"));
+      }
+      return result;
+    },
+  });
+  const handleChange = useCallback(
+    (change: DefaultModeChange) => mutation.mutate(change),
+    [mutation],
+  );
+
+  if (!isConnected || !isSupported || !config || providers.length === 0) return null;
+
+  return (
+    <View style={settingsStyles.card} testID="host-page-provider-default-mode-card">
+      <View style={settingsStyles.row}>
+        <View style={settingsStyles.rowContent}>
+          <Text style={settingsStyles.rowTitle}>{t("settings.host.agents.defaultMode.title")}</Text>
+          <Text style={settingsStyles.rowHint}>{t("settings.host.agents.defaultMode.hint")}</Text>
+          {mutation.error ? (
+            <Text style={settingsStyles.rowError} testID="host-page-provider-default-mode-error">
+              {mutation.error.message}
+            </Text>
+          ) : null}
+        </View>
+      </View>
+      {providers.map((entry) => (
+        <ProviderDefaultModeRow
+          key={entry.provider}
+          entry={entry}
+          modeId={config.providers[entry.provider]?.defaultModeId ?? null}
+          disabled={mutation.isPending}
+          onChange={handleChange}
+        />
+      ))}
+    </View>
+  );
+}
+
+function ProviderDefaultModeRow({
+  entry,
+  modeId,
+  disabled,
+  onChange,
+}: {
+  entry: ProviderSnapshotEntry;
+  modeId: string | null;
+  disabled: boolean;
+  onChange: (change: DefaultModeChange) => void;
+}) {
+  const { t } = useTranslation();
+  const providerLabel = entry.label ?? entry.provider;
+  const modes = entry.modes ?? [];
+  const providerDefaultLabel = t("settings.host.agents.defaultMode.providerDefault");
+  const selectedLabel = modeId
+    ? (modes.find((mode) => mode.id === modeId)?.label ?? modeId)
+    : providerDefaultLabel;
+  const handleProviderDefault = useCallback(
+    () => onChange({ provider: entry.provider, modeId: null }),
+    [entry.provider, onChange],
+  );
+
+  return (
+    <View style={[settingsStyles.row, settingsStyles.rowBorder]}>
+      <View style={settingsStyles.rowContent}>
+        <Text style={settingsStyles.rowTitle}>{providerLabel}</Text>
+      </View>
+      <DropdownMenu>
+        <DropdownTrigger
+          testID={`host-page-provider-default-mode-${entry.provider}`}
+          accessibilityRole="button"
+          accessibilityLabel={t("settings.host.agents.defaultMode.accessibilityLabel", {
+            provider: providerLabel,
+            value: selectedLabel,
+          })}
+          disabled={disabled}
+        >
+          {selectedLabel}
+        </DropdownTrigger>
+        <DropdownMenuContent side="bottom" align="end" width={240}>
+          <DropdownMenuItem selected={modeId === null} onSelect={handleProviderDefault}>
+            {providerDefaultLabel}
+          </DropdownMenuItem>
+          {modes.map((mode) => (
+            <ModeMenuItem
+              key={mode.id}
+              provider={entry.provider}
+              mode={mode}
+              selected={mode.id === modeId}
+              onChange={onChange}
+            />
+          ))}
+        </DropdownMenuContent>
+      </DropdownMenu>
+    </View>
+  );
+}
+
+function ModeMenuItem({
+  provider,
+  mode,
+  selected,
+  onChange,
+}: {
+  provider: string;
+  mode: AgentMode;
+  selected: boolean;
+  onChange: (change: DefaultModeChange) => void;
+}) {
+  const handleSelect = useCallback(
+    () => onChange({ provider, modeId: mode.id }),
+    [mode.id, onChange, provider],
+  );
+  return (
+    <DropdownMenuItem selected={selected} description={mode.description} onSelect={handleSelect}>
+      {mode.label}
+    </DropdownMenuItem>
+  );
+}
