+import { describe, expect, it } from "vitest";
+import type { ProviderSnapshotEntry } from "@getpaseo/protocol/agent-types";
+import type { AgentProviderDefinition } from "@getpaseo/protocol/provider-manifest";
+import type { FormPreferences } from "@/hooks/use-form-preferences";
+import {
+  applyHostDefaultMode,
+  applyHostDefaultModes,
+  resolveHostDefaultModes,
+  type HostDefaultModes,
+} from "./host-default-mode";
+import {
+  INITIAL_USER_MODIFIED,
+  PENDING_AGENT_FORM_RESOLUTION,
+  resolveAgentForm,
+  type FormInitialValues,
+} from "./resolve-agent-form";
+
+const CLAUDE: AgentProviderDefinition = {
+  id: "claude",
+  label: "Claude",
+  description: "Claude test provider",
+  defaultModeId: "plan",
+  modes: [
+    { id: "default", label: "Always Ask", icon: "ShieldCheck", colorTier: "safe" },
+    { id: "acceptEdits", label: "Accept File Edits", icon: "ShieldAlert", colorTier: "moderate" },
+    { id: "plan", label: "Plan Mode", icon: "ShieldCheck", colorTier: "planning" },
+  ],
+};
+
+const ENTRIES: ProviderSnapshotEntry[] = [
+  { provider: "claude", status: "ready", enabled: true, hostDefaultModeId: "plan" },
+  { provider: "codex", status: "ready", enabled: true, defaultModeId: "auto" },
+];
+
+const REMEMBERED: FormPreferences = {
+  provider: "claude",
+  providerPreferences: { claude: { model: "opus", mode: "acceptEdits" } },
+};
+
+function resolveMode(input: {
+  preferences: FormPreferences;
+  hostDefaultModes: HostDefaultModes;
+  initialValues?: FormInitialValues;
+}): string {
+  const state = resolveAgentForm(
+    {
+      form: { provider: null, modeId: "", model: "", thinkingOptionId: "" },
+      userModified: INITIAL_USER_MODIFIED,
+      resolution: PENDING_AGENT_FORM_RESOLUTION,
+    },
+    {
+      type: "INPUTS_CHANGED",
+      serverId: "host",
+      isVisible: true,
+      isCreateFlow: true,
+      isPreferencesLoading: false,
+      hasSnapshot: true,
+      initialValues: input.initialValues,
+      preferences: applyHostDefaultModes(input.preferences, input.hostDefaultModes),
+      providerModelsByProvider: new Map([["claude", null]]),
+      allowedProviderMap: new Map([["claude", CLAUDE]]),
+    },
+  );
+  return state.form.modeId;
+}
+
+describe("resolveHostDefaultModes", () => {
+  it("collects the modes the host pins", () => {
+    expect(resolveHostDefaultModes(ENTRIES, true)).toEqual(new Map([["claude", "plan"]]));
+  });
+
+  it("ignores host defaults when the host does not advertise the feature", () => {
+    expect(resolveHostDefaultModes(ENTRIES, false).size).toBe(0);
+  });
+});
+
+describe("host default mode in agent form resolution", () => {
+  const hostDefaultModes: HostDefaultModes = new Map([["claude", "plan"]]);
+
+  it("beats the mode this device remembered", () => {
+    expect(resolveMode({ preferences: REMEMBERED, hostDefaultModes })).toBe("plan");
+  });
+
+  it("keeps the remembered mode when the host pins none", () => {
+    expect(resolveMode({ preferences: REMEMBERED, hostDefaultModes: new Map() })).toBe(
+      "acceptEdits",
+    );
+  });
+
+  it("yields to an explicit initial mode", () => {
+    expect(
+      resolveMode({
+        preferences: REMEMBERED,
+        hostDefaultModes,
+        initialValues: { modeId: "default" },
+      }),
+    ).toBe("default");
+  });
+
+  it("keeps the other remembered provider fields", () => {
+    expect(applyHostDefaultModes(REMEMBERED, hostDefaultModes)).toEqual({
+      provider: "claude",
+      providerPreferences: { claude: { model: "opus", mode: "plan" } },
+    });
+    expect(applyHostDefaultMode({ model: "opus" }, "plan")).toEqual({
+      model: "opus",
+      mode: "plan",
+    });
+  });
+});
diff --git a/packages/app/src/provider-selection/host-default-mode.ts b/packages/app/src/provider-selection/host-default-mode.ts
new file mode 100644
index 0000000000000000000000000000000000000000..49f25b1527af1a7f0fb33e9fba213cacb1c7b8cd
--- /dev/null
+++ b/packages/app/src/provider-selection/host-default-mode.ts
@@ -0,0 +1,40 @@
+import type { AgentProvider, ProviderSnapshotEntry } from "@getpaseo/protocol/agent-types";
+import type { FormPreferences, ProviderPreferences } from "@/hooks/use-form-preferences";
+
+export type HostDefaultModes = ReadonlyMap<AgentProvider, string>;
+
+const NO_HOST_DEFAULT_MODES: HostDefaultModes = new Map();
+
+export function resolveHostDefaultModes(
+  entries: readonly ProviderSnapshotEntry[] | undefined,
+  isSupported: boolean,
+): HostDefaultModes {
+  if (!isSupported || !entries) return NO_HOST_DEFAULT_MODES;
+  const configured = entries.flatMap((entry) =>
+    entry.hostDefaultModeId ? [[entry.provider, entry.hostDefaultModeId] as const] : [],
+  );
+  return configured.length > 0 ? new Map(configured) : NO_HOST_DEFAULT_MODES;
+}
+
+// A host default replaces the mode this device remembered for the provider.
+// Explicit initial modes (drafts, parents, schedules) are resolved before
+// preferences, so they still win.
+export function applyHostDefaultMode(
+  providerPrefs: ProviderPreferences | undefined,
+  hostDefaultModeId: string | undefined,
+): ProviderPreferences | undefined {
+  if (!hostDefaultModeId) return providerPrefs;
+  return { ...providerPrefs, mode: hostDefaultModeId };
+}
+
+export function applyHostDefaultModes(
+  preferences: FormPreferences | null,
+  hostDefaultModes: HostDefaultModes,
+): FormPreferences | null {
+  if (!preferences || hostDefaultModes.size === 0) return preferences;
+  const providerPreferences = { ...preferences.providerPreferences };
+  for (const [provider, modeId] of hostDefaultModes) {
+    providerPreferences[provider] = { ...providerPreferences[provider], mode: modeId };
+  }
+  return { ...preferences, providerPreferences };
+}
