diff --git a/packages/server/src/server/agent/host-default-mode.test.ts b/packages/server/src/server/agent/host-default-mode.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8f91ba5a115ca9c01a3d5a1b5473d9dc14b9c860
--- /dev/null
+++ b/packages/server/src/server/agent/host-default-mode.test.ts
@@ -0,0 +1,177 @@
+import { describe, expect, test } from "vitest";
+
+import { createTestLogger } from "../../test-utils/test-logger.js";
+import type {
+  AgentClient,
+  AgentMode,
+  AgentModelDefinition,
+  ResolveAgentCreateConfigInput,
+} from "./agent-sdk-types.js";
+import { resolveHostDefaultCreateMode } from "./host-default-mode.js";
+import { ProviderSnapshotManager } from "./provider-snapshot-manager.js";
+
+const MODES: AgentMode[] = [
+  { id: "default", label: "Always Ask" },
+  { id: "plan", label: "Plan" },
+  { id: "bypass", label: "Bypass", isUnattended: true },
+];
+
+const OTHER_PROVIDERS_DISABLED = {
+  claude: { enabled: false },
+  copilot: { enabled: false },
+  opencode: { enabled: false },
+  pi: { enabled: false },
+};
+
+function createCodexClient(resolverInputs: ResolveAgentCreateConfigInput[]): AgentClient {
+  return {
+    provider: "codex",
+    capabilities: {
+      supportsStreaming: false,
+      supportsSessionPersistence: false,
+      supportsDynamicModes: false,
+      supportsMcpServers: false,
+      supportsReasoningStream: false,
+      supportsToolInvocations: false,
+    },
+    async createSession() {
+      throw new Error("not implemented");
+    },
+    async resumeSession() {
+      throw new Error("not implemented");
+    },
+    async isAvailable() {
+      return true;
+    },
+    async fetchCatalog() {
+      return { models: [] as AgentModelDefinition[], modes: MODES, defaultModeId: "default" };
+    },
+    resolveCreateConfig(input) {
+      resolverInputs.push(input);
+      return { modeId: input.requestedMode, featureValues: input.featureValues };
+    },
+  };
+}
+
+function createManager(input: {
+  defaultModeId?: string | null;
+  resolverInputs?: ResolveAgentCreateConfigInput[];
+}): ProviderSnapshotManager {
+  return new ProviderSnapshotManager({
+    logger: createTestLogger(),
+    providerOverrides: {
+      ...OTHER_PROVIDERS_DISABLED,
+      ...(input.defaultModeId !== undefined
+        ? { codex: { defaultModeId: input.defaultModeId } }
+        : {}),
+    },
+    extraClients: { codex: createCodexClient(input.resolverInputs ?? []) },
+  });
+}
+
+describe("host default mode", () => {
+  test("publishes a configured mode as the provider default", async () => {
+    const manager = createManager({ defaultModeId: "plan" });
+    try {
+      const entry = await manager.getProvider({ provider: "codex", wait: true });
+      expect(entry).toMatchObject({
+        status: "ready",
+        defaultModeId: "plan",
+        hostDefaultModeId: "plan",
+      });
+    } finally {
+      manager.destroy();
+    }
+  });
+
+  test("keeps the provider's default when the configured mode is not offered", async () => {
+    const manager = createManager({ defaultModeId: "removed-mode" });
+    try {
+      const entry = await manager.getProvider({ provider: "codex", wait: true });
+      expect(entry.defaultModeId).toBe("default");
+      expect(entry.hostDefaultModeId).toBeUndefined();
+    } finally {
+      manager.destroy();
+    }
+  });
+
+  test("applies and clears the host default through a live provider config change", async () => {
+    const manager = createManager({});
+    try {
+      await manager.getProvider({ provider: "codex", wait: true });
+
+      manager.applyMutableProviderConfig({ codex: { defaultModeId: "plan" } });
+      expect(await manager.getProvider({ provider: "codex", wait: true })).toMatchObject({
+        defaultModeId: "plan",
+        hostDefaultModeId: "plan",
+      });
+
+      manager.applyMutableProviderConfig({ codex: { defaultModeId: null } });
+      const cleared = await manager.getProvider({ provider: "codex", wait: true });
+      expect(cleared.defaultModeId).toBe("default");
+      expect(cleared.hostDefaultModeId).toBeUndefined();
+    } finally {
+      manager.destroy();
+    }
+  });
+
+  test("creates without a mode use the host default", async () => {
+    const resolverInputs: ResolveAgentCreateConfigInput[] = [];
+    const manager = createManager({ defaultModeId: "plan", resolverInputs });
+    try {
+      const resolved = await manager.resolveCreateConfig({
+        provider: "codex",
+        requestedMode: undefined,
+        featureValues: undefined,
+        parent: null,
+        unattended: false,
+      });
+      expect(resolved).toEqual({ modeId: "plan", featureValues: undefined });
+      expect(resolverInputs.map((input) => input.requestedMode)).toEqual(["plan"]);
+    } finally {
+      manager.destroy();
+    }
+  });
+
+  test("an explicit mode wins over the host default", async () => {
+    const manager = createManager({ defaultModeId: "plan" });
+    try {
+      const resolved = await manager.resolveCreateConfig({
+        provider: "codex",
+        requestedMode: "default",
+        featureValues: undefined,
+        parent: null,
+        unattended: false,
+      });
+      expect(resolved.modeId).toBe("default");
+    } finally {
+      manager.destroy();
+    }
+  });
+});
+
+describe("resolveHostDefaultCreateMode", () => {
+  const base = {
+    requestedMode: undefined,
+    configured: "plan",
+    hasParent: false,
+    unattended: false,
+    availableModes: MODES,
+  };
+
+  test("leaves parent inheritance to the provider", () => {
+    expect(resolveHostDefaultCreateMode({ ...base, hasParent: true })).toBeUndefined();
+  });
+
+  test("leaves unattended selection to the provider", () => {
+    expect(resolveHostDefaultCreateMode({ ...base, unattended: true })).toBeUndefined();
+  });
+
+  test("ignores a configured mode the provider does not offer", () => {
+    expect(resolveHostDefaultCreateMode({ ...base, configured: "gone" })).toBeUndefined();
+  });
+
+  test("ignores a cleared host default", () => {
+    expect(resolveHostDefaultCreateMode({ ...base, configured: null })).toBeUndefined();
+  });
+});
