 } as const;
 
-/** The canonical state glyph and color shared by every pull-request badge. */
+/**
+ * The canonical state glyph and color shared by every pull-request badge. An open change request
+ * with merge conflicts shows a warning glyph instead, so a badge says it needs work before merging.
+ */
 export function PullRequestStateIcon({
   state,
   size,
   strokeWidth,
+  hasConflicts,
 }: {
   state: PrHint["state"];
   size: number;
   strokeWidth?: number;
+  hasConflicts?: boolean;
 }) {
+  if (hasConflicts && state === "open") {
+    return <ThemedAlertTriangle size={size} strokeWidth={strokeWidth} uniProps={warningMapping} />;
+  }
   const { Icon, color } = PRESENTATION[state];
   return <Icon size={size} strokeWidth={strokeWidth} uniProps={color} />;
 }
