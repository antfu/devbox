@@ -0,0 +1,90 @@
+import { isGitHubHost, parseGitHubRemoteIdentity } from "@getpaseo/protocol/git-remote";
+
+import { getImageDimensions, type ProjectIcon } from "./project-icon.js";
+
+const AVATAR_SIZE = 64;
+const MAX_AVATAR_BYTES = 32 * 1024;
+// Daemon startup load can push a proxied fetch past a few seconds, and a miss sticks for the session.
+const FETCH_TIMEOUT_MS = 10_000;
+const FOUND_TTL_MS = 24 * 60 * 60 * 1000;
+const MISSING_TTL_MS = 24 * 60 * 60 * 1000;
+const FAILED_TTL_MS = 60 * 1000;
+const ACCEPTED_MIME_TYPES = new Set(["image/png", "image/jpeg", "image/gif", "image/webp"]);
+
+type AvatarFetch = (url: string, init: { signal: AbortSignal }) => Promise<Response>;
+
+interface CacheEntry {
+  icon: Promise<ProjectIcon | null>;
+  expiresAt: number;
+}
+
+/**
+ * The GitHub owner of a project, read from its project key
+ * (`remote:github.com/<owner>/<repo>[#subdir:...]`), or null when the project
+ * is not on GitHub.
+ */
+export function parseGitHubOwnerFromProjectKey(projectKey: string | null): string | null {
+  if (!projectKey?.startsWith("remote:")) return null;
+  const location = projectKey.slice("remote:".length).split("#")[0] ?? "";
+  const slash = location.indexOf("/");
+  if (slash <= 0) return null;
+  const host = location.slice(0, slash).replace(/:\d+$/u, "");
+  if (!isGitHubHost(host)) return null;
+  return parseGitHubRemoteIdentity(location.slice(slash + 1))?.owner ?? null;
+}
+
+/**
+ * Fetches GitHub owners' avatars (`github.com/<owner>.png`) as a last-resort
+ * project icon. Results are cached per owner, so resolving icons for many
+ * projects, or many times, costs one request per owner per day.
+ */
+export class GitHubOwnerAvatars {
+  private readonly cache = new Map<string, CacheEntry>();
+
+  constructor(
+    private readonly fetchAvatar: AvatarFetch = (url, init) => fetch(url, init),
+    private readonly now: () => number = Date.now,
+  ) {}
+
+  get(projectKey: string | null): Promise<ProjectIcon | null> {
+    const owner = parseGitHubOwnerFromProjectKey(projectKey)?.toLowerCase();
+    if (!owner) return Promise.resolve(null);
+    const cached = this.cache.get(owner);
+    if (cached && cached.expiresAt > this.now()) return cached.icon;
+
+    const entry: CacheEntry = { icon: Promise.resolve(null), expiresAt: Infinity };
+    entry.icon = this.load(owner).then(
+      ({ icon, ttl }) => {
+        entry.expiresAt = this.now() + ttl;
+        return icon;
+      },
+      () => {
+        entry.expiresAt = this.now() + FAILED_TTL_MS;
+        return null;
+      },
+    );
+    this.cache.set(owner, entry);
+    return entry.icon;
+  }
+
+  private async load(owner: string): Promise<{ icon: ProjectIcon | null; ttl: number }> {
+    const url = `https://github.com/${encodeURIComponent(owner)}.png?size=${AVATAR_SIZE}`;
+    const response = await this.fetchAvatar(url, { signal: AbortSignal.timeout(FETCH_TIMEOUT_MS) });
+    if (response.status === 404) return { icon: null, ttl: MISSING_TTL_MS };
+    if (!response.ok) return { icon: null, ttl: FAILED_TTL_MS };
+    const buffer = Buffer.from(await response.arrayBuffer());
+    return { icon: toProjectIcon(buffer, response.headers.get("content-type")), ttl: FOUND_TTL_MS };
+  }
+}
+
+function toProjectIcon(buffer: Buffer, contentType: string | null): ProjectIcon | null {
+  const mimeType = contentType?.split(";")[0]?.trim().toLowerCase() ?? "";
+  if (!ACCEPTED_MIME_TYPES.has(mimeType)) return null;
+  if (buffer.length === 0 || buffer.length > MAX_AVATAR_BYTES) return null;
+  const size = getImageDimensions(buffer, mimeType);
+  if (!size || size.width <= 0 || size.width !== size.height) return null;
+  return { data: buffer.toString("base64"), mimeType };
+}
+
+/** Shared by every session, so one daemon fetches each owner's avatar once. */
+export const githubOwnerAvatars = new GitHubOwnerAvatars();
