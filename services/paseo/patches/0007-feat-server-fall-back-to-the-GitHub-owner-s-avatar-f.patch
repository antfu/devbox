diff --git a/packages/server/src/utils/project-github-avatar.test.ts b/packages/server/src/utils/project-github-avatar.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2ba104585947d770edef137dcac8d364efcd0c33
--- /dev/null
+++ b/packages/server/src/utils/project-github-avatar.test.ts
@@ -0,0 +1,119 @@
+import { describe, expect, it } from "vitest";
+
+import { GitHubOwnerAvatars, parseGitHubOwnerFromProjectKey } from "./project-github-avatar.js";
+
+// A PNG header: signature, IHDR length and type, then width and height.
+function png(width: number, height: number): Buffer {
+  const buffer = Buffer.alloc(33);
+  Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]).copy(buffer, 0);
+  buffer.writeUInt32BE(13, 8);
+  buffer.write("IHDR", 12, "ascii");
+  buffer.writeUInt32BE(width, 16);
+  buffer.writeUInt32BE(height, 20);
+  return buffer;
+}
+
+function imageResponse(body: Buffer, contentType = "image/png"): Response {
+  return new Response(new Uint8Array(body), { headers: { "content-type": contentType } });
+}
+
+interface FakeFetch {
+  urls: string[];
+  fetch: (url: string) => Promise<Response>;
+}
+
+function fakeFetch(respond: () => Response | Promise<Response>): FakeFetch {
+  const urls: string[] = [];
+  return {
+    urls,
+    fetch: async (url) => {
+      urls.push(url);
+      return respond();
+    },
+  };
+}
+
+describe("parseGitHubOwnerFromProjectKey", () => {
+  it.each([
+    ["remote:github.com/nuxt/devtools", "nuxt"],
+    ["remote:github.com/vitejs/devtools#subdir:packages/core", "vitejs"],
+  ])("reads the owner from %s", (projectKey, owner) => {
+    expect(parseGitHubOwnerFromProjectKey(projectKey)).toBe(owner);
+  });
+
+  it.each([
+    null,
+    "remote:gitlab.com/nuxt/devtools",
+    "remote:github.com/nuxt",
+    "/home/me/projects/devtools",
+    "host:abc:/home/me/projects/devtools",
+  ])("returns null for %s", (projectKey) => {
+    expect(parseGitHubOwnerFromProjectKey(projectKey)).toBeNull();
+  });
+});
+
+describe("GitHubOwnerAvatars", () => {
+  it("fetches the owner's avatar for a GitHub project", async () => {
+    const avatar = png(64, 64);
+    const fake = fakeFetch(() => imageResponse(avatar));
+    const avatars = new GitHubOwnerAvatars(fake.fetch);
+
+    const icon = await avatars.get("remote:github.com/nuxt/devtools");
+
+    expect(fake.urls).toEqual(["https://github.com/nuxt.png?size=64"]);
+    expect(icon).toEqual({ data: avatar.toString("base64"), mimeType: "image/png" });
+  });
+
+  it("does not fetch for projects that are not on GitHub", async () => {
+    const fake = fakeFetch(() => imageResponse(png(64, 64)));
+    const avatars = new GitHubOwnerAvatars(fake.fetch);
+
+    expect(await avatars.get("remote:gitlab.com/nuxt/devtools")).toBeNull();
+    expect(await avatars.get(null)).toBeNull();
+    expect(fake.urls).toEqual([]);
+  });
+
+  it("fetches each owner once across projects and calls", async () => {
+    const fake = fakeFetch(() => imageResponse(png(64, 64)));
+    const avatars = new GitHubOwnerAvatars(fake.fetch);
+
+    await Promise.all([
+      avatars.get("remote:github.com/nuxt/devtools"),
+      avatars.get("remote:github.com/Nuxt/nuxt"),
+    ]);
+    await avatars.get("remote:github.com/nuxt/ui");
+
+    expect(fake.urls).toHaveLength(1);
+  });
+
+  it("refetches after a failure once the retry window passes", async () => {
+    let now = 0;
+    let fail = true;
+    const fake = fakeFetch(() => {
+      if (fail) throw new Error("offline");
+      return imageResponse(png(64, 64));
+    });
+    const avatars = new GitHubOwnerAvatars(fake.fetch, () => now);
+
+    expect(await avatars.get("remote:github.com/nuxt/devtools")).toBeNull();
+    fail = false;
+    expect(await avatars.get("remote:github.com/nuxt/devtools")).toBeNull();
+    now += 11 * 60 * 1000;
+    expect(await avatars.get("remote:github.com/nuxt/devtools")).not.toBeNull();
+    expect(fake.urls).toHaveLength(2);
+  });
+
+  it.each([
+    ["a missing owner", () => new Response(null, { status: 404 })],
+    ["a non-square image", () => imageResponse(png(64, 32))],
+    [
+      "an oversized image",
+      () => imageResponse(Buffer.concat([png(64, 64), Buffer.alloc(33 * 1024)])),
+    ],
+    ["a non-image response", () => imageResponse(Buffer.from("<html></html>"), "text/html")],
+  ])("returns null for %s", async (_, respond) => {
+    const avatars = new GitHubOwnerAvatars(fakeFetch(respond).fetch);
+
+    expect(await avatars.get("remote:github.com/nuxt/devtools")).toBeNull();
+  });
+});
