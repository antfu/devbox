+import { describe, expect, it } from "vitest";
+import type { HostConfigEntry } from "@/hosts/host-config-transfer";
+import type { HostProfile } from "@/types/host-connection";
+import { applyHostConfigEntries, mergeHostConfigEntries } from "./host-registry-sync-model";
+
+const NOW = "2026-11-16T00:00:00.000Z";
+
+function host(serverId: string, label = serverId): HostProfile {
+  return {
+    serverId,
+    label,
+    appearance: { color: "none", badgeDisplay: null },
+    lifecycle: {},
+    connections: [
+      {
+        id: `direct:${serverId}:6767`,
+        type: "directTcp",
+        endpoint: `${serverId}:6767`,
+        useTls: false,
+      },
+    ],
+    preferredConnectionId: `direct:${serverId}:6767`,
+    createdAt: "2026-01-01T00:00:00.000Z",
+    updatedAt: "2026-01-01T00:00:00.000Z",
+  };
+}
+
+function entry(serverId: string, label = serverId): HostConfigEntry {
+  return { profile: host(serverId, label) };
+}
+
+function labels(entries: HostConfigEntry[]): string[] {
+  return entries.map((item) => item.profile.label);
+}
+
+describe("mergeHostConfigEntries", () => {
+  it("takes the other device's edits, additions and removals when this device changed nothing", () => {
+    const base = [entry("a"), entry("b")];
+    const remote = [entry("a", "A2"), entry("c")];
+    expect(labels(mergeHostConfigEntries({ base, local: base, remote, prefer: "local" }))).toEqual([
+      "A2",
+      "c",
+    ]);
+  });
+
+  it("keeps this device's edits, additions and removals when the daemon's list did not change", () => {
+    const base = [entry("a"), entry("b")];
+    const local = [entry("a", "A2"), entry("c")];
+    expect(labels(mergeHostConfigEntries({ base, local, remote: base, prefer: "remote" }))).toEqual(
+      ["A2", "c"],
+    );
+  });
+
+  it("merges edits to different hosts from both sides", () => {
+    const base = [entry("a"), entry("b")];
+    const local = [entry("a", "A-local"), entry("b")];
+    const remote = [entry("a"), entry("b", "B-remote")];
+    expect(labels(mergeHostConfigEntries({ base, local, remote, prefer: "local" }))).toEqual([
+      "A-local",
+      "B-remote",
+    ]);
+  });
+
+  it("lets the preferred side win a conflict, but never drops a host the other side edited", () => {
+    const base = [entry("a"), entry("b")];
+    const local = [entry("a", "A-local")];
+    const remote = [entry("a", "A-remote"), entry("b", "B-remote")];
+    expect(labels(mergeHostConfigEntries({ base, local, remote, prefer: "local" }))).toEqual([
+      "A-local",
+      "B-remote",
+    ]);
+  });
+
+  it("on a first sync unions both lists, preferring the daemon's copy of a shared host", () => {
+    const local = [entry("a", "A-local"), entry("x")];
+    const remote = [entry("a", "A-remote"), entry("b")];
+    expect(labels(mergeHostConfigEntries({ base: [], local, remote, prefer: "remote" }))).toEqual([
+      "A-remote",
+      "b",
+      "x",
+    ]);
+  });
+});
+
+describe("applyHostConfigEntries", () => {
+  it("mirrors the synced list, keeping creation times, routed connections and routed-only hosts", () => {
+    const saved = {
+      ...host("a"),
+      connections: [
+        ...host("a").connections,
+        { id: "routed:b", type: "routed" as const, originServerId: "b" },
+      ],
+    };
+    const routedOnly: HostProfile = {
+      ...host("r"),
+      connections: [{ id: "routed:a", type: "routed", originServerId: "a" }],
+      preferredConnectionId: "routed:a",
+    };
+    const result = applyHostConfigEntries({
+      hosts: [saved, host("gone"), routedOnly],
+      icons: { gone: "cloud", r: "cpu" },
+      entries: [{ profile: host("a", "A2"), icon: "laptop" }, entry("new")],
+      now: NOW,
+    });
+    expect(result.hosts.map((item) => [item.serverId, item.label, item.createdAt])).toEqual([
+      ["a", "A2", saved.createdAt],
+      ["new", "new", NOW],
+      ["r", "r", routedOnly.createdAt],
+    ]);
+    expect(result.hosts[0]?.connections.map((connection) => connection.id)).toEqual([
+      "direct:a:6767",
+      "routed:b",
+    ]);
+    expect(result.icons).toEqual({ a: "laptop", r: "cpu" });
+  });
+});
diff --git a/packages/app/src/hosts/host-registry-sync-model.ts b/packages/app/src/hosts/host-registry-sync-model.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f32dec5b0fb02a5fb3aaa2e87e029ea496b94420
--- /dev/null
+++ b/packages/app/src/hosts/host-registry-sync-model.ts
@@ -0,0 +1,90 @@
+import type { HostIconName } from "@/hosts/host-icons";
+import {
+  type HostConfigEntry,
+  parseHostConfig,
+  serializeHostConfig,
+} from "@/hosts/host-config-transfer";
+import type { HostProfile } from "@/types/host-connection";
+
+/**
+ * The host list the web app keeps on the daemon that serves it. Each device remembers the list it
+ * last agreed on with the daemon (the base), so a sync can tell its own edits from another
+ * device's and merge them host by host.
+ */
+
+function canonicalHostJson(entry: HostConfigEntry): string | undefined {
+  const text = serializeHostConfig([entry]);
+  return JSON.stringify((JSON.parse(text) as { hosts: unknown[] }).hosts[0]);
+}
+
+function byServerId(entries: readonly HostConfigEntry[]): Map<string, HostConfigEntry> {
+  return new Map(entries.map((entry) => [entry.profile.serverId, entry]));
+}
+
+/** The entries of a host config text; an empty or unknown text is an empty list. */
+export function readHostConfigEntries(text: string | null): HostConfigEntry[] {
+  return text ? (parseHostConfig(text) ?? []) : [];
+}
+
+/**
+ * Three-way merge by host. A host one side changed since the base takes that side; when both
+ * changed it, `prefer` wins, unless `prefer` removed it while the other side edited it.
+ */
+export function mergeHostConfigEntries(input: {
+  base: readonly HostConfigEntry[];
+  local: readonly HostConfigEntry[];
+  remote: readonly HostConfigEntry[];
+  prefer: "local" | "remote";
+}): HostConfigEntry[] {
+  const base = byServerId(input.base);
+  const local = byServerId(input.local);
+  const remote = byServerId(input.remote);
+  const serverIds = [...new Set([...remote.keys(), ...local.keys()])];
+  return serverIds.flatMap((serverId) => {
+    const b = base.get(serverId);
+    const l = local.get(serverId);
+    const r = remote.get(serverId);
+    const [bJson, lJson, rJson] = [b, l, r].map((entry) => entry && canonicalHostJson(entry));
+    let picked: HostConfigEntry | undefined;
+    if (lJson === rJson || lJson === bJson) picked = r;
+    else if (rJson === bJson) picked = l;
+    else picked = input.prefer === "local" ? (l ?? r) : (r ?? l);
+    return picked ? [picked] : [];
+  });
+}
+
+/**
+ * The registry after a synced list: each synced host replaces the saved one, which keeps its
+ * creation time and routed connections. Saved hosts with only routed connections are never
+ * synced, so they stay, with their icons.
+ */
+export function applyHostConfigEntries(input: {
+  hosts: readonly HostProfile[];
+  icons: Readonly<Record<string, HostIconName>>;
+  entries: readonly HostConfigEntry[];
+  now: string;
+}): { hosts: HostProfile[]; icons: Record<string, HostIconName> } {
+  const saved = new Map(input.hosts.map((host) => [host.serverId, host]));
+  const synced = new Set(input.entries.map((entry) => entry.profile.serverId));
+  const hosts: HostProfile[] = [];
+  const icons: Record<string, HostIconName> = {};
+  for (const { profile, icon } of input.entries) {
+    const previous = saved.get(profile.serverId);
+    const routed = previous?.connections.filter((connection) => connection.type === "routed") ?? [];
+    hosts.push({
+      ...profile,
+      connections: [...profile.connections, ...routed],
+      createdAt: previous?.createdAt ?? input.now,
+      updatedAt: input.now,
+    });
+    if (icon) icons[profile.serverId] = icon;
+  }
+  for (const host of input.hosts) {
+    if (synced.has(host.serverId)) continue;
+    if (!host.connections.every((connection) => connection.type === "routed")) continue;
+    hosts.push(host);
+    const icon = input.icons[host.serverId];
+    if (icon) icons[host.serverId] = icon;
+  }
+  return { hosts, icons };
+}
diff --git a/packages/app/src/hosts/host-registry-sync.ts b/packages/app/src/hosts/host-registry-sync.ts
new file mode 100644
index 0000000000000000000000000000000000000000..155dfeba1b61b15b04170e3091530c0f0120f8b0
--- /dev/null
+++ b/packages/app/src/hosts/host-registry-sync.ts
@@ -0,0 +1,165 @@
+import AsyncStorage from "@react-native-async-storage/async-storage";
+import type { DaemonClient } from "@getpaseo/client/internal/daemon-client";
+import { useEffect } from "react";
+import { type HostConfigEntry, serializeHostConfig } from "@/hosts/host-config-transfer";
+import { getHostIcons, replaceHostIcons, subscribeHostIcons } from "@/hosts/host-icon-store";
+import {
+  applyHostConfigEntries,
+  mergeHostConfigEntries,
+  readHostConfigEntries,
+} from "@/hosts/host-registry-sync-model";
+import { useServingDaemon } from "@/hosts/serving-daemon";
+import { useHostFeature } from "@/runtime/host-features";
+import {
+  getHostRuntimeStore,
+  useHostRuntimeClient,
+  useHostRuntimeIsConnected,
+  useHosts,
+} from "@/runtime/host-runtime";
+
+const SYNC_STATE_STORAGE_KEY = "@paseo:host-registry-sync";
+const SYNC_INTERVAL_MS = 5_000;
+const CHANGE_DEBOUNCE_MS = 300;
+
+/** The list this device last agreed on with the serving daemon. */
+interface SyncState {
+  serverId: string;
+  revision: number;
+  base: string;
+}
+
+type HostRegistryClient = Pick<DaemonClient, "getAppHostRegistry" | "setAppHostRegistry">;
+
+async function readSyncState(serverId: string): Promise<SyncState | null> {
+  try {
+    const raw = await AsyncStorage.getItem(SYNC_STATE_STORAGE_KEY);
+    const state = raw ? (JSON.parse(raw) as SyncState) : null;
+    return state?.serverId === serverId ? state : null;
+  } catch {
+    return null;
+  }
+}
+
+function localEntries(): HostConfigEntry[] {
+  const icons = getHostIcons();
+  return getHostRuntimeStore()
+    .getHosts()
+    .map((profile) => {
+      const icon = icons[profile.serverId];
+      return icon ? { profile, icon } : { profile };
+    });
+}
+
+/** Same hosts as text, whatever the key order of the objects they came from. */
+function canonical(text: string): string {
+  return serializeHostConfig(readHostConfigEntries(text));
+}
+
+/**
+ * Keeps this device's host list and the serving daemon's copy the same: polls it, merges both
+ * sides' changes host by host, and saves the merge back. Returns a stop function.
+ */
+function startHostRegistrySync(input: {
+  serverId: string;
+  client: HostRegistryClient;
+}): () => void {
+  const { serverId, client } = input;
+  let stopped = false;
+  let running = false;
+  let rerun = false;
+  let debounce: ReturnType<typeof setTimeout> | null = null;
+  let state: SyncState | null | undefined;
+  const isStopped = (): boolean => stopped;
+
+  async function syncOnce(): Promise<boolean> {
+    if (state === undefined) state = await readSyncState(serverId);
+    const remote = await client.getAppHostRegistry(state?.revision);
+    if (stopped) return false;
+    // No list where this device saw one (the daemon's file was removed): start over, without
+    // reading the empty list as every host removed.
+    if (state && remote.config === null && remote.revision !== state.revision) state = null;
+    const base = state?.base ?? null;
+    const remoteText = remote.config ?? (state ? base : null);
+    const localText = serializeHostConfig(localEntries());
+    const merged = mergeHostConfigEntries({
+      base: readHostConfigEntries(base),
+      local: readHostConfigEntries(localText),
+      remote: readHostConfigEntries(remoteText),
+      // A device's first sync takes the daemon's copy of a host both lists have.
+      prefer: state ? "local" : "remote",
+    });
+    const mergedText = serializeHostConfig(merged);
+    if (mergedText !== canonical(localText)) {
+      const next = applyHostConfigEntries({
+        hosts: getHostRuntimeStore().getHosts(),
+        icons: getHostIcons(),
+        entries: merged,
+        now: new Date().toISOString(),
+      });
+      await getHostRuntimeStore().replaceHosts(next.hosts);
+      await replaceHostIcons(next.icons);
+    }
+    let revision = remote.revision;
+    if (remoteText === null || mergedText !== canonical(remoteText)) {
+      const saved = await client.setAppHostRegistry({ config: mergedText, baseRevision: revision });
+      // Another device saved first: merge again against its list.
+      if (!saved.accepted) return true;
+      revision = saved.revision;
+    }
+    state = { serverId, revision, base: mergedText };
+    await AsyncStorage.setItem(SYNC_STATE_STORAGE_KEY, JSON.stringify(state));
+    return false;
+  }
+
+  async function run(): Promise<void> {
+    if (running) {
+      rerun = true;
+      return;
+    }
+    running = true;
+    try {
+      let again = true;
+      while (again && !isStopped()) {
+        rerun = false;
+        again = (await syncOnce()) || rerun;
+      }
+    } catch (error) {
+      console.warn("[HostRegistrySync] Failed to sync the host list", error);
+    } finally {
+      running = false;
+    }
+  }
+
+  function schedule(): void {
+    if (debounce) clearTimeout(debounce);
+    debounce = setTimeout(() => void run(), CHANGE_DEBOUNCE_MS);
+  }
+
+  const unsubscribeHosts = getHostRuntimeStore().subscribeHostList(schedule);
+  const unsubscribeIcons = subscribeHostIcons(schedule);
+  const interval = setInterval(() => void run(), SYNC_INTERVAL_MS);
+  void run();
+  return () => {
+    stopped = true;
+    if (debounce) clearTimeout(debounce);
+    clearInterval(interval);
+    unsubscribeHosts();
+    unsubscribeIcons();
+  };
+}
+
+/** Syncs the host list through the daemon that served this web page, while it is connected. */
+export function HostRegistrySync(): null {
+  const servingServerId = useServingDaemon()?.serverId ?? "";
+  const isSaved = useHosts().some((host) => host.serverId === servingServerId);
+  const client = useHostRuntimeClient(servingServerId);
+  const isConnected = useHostRuntimeIsConnected(servingServerId);
+  const isSupported = useHostFeature(servingServerId, "appHostRegistry");
+  const canSync = Boolean(servingServerId && isSaved && client && isConnected && isSupported);
+
+  useEffect(() => {
+    if (!canSync || !client) return;
+    return startHostRegistrySync({ serverId: servingServerId, client });
+  }, [canSync, client, servingServerId]);
+  return null;
+}
diff --git a/packages/app/src/hosts/serving-daemon.ts b/packages/app/src/hosts/serving-daemon.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ca61e3081d8358df6454ebe539aa4380f23e7824
--- /dev/null
+++ b/packages/app/src/hosts/serving-daemon.ts
@@ -0,0 +1,56 @@
+import { useEffect, useState } from "react";
+import { isWeb } from "@/constants/platform";
+
+/**
+ * The daemon that served this web page, when a daemon did (not app.paseo.sh, the desktop app or a
+ * native build). Its public `/api/status` names it, so the page can tell which saved host it is.
+ */
+export interface ServingDaemon {
+  serverId: string;
+  host: string;
+  port: string;
+  useTls: boolean;
+}
+
+let lookup: Promise<ServingDaemon | null> | null = null;
+
+async function fetchServingDaemon(): Promise<ServingDaemon | null> {
+  const { location } = window;
+  if (location.protocol !== "http:" && location.protocol !== "https:") return null;
+  try {
+    const response = await fetch("/api/status", { headers: { accept: "application/json" } });
+    if (!response.ok) return null;
+    const body = (await response.json()) as { status?: unknown; serverId?: unknown };
+    if (body.status !== "server_info" || typeof body.serverId !== "string") return null;
+    const useTls = location.protocol === "https:";
+    return {
+      serverId: body.serverId,
+      host: location.hostname,
+      port: location.port || (useTls ? "443" : "80"),
+      useTls,
+    };
+  } catch {
+    return null;
+  }
+}
+
+export function readServingDaemon(): Promise<ServingDaemon | null> {
+  if (!isWeb || typeof window === "undefined") return Promise.resolve(null);
+  lookup ??= fetchServingDaemon();
+  return lookup;
+}
+
+export function useServingDaemon(): ServingDaemon | null {
+  const [daemon, setDaemon] = useState<ServingDaemon | null>(null);
+  useEffect(() => {
+    let active = true;
+    void readServingDaemon().then((result) => {
+      if (active) setDaemon(result);
+      return undefined;
+    });
+    return () => {
+      active = false;
+    };
+  }, []);
+  return daemon;
+}
