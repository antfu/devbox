diff --git a/packages/server/src/server/app-host-registry.test.ts b/packages/server/src/server/app-host-registry.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..09daf03285c392cd46752999c3ff79fdb31aa895
--- /dev/null
+++ b/packages/server/src/server/app-host-registry.test.ts
@@ -0,0 +1,61 @@
+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import {
+  APP_HOST_REGISTRY_MAX_BYTES,
+  readAppHostRegistry,
+  writeAppHostRegistry,
+} from "./app-host-registry.js";
+
+describe("app host registry", () => {
+  let paseoHome: string;
+
+  beforeEach(async () => {
+    paseoHome = await mkdtemp(path.join(tmpdir(), "paseo-app-hosts-"));
+  });
+
+  afterEach(async () => {
+    await rm(paseoHome, { recursive: true, force: true });
+  });
+
+  it("starts empty at revision 0", async () => {
+    await expect(readAppHostRegistry(paseoHome)).resolves.toEqual({ revision: 0, config: null });
+  });
+
+  it("saves a list written against the current revision and bumps the revision", async () => {
+    await expect(
+      writeAppHostRegistry(paseoHome, { config: "a", baseRevision: 0 }),
+    ).resolves.toEqual({ accepted: true, revision: 1 });
+    await expect(readAppHostRegistry(paseoHome)).resolves.toEqual({ revision: 1, config: "a" });
+  });
+
+  it("returns the current list instead of saving a write against an old revision", async () => {
+    await writeAppHostRegistry(paseoHome, { config: "a", baseRevision: 0 });
+    await expect(
+      writeAppHostRegistry(paseoHome, { config: "b", baseRevision: 0 }),
+    ).resolves.toEqual({ accepted: false, revision: 1, config: "a" });
+    await expect(readAppHostRegistry(paseoHome)).resolves.toEqual({ revision: 1, config: "a" });
+  });
+
+  it("runs concurrent writes one at a time, so only one of two racing writes lands", async () => {
+    const results = await Promise.all([
+      writeAppHostRegistry(paseoHome, { config: "a", baseRevision: 0 }),
+      writeAppHostRegistry(paseoHome, { config: "b", baseRevision: 0 }),
+    ]);
+    expect(results.map((result) => result.accepted)).toEqual([true, false]);
+    await expect(readAppHostRegistry(paseoHome)).resolves.toEqual({ revision: 1, config: "a" });
+  });
+
+  it("rejects a list over the size limit", async () => {
+    const config = "x".repeat(APP_HOST_REGISTRY_MAX_BYTES + 1);
+    await expect(writeAppHostRegistry(paseoHome, { config, baseRevision: 0 })).rejects.toThrow(
+      "too large",
+    );
+  });
+
+  it("fails on a corrupt file instead of reporting an empty list", async () => {
+    await writeFile(path.join(paseoHome, "app-host-registry.json"), '{"revision":"x"}');
+    await expect(readAppHostRegistry(paseoHome)).rejects.toThrow();
+  });
+});
diff --git a/packages/server/src/server/app-host-registry.ts b/packages/server/src/server/app-host-registry.ts
new file mode 100644
index 0000000000000000000000000000000000000000..483f15ee1fbbeb8448278ee1312cb217757693fd
--- /dev/null
+++ b/packages/server/src/server/app-host-registry.ts
@@ -0,0 +1,102 @@
+import { promises as fs } from "node:fs";
+import path from "node:path";
+import type { SessionInboundMessage, SessionOutboundMessage } from "./messages.js";
+import { z } from "zod";
+import { writeJsonFileAtomic } from "./atomic-file.js";
+
+/**
+ * The host list the web app keeps on the daemon that serves it, so every browser that opens the app
+ * gets the same hosts. The daemon stores it as an opaque string: the app owns its format.
+ */
+const APP_HOST_REGISTRY_FILE = "app-host-registry.json";
+
+// A few hundred hosts fit comfortably; anything larger is not a host list.
+export const APP_HOST_REGISTRY_MAX_BYTES = 1024 * 1024;
+
+const StoredAppHostRegistrySchema = z.object({
+  revision: z.number().int().nonnegative(),
+  config: z.string(),
+});
+
+export interface AppHostRegistry {
+  revision: number;
+  config: string | null;
+}
+
+export type AppHostRegistryWrite =
+  | { accepted: true; revision: number }
+  | { accepted: false; revision: number; config: string | null };
+
+// Every session of the daemon shares the file, so writes run one at a time.
+const writeQueues = new Map<string, Promise<unknown>>();
+
+function registryPath(paseoHome: string): string {
+  return path.join(paseoHome, APP_HOST_REGISTRY_FILE);
+}
+
+export async function readAppHostRegistry(paseoHome: string): Promise<AppHostRegistry> {
+  let raw: string;
+  try {
+    raw = await fs.readFile(registryPath(paseoHome), "utf8");
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return { revision: 0, config: null };
+    throw error;
+  }
+  return StoredAppHostRegistrySchema.parse(JSON.parse(raw));
+}
+
+/**
+ * Saves the list when the writer saw the current revision, so a device that missed another
+ * device's change gets the current list back to merge, instead of overwriting it.
+ */
+export function writeAppHostRegistry(
+  paseoHome: string,
+  input: { config: string; baseRevision: number },
+): Promise<AppHostRegistryWrite> {
+  if (Buffer.byteLength(input.config, "utf8") > APP_HOST_REGISTRY_MAX_BYTES) {
+    return Promise.reject(new Error("The host list is too large to save."));
+  }
+  const filePath = registryPath(paseoHome);
+  const previous = writeQueues.get(filePath) ?? Promise.resolve();
+  const next = previous
+    .catch(() => undefined)
+    .then(async (): Promise<AppHostRegistryWrite> => {
+      const current = await readAppHostRegistry(paseoHome);
+      if (current.revision !== input.baseRevision) {
+        return { accepted: false, revision: current.revision, config: current.config };
+      }
+      const revision = current.revision + 1;
+      await writeJsonFileAtomic(filePath, { revision, config: input.config });
+      return { accepted: true, revision };
+    });
+  writeQueues.set(filePath, next);
+  return next;
+}
+
+type AppHostRegistryRequest = Extract<
+  SessionInboundMessage,
+  { type: "daemon.app_host_registry.get.request" | "daemon.app_host_registry.set.request" }
+>;
+
+export async function handleAppHostRegistryRequest(
+  paseoHome: string,
+  msg: AppHostRegistryRequest,
+): Promise<SessionOutboundMessage> {
+  const { requestId } = msg;
+  if (msg.type === "daemon.app_host_registry.get.request") {
+    const current = await readAppHostRegistry(paseoHome);
+    const unchanged = msg.knownRevision === current.revision;
+    return {
+      type: "daemon.app_host_registry.get.response",
+      payload: { requestId, revision: current.revision, config: unchanged ? null : current.config },
+    };
+  }
+  // A failed write throws, which the session reports to the client as an rpc_error.
+  const result = await writeAppHostRegistry(paseoHome, msg);
+  return {
+    type: "daemon.app_host_registry.set.response",
+    payload: result.accepted
+      ? { requestId, accepted: true, revision: result.revision, config: null }
+      : { requestId, ...result },
+  };
+}
