index 0000000000000000000000000000000000000000..7f22dfff2ff48ffc0c4f74a5a3a6aeb208b727ca
--- /dev/null
+++ b/packages/app/src/components/hosts/host-identity-icon.tsx
@@ -0,0 +1,47 @@
+import { useMemo, type ReactElement } from "react";
+import { View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import { HostStatusDot } from "@/components/host-status-dot";
+import { HOST_ICON_MAPPINGS } from "@/hosts/host-badge";
+import { themedHostIcon } from "@/hosts/host-icons";
+import { useHosts } from "@/runtime/host-runtime";
+import { ICON_SIZE } from "@/styles/theme";
+
+/**
+ * A host as host lists draw it: its icon in its color, with the connection status dot on the
+ * icon's corner. A host the user has not given an icon or a color keeps the bare status dot.
+ */
+export function HostIdentityIcon({ serverId }: { serverId: string }): ReactElement {
+  const hosts = useHosts();
+  const appearance = useMemo(
+    () => hosts.find((host) => host.serverId === serverId)?.appearance ?? null,
+    [hosts, serverId],
+  );
+
+  if (!appearance || (appearance.color === "none" && !appearance.icon)) {
+    return <HostStatusDot serverId={serverId} />;
+  }
+
+  const ThemedIcon = themedHostIcon(appearance.icon);
+  return (
+    <View style={styles.container}>
+      <ThemedIcon size={ICON_SIZE.sm} uniProps={HOST_ICON_MAPPINGS[appearance.color]} />
+      <View style={styles.status}>
+        <HostStatusDot serverId={serverId} />
+      </View>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  container: {
+    width: ICON_SIZE.sm,
+    height: ICON_SIZE.sm,
+  },
+  status: {
+    position: "absolute",
+    right: -3,
+    bottom: -3,
+    transform: [{ scale: 0.75 }],
+  },
+});
