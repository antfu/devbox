diff --git a/packages/app/src/screens/settings/host-icon-row.tsx b/packages/app/src/screens/settings/host-icon-row.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..adf09b601e0ae9aab487715be3cb484b55129fd4
--- /dev/null
+++ b/packages/app/src/screens/settings/host-icon-row.tsx
@@ -0,0 +1,91 @@
+import { useCallback, useMemo } from "react";
+import type { TFunction } from "i18next";
+import { useTranslation } from "react-i18next";
+import { Text, View } from "react-native";
+import { DropdownMenu, DropdownMenuContent, DropdownMenuItem } from "@/components/ui/dropdown-menu";
+import { DropdownTrigger } from "@/components/ui/dropdown-trigger";
+import type { HostColor } from "@/hosts/appearance";
+import { HOST_ICON_MAPPINGS } from "@/hosts/host-badge";
+import {
+  DEFAULT_HOST_ICON,
+  HOST_ICON_NAMES,
+  themedHostIcon,
+  type HostIconName,
+} from "@/hosts/host-icons";
+import { settingsStyles } from "@/styles/settings";
+import { ICON_SIZE } from "@/styles/theme";
+
+function iconLabel(t: TFunction, icon: HostIconName): string {
+  return t(`settings.host.appearance.icon.options.${icon}`);
+}
+
+function IconGlyph({ icon, color }: { icon: HostIconName; color: HostColor }) {
+  const ThemedIcon = themedHostIcon(icon);
+  return <ThemedIcon size={ICON_SIZE.md} uniProps={HOST_ICON_MAPPINGS[color]} />;
+}
+
+function IconMenuItem({
+  icon,
+  color,
+  selected,
+  onChange,
+}: {
+  icon: HostIconName;
+  color: HostColor;
+  selected: boolean;
+  onChange: (icon: HostIconName) => void;
+}) {
+  const { t } = useTranslation();
+  const handleSelect = useCallback(() => onChange(icon), [icon, onChange]);
+  const leading = useMemo(() => <IconGlyph icon={icon} color={color} />, [icon, color]);
+  return (
+    <DropdownMenuItem selected={selected} onSelect={handleSelect} leading={leading}>
+      {iconLabel(t, icon)}
+    </DropdownMenuItem>
+  );
+}
+
+/** Picks the glyph host lists and badges draw for this host, previewed in its color. */
+export function HostIconRow({
+  icon = DEFAULT_HOST_ICON,
+  color,
+  onChange,
+}: {
+  icon?: HostIconName;
+  color: HostColor;
+  onChange: (icon: HostIconName) => void;
+}) {
+  const { t } = useTranslation();
+  const selectedLabel = iconLabel(t, icon);
+  const leading = useMemo(() => <IconGlyph icon={icon} color={color} />, [icon, color]);
+  return (
+    <View style={[settingsStyles.row, settingsStyles.rowBorder]}>
+      <View style={settingsStyles.rowContent}>
+        <Text style={settingsStyles.rowTitle}>{t("settings.host.appearance.icon.label")}</Text>
+      </View>
+      <DropdownMenu>
+        <DropdownTrigger
+          testID="host-appearance-icon"
+          accessibilityRole="button"
+          accessibilityLabel={t("settings.host.appearance.icon.accessibilityLabel", {
+            value: selectedLabel,
+          })}
+          leading={leading}
+        >
+          {selectedLabel}
+        </DropdownTrigger>
+        <DropdownMenuContent side="bottom" align="end" width={200}>
+          {HOST_ICON_NAMES.map((option) => (
+            <IconMenuItem
+              key={option}
+              icon={option}
+              color={color}
+              selected={option === icon}
+              onChange={onChange}
+            />
+          ))}
+        </DropdownMenuContent>
+      </DropdownMenu>
+    </View>
+  );
+}
