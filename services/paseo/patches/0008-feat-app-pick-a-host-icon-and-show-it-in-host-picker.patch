+++ b/packages/app/src/hosts/host-icons.ts
@@ -0,0 +1,82 @@
+import {
+  Bot,
+  Box,
+  Briefcase,
+  Building2,
+  Cloud,
+  Cpu,
+  Database,
+  FlaskConical,
+  Gamepad2,
+  HardDrive,
+  House,
+  Laptop,
+  Monitor,
+  Rocket,
+  Server,
+  SquareTerminal,
+  type LucideIcon,
+} from "lucide-react-native";
+import { withUnistyles } from "react-native-unistyles";
+
+/**
+ * The glyphs a host can wear. Order is the picker's order; `server` comes first because it is
+ * what a host shows until the user picks another one.
+ */
+export const HOST_ICON_NAMES = [
+  "server",
+  "laptop",
+  "monitor",
+  "cloud",
+  "cpu",
+  "hard-drive",
+  "terminal",
+  "box",
+  "database",
+  "house",
+  "building",
+  "briefcase",
+  "bot",
+  "rocket",
+  "flask",
+  "gamepad",
+] as const;
+
+export type HostIconName = (typeof HOST_ICON_NAMES)[number];
+
+export const DEFAULT_HOST_ICON: HostIconName = "server";
+
+export const HOST_ICON_COMPONENTS: Record<HostIconName, LucideIcon> = {
+  server: Server,
+  laptop: Laptop,
+  monitor: Monitor,
+  cloud: Cloud,
+  cpu: Cpu,
+  "hard-drive": HardDrive,
+  terminal: SquareTerminal,
+  box: Box,
+  database: Database,
+  house: House,
+  building: Building2,
+  briefcase: Briefcase,
+  bot: Bot,
+  rocket: Rocket,
+  flask: FlaskConical,
+  gamepad: Gamepad2,
+};
+
+// One themed component per glyph for the life of the module, so a badge's `uniProps` mapping
+// subscribes once instead of on every render.
+function themeIcon(icon: LucideIcon) {
+  return withUnistyles(icon);
+}
+
+type ThemedHostIcon = ReturnType<typeof themeIcon>;
+
+const THEMED_HOST_ICONS = Object.fromEntries(
+  HOST_ICON_NAMES.map((name) => [name, themeIcon(HOST_ICON_COMPONENTS[name])]),
+) as Record<HostIconName, ThemedHostIcon>;
+
+export function themedHostIcon(name: HostIconName | undefined): ThemedHostIcon {
+  return THEMED_HOST_ICONS[name ?? DEFAULT_HOST_ICON];
+}
