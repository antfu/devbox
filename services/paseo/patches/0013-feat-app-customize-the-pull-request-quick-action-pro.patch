@@ -0,0 +1,88 @@
+import { useCallback, useState } from "react";
+import { Text, View } from "react-native";
+import { useTranslation } from "react-i18next";
+import { StyleSheet } from "react-native-unistyles";
+import { SettingsSection } from "@/components/settings";
+import { SettingsTextAreaCard } from "@/components/settings-textarea";
+import { Button } from "@/components/ui/button";
+import type { PullRequestQuickAction } from "@/composer/pull-request-actions";
+import {
+  PULL_REQUEST_QUICK_ACTIONS,
+  QUICK_ACTION_PROMPT_PLACEHOLDERS,
+  useQuickActionPromptsStore,
+} from "@/composer/quick-action-prompts";
+import { settingsStyles } from "@/styles/settings";
+
+/** The prompts the pull request quick actions above the composer send, saved on this device. */
+export function QuickActionsSection() {
+  const { t } = useTranslation();
+  return (
+    <View>
+      <Text style={[settingsStyles.rowHint, styles.intro]}>
+        {t("settings.quickActions.description", QUICK_ACTION_PROMPT_PLACEHOLDERS)}
+      </Text>
+      {PULL_REQUEST_QUICK_ACTIONS.map((action) => (
+        <SettingsSection key={action} title={t(`workspace.git.pr.quickActions.${action}.label`)}>
+          <QuickActionPromptCard action={action} />
+        </SettingsSection>
+      ))}
+    </View>
+  );
+}
+
+function QuickActionPromptCard({ action }: { action: PullRequestQuickAction }) {
+  const { t } = useTranslation();
+  const customPrompt = useQuickActionPromptsStore((state) => state.prompts[action]);
+  const setPrompt = useQuickActionPromptsStore((state) => state.setPrompt);
+  const defaultPrompt = t(
+    `workspace.git.pr.quickActions.${action}.prompt`,
+    QUICK_ACTION_PROMPT_PLACEHOLDERS,
+  );
+  // The input keeps its own text; a new key puts the default back after a reset.
+  const [inputKey, setInputKey] = useState(0);
+  const handleChange = useCallback((text: string) => setPrompt(action, text), [action, setPrompt]);
+  const handleReset = useCallback(() => {
+    setPrompt(action, "");
+    setInputKey((key) => key + 1);
+  }, [action, setPrompt]);
+
+  return (
+    <View style={styles.card}>
+      <SettingsTextAreaCard
+        key={inputKey}
+        testID={`settings-quick-action-prompt-${action}`}
+        accessibilityLabel={t("settings.quickActions.promptLabel", {
+          action: t(`workspace.git.pr.quickActions.${action}.label`),
+        })}
+        value={customPrompt ?? defaultPrompt}
+        onChangeText={handleChange}
+        placeholder={defaultPrompt}
+      />
+      {customPrompt ? (
+        <View style={styles.actions}>
+          <Button
+            variant="outline"
+            size="sm"
+            onPress={handleReset}
+            testID={`settings-quick-action-reset-${action}`}
+          >
+            {t("settings.quickActions.reset")}
+          </Button>
+        </View>
+      ) : null}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  intro: {
+    marginBottom: theme.spacing[4],
+  },
+  card: {
+    gap: theme.spacing[2],
+  },
+  actions: {
+    flexDirection: "row",
+    justifyContent: "flex-end",
+  },
+}));
