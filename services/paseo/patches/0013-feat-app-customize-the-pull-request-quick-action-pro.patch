@@ -0,0 +1,31 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import { fillQuickActionPrompt, useQuickActionPromptsStore } from "./quick-action-prompts";
+
+describe("fillQuickActionPrompt", () => {
+  it("fills every url and base placeholder", () => {
+    expect(
+      fillQuickActionPrompt("Merge {{base}} into {{ url }}, then check {{url}}.", {
+        url: "https://github.com/acme/repo/pull/1",
+        base: "main",
+      }),
+    ).toBe(
+      "Merge main into https://github.com/acme/repo/pull/1, then check https://github.com/acme/repo/pull/1.",
+    );
+  });
+
+  it("leaves other placeholders as they are", () => {
+    expect(fillQuickActionPrompt("{{other}}", { url: "u", base: "b" })).toBe("{{other}}");
+  });
+});
+
+describe("useQuickActionPromptsStore", () => {
+  beforeEach(() => useQuickActionPromptsStore.setState({ prompts: {} }));
+
+  it("keeps a custom prompt and drops a blank one", () => {
+    const { setPrompt } = useQuickActionPromptsStore.getState();
+    setPrompt("fixCi", "Fix {{url}}");
+    expect(useQuickActionPromptsStore.getState().prompts).toEqual({ fixCi: "Fix {{url}}" });
+    setPrompt("fixCi", "  ");
+    expect(useQuickActionPromptsStore.getState().prompts).toEqual({});
+  });
+});
diff --git a/packages/app/src/composer/quick-action-prompts.ts b/packages/app/src/composer/quick-action-prompts.ts
new file mode 100644
index 0000000000000000000000000000000000000000..06f4b8336bf2c923d7b6526888c16ce058d32f09
--- /dev/null
+++ b/packages/app/src/composer/quick-action-prompts.ts
@@ -0,0 +1,68 @@
+import AsyncStorage from "@react-native-async-storage/async-storage";
+import { create } from "zustand";
+import { persist } from "zustand/middleware";
+import { z } from "zod";
+import type { PullRequestQuickAction } from "@/composer/pull-request-actions";
+import { createValidatedPersistStorage } from "@/storage/validated-persist-storage";
+
+export const PULL_REQUEST_QUICK_ACTIONS: readonly PullRequestQuickAction[] = [
+  "resolveConflicts",
+  "fixCi",
+  "createPr",
+];
+
+/** The values a quick action prompt can name as `{{url}}` and `{{base}}`. */
+export interface QuickActionPromptValues {
+  url: string;
+  base: string;
+}
+
+/** Placeholder values that make `t()` return a default prompt with its placeholders intact. */
+export const QUICK_ACTION_PROMPT_PLACEHOLDERS = {
+  url: "{{url}}",
+  base: "{{base}}",
+} satisfies QuickActionPromptValues;
+
+const PromptsSchema = z.object({
+  resolveConflicts: z.string().optional(),
+  fixCi: z.string().optional(),
+  createPr: z.string().optional(),
+});
+
+type QuickActionPrompts = z.infer<typeof PromptsSchema>;
+
+interface QuickActionPromptsState {
+  /** Prompts set on this device; an action without one sends its default prompt. */
+  prompts: QuickActionPrompts;
+  /** Sets an action's prompt; a blank one goes back to the default. */
+  setPrompt: (action: PullRequestQuickAction, prompt: string) => void;
+}
+
+export const useQuickActionPromptsStore = create<QuickActionPromptsState>()(
+  persist(
+    (set) => ({
+      prompts: {},
+      setPrompt: (action, prompt) =>
+        set((state) => {
+          const prompts = { ...state.prompts };
+          if (prompt.trim().length > 0) prompts[action] = prompt;
+          else delete prompts[action];
+          return { prompts };
+        }),
+    }),
+    {
+      name: "composer-quick-action-prompts",
+      storage: createValidatedPersistStorage(AsyncStorage, z.object({ prompts: PromptsSchema })),
+      partialize: (state) => ({ prompts: state.prompts }),
+      version: 1,
+    },
+  ),
+);
+
+/** Fills a prompt's `{{url}}` and `{{base}}` placeholders. */
+export function fillQuickActionPrompt(template: string, values: QuickActionPromptValues): string {
+  return template.replace(
+    /\{\{\s*(url|base)\s*\}\}/g,
+    (_match, name: keyof QuickActionPromptValues) => values[name],
+  );
+}
